      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n</style>\n<div class=\"min-h-screen bg-(--paper) text-(--ink) [font-family:var(--font-sans)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"--ink:#292827;--muted:#736f69;--paper:#f8f7f3;--cream:#efebe4;--line:#dedbd4;--accent:#b87558;--leaf:#52735d;--font-sans:'DM Sans',sans-serif;--font-serif:'Libre Baskerville',serif;\">\n    <div class=\"bg-(--ink) px-4 py-2.5 text-center text-[11px] leading-4 text-[#f7f3ec] sm:py-2.5 sm:text-xs\" data-kid=\"1-1\" data-name=\"top promo banner\">\n        Complimentary delivery on orders above Rs. 10,000\n        <span class=\"mx-2 text-(--accent)\" data-kid=\"1-1-1\" data-name=\"bullet point separator\">\n            •\n        </span>\n        <span class=\"text-[#dedbd4]\" data-kid=\"1-1-2\" data-name=\"delivery timeframe text\">\n            4–7 working days\n        </span>\n    </div>\n    <header class=\"border-b border-(--line) bg-(--paper)\" data-kid=\"1-2\" data-name=\"site header section\">\n        <div class=\"mx-auto grid h-[72px] max-w-[1360px] grid-cols-[1fr_auto_1fr] items-center gap-3 px-4 sm:h-[82px] sm:px-7 lg:px-12\" data-kid=\"1-2-1\" data-name=\"header navigation wrapper\">\n            <nav aria-label=\"Main navigation\" class=\"hidden items-center gap-7 text-sm text-(--ink) md:flex\" data-kid=\"1-2-1-1\" data-name=\"main navigation list\">\n                <a class=\"hover:text-(--accent)\" data-kid=\"1-2-1-1-1\" data-name=\"home navigation link\" href=\"#\">\n                    Home\n                </a>\n                <a aria-current=\"page\" class=\"border-b border-(--ink) py-1\" data-kid=\"1-2-1-1-2\" data-name=\"shop navigation link\" href=\"#\">\n                    Shop\n                </a>\n                <a class=\"hover:text-(--accent)\" data-kid=\"1-2-1-1-3\" data-name=\"brand story navigation link\" href=\"#\">\n                    Brand story\n                </a>\n            </nav>\n            <a aria-label=\"Solids home\" class=\"col-start-1 justify-self-start md:col-start-2 md:justify-self-center\" data-kid=\"1-2-1-2\" data-name=\"site logo link\" href=\"#\">\n                <img alt=\"Solids — No prints, just style\" class=\"h-[50px] w-[142px] object-contain sm:h-[58px] sm:w-[175px]\" data-kid=\"1-2-1-2-1\" data-name=\"solids brand logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n            </a>\n            <div class=\"col-start-3 flex items-center justify-self-end gap-3 sm:gap-6\" data-kid=\"1-2-1-3\" data-name=\"header utility buttons wrapper\">\n                <button aria-label=\"Search products\" class=\"flex h-11 items-center gap-2 px-1 text-sm hover:text-(--accent)\" data-kid=\"1-2-1-3-1\" data-name=\"search button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-search text-lg\" data-kid=\"1-2-1-3-1-1\" data-name=\"search icon\" style=\"width:20px;height:20px;color:var(--ink)\">\n                    </i>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-2-1-3-1-2\" data-name=\"search label\">\n                        Search\n                    </span>\n                </button>\n                <button aria-label=\"Open bag, 0 items\" class=\"flex h-11 items-center gap-2 border-l border-(--line) pl-3 text-sm hover:text-(--accent) sm:pl-6\" data-kid=\"1-2-1-3-2\" data-name=\"shopping bag button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-shopping-bag text-lg\" data-kid=\"1-2-1-3-2-1\" data-name=\"shopping bag icon\" style=\"width:20px;height:20px;color:var(--ink)\">\n                    </i>\n                    <span data-kid=\"1-2-1-3-2-2\" data-name=\"shopping bag label\">\n                        Bag\n                    </span>\n                    <span class=\"text-(--accent)\" data-dynamic=\"true\" data-kid=\"1-2-1-3-2-3\" data-name=\"shopping bag item count\" data-reason=\"count value updated by cart management script\">\n                        0\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1360px] px-4 pb-16 pt-5 sm:px-7 sm:pt-7 lg:px-12 lg:pb-24\" data-kid=\"1-3\" data-name=\"main page content area\">\n        <a class=\"mb-5 inline-flex min-h-11 items-center gap-2 text-sm text-(--muted) hover:text-(--ink) sm:mb-7\" data-kid=\"1-3-1\" data-name=\"back to products link\" href=\"#\">\n            <span aria-hidden=\"true\" data-kid=\"1-3-1-1\" data-name=\"back arrow icon\">\n                ←\n            </span>\n            <span data-kid=\"1-3-1-2\" data-name=\"back link label\">\n                Back to all products\n            </span>\n        </a>\n        <section aria-label=\"Soft Rib Co-ord product details\" class=\"grid grid-cols-1 items-start gap-8 sm:gap-10 lg:grid-cols-[1.18fr_0.82fr] lg:gap-16 xl:gap-[88px]\" data-kid=\"1-3-2\" data-name=\"product details section\">\n            <div class=\"relative aspect-[1.28/1] overflow-hidden bg-[#e9e5dd] sm:aspect-[1.36/1] lg:aspect-auto lg:min-h-[560px] lg:h-[min(67vh,740px)]\" data-kid=\"1-3-2-1\" data-name=\"product image gallery container\">\n                <img alt=\"Neutral-toned apparel arranged on a clothing rail\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-3-2-1-1\" data-name=\"product display image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=1200&q=85\"/>\n                <span class=\"absolute left-4 top-4 bg-(--paper) px-3 py-2 text-[11px] font-semibold tracking-[0.12em] text-(--ink) sm:left-5 sm:top-5\" data-kid=\"1-3-2-1-2\" data-name=\"new product badge\">\n                    NEW\n                </span>\n            </div>\n            <div class=\"lg:sticky lg:top-8 lg:pt-1\" data-kid=\"1-3-2-2\" data-name=\"product information sidebar\">\n                <p class=\"mb-3 text-xs text-(--muted)\" data-kid=\"1-3-2-2-1\" data-name=\"product category breadcrumb\">\n                    Co-ord Sets\n                    <span class=\"px-2 text-(--line)\" data-kid=\"1-3-2-2-1-1\" data-name=\"breadcrumb separator\">\n                        /\n                    </span>\n                    Solids\n                </p>\n                <h1 class=\"[font-family:var(--font-serif)] text-[34px] font-normal leading-[1.16] tracking-[-0.035em] sm:text-[42px] lg:text-[48px]\" data-kid=\"1-3-2-2-2\" data-name=\"product title headline\">\n                    Soft Rib Co-ord\n                </h1>\n                <p class=\"mt-4 text-[21px] font-medium tracking-[-0.02em] sm:text-[23px]\" data-kid=\"1-3-2-2-3\" data-name=\"product price text\">\n                    Rs. 12,800\n                </p>\n                <div class=\"mt-5 flex min-h-11 items-center gap-2 border-b border-(--line) pb-5 text-sm\" data-kid=\"1-3-2-2-4\" data-name=\"stock availability status indicator\">\n                    <span aria-hidden=\"true\" class=\"h-2 w-2 rounded-full bg-(--leaf)\" data-kid=\"1-3-2-2-4-1\" data-name=\"stock indicator dot\">\n                    </span>\n                    <span data-kid=\"1-3-2-2-4-2\" data-name=\"stock status text\">\n                        In Stock\n                    </span>\n                </div>\n                <div class=\"pt-5\" data-kid=\"1-3-2-2-5\" data-name=\"size selection container\">\n                    <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"1-3-2-2-5-1\" data-name=\"size label container\">\n                        <span class=\"text-sm font-semibold\" data-kid=\"1-3-2-2-5-1-1\" data-name=\"size label text\">\n                            Size\n                        </span>\n                        <span class=\"text-sm text-(--muted)\" data-dynamic=\"true\" data-kid=\"1-3-2-2-5-1-2\" data-name=\"selected size display text\" data-reason=\"size text updated on user interaction\">\n                            Selected: X-Small\n                        </span>\n                    </div>\n                    <div aria-label=\"Choose a size\" class=\"grid grid-cols-5 gap-2 sm:gap-2.5\" data-kid=\"1-3-2-2-5-2\" data-name=\"size options group\" role=\"group\">\n                        <button aria-pressed=\"true\" class=\"flex min-h-12 items-center justify-center border border-(--ink) bg-(--ink) px-2 text-sm text-white\" data-dynamic=\"true\" data-kid=\"1-3-2-2-5-2-1\" data-name=\"x-small size button\" data-reason=\"button state updated by size selection script\" type=\"button\">\n                            X-Small\n                        </button>\n                        <button aria-pressed=\"false\" class=\"flex min-h-12 items-center justify-center border border-(--line) bg-white px-2 text-sm hover:border-(--ink)\" data-dynamic=\"true\" data-kid=\"1-3-2-2-5-2-2\" data-name=\"small size button\" data-reason=\"button state updated by size selection script\" type=\"button\">\n                            Small\n                        </button>\n                        <button aria-pressed=\"false\" class=\"flex min-h-12 items-center justify-center border border-(--line) bg-white px-2 text-sm hover:border-(--ink)\" data-dynamic=\"true\" data-kid=\"1-3-2-2-5-2-3\" data-name=\"medium size button\" data-reason=\"button state updated by size selection script\" type=\"button\">\n                            Medium\n                        </button>\n                        <button aria-pressed=\"false\" class=\"flex min-h-12 items-center justify-center border border-(--line) bg-white px-2 text-sm hover:border-(--ink)\" data-dynamic=\"true\" data-kid=\"1-3-2-2-5-2-4\" data-name=\"large size button\" data-reason=\"button state updated by size selection script\" type=\"button\">\n                            Large\n                        </button>\n                        <button aria-disabled=\"true\" class=\"flex min-h-12 cursor-not-allowed items-center justify-center border border-(--line) bg-[#f0eee9] px-1 text-xs text-(--muted) line-through\" data-kid=\"1-3-2-2-5-2-5\" data-name=\"x-large size button\" disabled=\"\" type=\"button\">\n                            X-Large\n                        </button>\n                    </div>\n                </div>\n                <div class=\"mt-6 flex items-center justify-between border-y border-(--line) py-4\" data-kid=\"1-3-2-2-6\" data-name=\"quantity selector container\">\n                    <span class=\"text-sm font-semibold\" data-kid=\"1-3-2-2-6-1\" data-name=\"quantity label\">\n                        Quantity\n                    </span>\n                    <div aria-label=\"Quantity, 1\" class=\"flex h-11 items-center border border-(--line) bg-white\" data-kid=\"1-3-2-2-6-2\" data-name=\"quantity adjustment widget\">\n                        <button aria-label=\"Decrease quantity\" class=\"grid h-11 w-11 place-items-center text-lg hover:bg-(--cream)\" data-kid=\"1-3-2-2-6-2-1\" data-name=\"decrease quantity button\" type=\"button\">\n                            −\n                        </button>\n                        <span class=\"w-8 text-center text-sm\" data-dynamic=\"true\" data-kid=\"1-3-2-2-6-2-2\" data-name=\"current quantity display text\" data-reason=\"value updated by quantity control script\">\n                            1\n                        </span>\n                        <button aria-label=\"Increase quantity\" class=\"grid h-11 w-11 place-items-center text-lg hover:bg-(--cream)\" data-kid=\"1-3-2-2-6-2-3\" data-name=\"increase quantity button\" type=\"button\">\n                            +\n                        </button>\n                    </div>\n                </div>\n                <button class=\"mt-5 flex min-h-14 w-full items-center justify-between bg-(--ink) px-5 text-sm font-semibold text-white hover:bg-[#403d38] sm:px-6\" data-kid=\"1-3-2-2-7\" data-name=\"add to bag button\" type=\"button\">\n                    <span data-kid=\"1-3-2-2-7-1\" data-name=\"add to bag label\">\n                        Add to bag\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-lg\" data-kid=\"1-3-2-2-7-2\" data-name=\"arrow icon\">\n                        →\n                    </span>\n                </button>\n                <div class=\"mt-7 divide-y divide-(--line) border-y border-(--line)\" data-kid=\"1-3-2-2-8\" data-name=\"product accordion container\">\n                    <details class=\"group py-4\" data-kid=\"1-3-2-2-8-1\" data-name=\"product description accordion\" open=\"\">\n                        <summary class=\"flex min-h-9 cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold\" data-kid=\"1-3-2-2-8-1-1\" data-name=\"description accordion trigger\">\n                            Product description\n                            <span aria-hidden=\"true\" class=\"text-lg font-normal text-(--muted) group-open:hidden\" data-kid=\"1-3-2-2-8-1-1-1\" data-name=\"plus icon\">\n                                +\n                            </span>\n                            <span aria-hidden=\"true\" class=\"hidden text-lg font-normal text-(--muted) group-open:inline\" data-kid=\"1-3-2-2-8-1-1-2\" data-name=\"minus icon\">\n                                −\n                            </span>\n                        </summary>\n                        <p class=\"max-w-[47ch] pb-1 pt-2 text-sm leading-6 text-(--muted)\" data-kid=\"1-3-2-2-8-1-2\" data-name=\"product description text\">\n                            Thoughtfully made in a soft, breathable fabric with a considered fit for effortless everyday wear.\n                        </p>\n                    </details>\n                    <details class=\"group py-4\" data-kid=\"1-3-2-2-8-2\" data-name=\"delivery info accordion\">\n                        <summary class=\"flex min-h-9 cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold\" data-kid=\"1-3-2-2-8-2-1\" data-name=\"delivery accordion trigger\">\n                            Delivery\n                            <span aria-hidden=\"true\" class=\"text-lg font-normal text-(--muted) group-open:hidden\" data-kid=\"1-3-2-2-8-2-1-1\" data-name=\"plus icon\">\n                                +\n                            </span>\n                            <span aria-hidden=\"true\" class=\"hidden text-lg font-normal text-(--muted) group-open:inline\" data-kid=\"1-3-2-2-8-2-1-2\" data-name=\"minus icon\">\n                                −\n                            </span>\n                        </summary>\n                        <p class=\"pb-1 pt-2 text-sm leading-6 text-(--muted)\" data-kid=\"1-3-2-2-8-2-2\" data-name=\"delivery information text\">\n                            4–7 working days. Complimentary delivery on orders above Rs. 10,000.\n                        </p>\n                    </details>\n                </div>\n                <p class=\"mt-5 text-xs leading-5 text-(--muted)\" data-kid=\"1-3-2-2-9\" data-name=\"footer brand message text\">\n                    Designed in Lahore, made for everywhere.\n                </p>\n            </div>\n        </section>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-09-30T21:37:24.567694+00:00",
      "modified": "2026-09-30T21:38:41.802013+00:00",
      "id": "var_4569da9c408f",
      "viewportScrollY": 261
    },
    "var_cdadbd9ab25d": {
      "type": "variant",
      "label": "03 · Merchandise edit · Studio",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 16940,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n:root{--ink:#292827;--paper:#f8f7f3;--muted:#716d66;--line:#dedbd4;--cream:#f0ece5;--accent:#b87558;--sidebar:#292827;--green:#58745e;--amber:#8b6735;}\n.font-dm{font-family:'DM Sans',sans-serif}.font-libre{font-family:'Libre Baskerville',serif}\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n    gsap.registerPlugin(ScrollTrigger);\n    const headings = gsap.utils.toArray('main h1, main section h2');\n    headings.forEach((heading) => {\n      const label = heading.textContent.trim();\n      heading.setAttribute('aria-label', label);\n      heading.textContent = '';\n      const words = label.split(' ').map((word) => {\n        const mask = document.createElement('span');\n        const revealWord = document.createElement('span');\n        mask.style.display = 'inline-block';\n        mask.style.overflow = 'hidden';\n        mask.style.verticalAlign = 'bottom';\n        mask.style.paddingBottom = '.12em';\n        mask.style.marginBottom = '-.12em';\n        revealWord.style.display = 'inline-block';\n        revealWord.textContent = word;\n        mask.appendChild(revealWord);\n        heading.appendChild(mask);\n        heading.appendChild(document.createTextNode(' '));\n        return revealWord;\n      });\n      gsap.fromTo(words, { yPercent: 112, autoAlpha: 0 }, {\n        yPercent: 0,\n        autoAlpha: 1,\n        duration: 0.58,\n        stagger: 0.075,\n        ease: 'power3.out',\n        scrollTrigger: { trigger: heading, start: 'top 91%', toggleActions: 'play none none reverse' }\n      });\n    });\n    const descriptions = gsap.utils.toArray('main p').filter((copy) => copy.dataset.name?.includes('description'));\n    descriptions.forEach((copy) => copy.classList.add('scroll-copy'));\n    gsap.utils.toArray('.scroll-copy').forEach((copy) => {\n      gsap.fromTo(copy, { autoAlpha: 0, y: 15 }, {\n        autoAlpha: 1,\n        y: 0,\n        duration: 0.62,\n        ease: 'power2.out',\n        scrollTrigger: { trigger: copy, start: 'top 92%', toggleActions: 'play none none reverse' }\n      });\n    });\n    const cards = gsap.utils.toArray('main section article, main section a.group');\n    gsap.set(cards, { autoAlpha: 0, y: 18 });\n    ScrollTrigger.batch(cards, {\n      start: 'top 90%',\n      interval: 0.08,\n      batchMax: 4,\n      onEnter: (items) => gsap.to(items, { autoAlpha: 1, y: 0, duration: 0.58, stagger: 0.075, ease: 'power2.out', overwrite: true }),\n      onEnterBack: (items) => gsap.to(items, { autoAlpha: 1, y: 0, duration: 0.48, stagger: 0.06, ease: 'power2.out', overwrite: true }),\n      onLeaveBack: (items) => gsap.set(items, { autoAlpha: 0, y: 18, overwrite: true })\n    });\n    window.addEventListener('load', () => ScrollTrigger.refresh());\n  });\n</script>\n<div class=\"min-h-screen bg-[var(--paper)] font-dm text-[var(--ink)] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <aside class=\"fixed inset-y-0 left-0 z-20 hidden w-[252px] flex-col bg-[var(--sidebar)] px-6 py-7 text-[#e9e4dc] lg:flex\" data-kid=\"1-1\" data-name=\"sidebar navigation container\">\n        <a aria-label=\"Solids Studio overview\" class=\"flex h-[58px] items-center border-b border-white/10 pb-6\" data-kid=\"1-1-1\" data-name=\"studio overview link\" href=\"admin.html\">\n            <img alt=\"Solids\" class=\"h-[48px] w-[154px] object-contain brightness-0 invert\" data-kid=\"1-1-1-1\" data-name=\"solids logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n        </a>\n        <p class=\"mb-3 mt-9 px-2 text-[11px] font-semibold tracking-[.13em] text-[#a7a198]\" data-kid=\"1-1-2\" data-name=\"workspace section label\">\n            WORKSPACE\n        </p>\n        <nav aria-label=\"Studio navigation\" class=\"grid gap-1.5 text-[14px]\" data-kid=\"1-1-3\" data-name=\"studio navigation menu\">\n            <a class=\"flex min-h-11 items-center gap-3 rounded-sm bg-white/10 px-3 font-medium text-white\" data-kid=\"1-1-3-1\" data-name=\"overview page link\" href=\"admin.html\">\n                <i class=\"ti ti-layout-dashboard text-[18px] text-[#d4ae97]\" data-kid=\"1-1-3-1-1\" data-name=\"dashboard icon\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"overview label\">\n                    Overview\n                </span>\n            </a>\n            <a class=\"flex min-h-11 items-center gap-3 rounded-sm px-3 text-[#d0cbc3] hover:bg-white/5\" data-kid=\"1-1-3-2\" data-name=\"products and inventory link\" href=\"products.html\">\n                <i class=\"ti ti-hanger text-[18px]\" data-kid=\"1-1-3-2-1\" data-name=\"hanger icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"products and inventory label\">\n                    Products & inventory\n                </span>\n            </a>\n            <a class=\"flex min-h-11 items-center gap-3 rounded-sm px-3 text-[#d0cbc3] hover:bg-white/5\" data-kid=\"1-1-3-3\" data-name=\"orders page link\" href=\"orders.html\">\n                <i class=\"ti ti-receipt text-[18px]\" data-kid=\"1-1-3-3-1\" data-name=\"receipt icon\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"orders label\">\n                    Orders\n                </span>\n            </a>\n            <a class=\"flex min-h-11 items-center gap-3 rounded-sm px-3 text-[#d0cbc3] hover:bg-white/5\" data-kid=\"1-1-3-4\" data-name=\"categories and banners page link\" href=\"categories.html\">\n                <i class=\"ti ti-category text-[18px]\" data-kid=\"1-1-3-4-1\" data-name=\"category icon\">\n                </i>\n                <span data-kid=\"1-1-3-4-2\" data-name=\"categories and banners label\">\n                    Categories & banners\n                </span>\n            </a>\n            <a class=\"flex min-h-11 items-center gap-3 rounded-sm px-3 text-[#d0cbc3] hover:bg-white/5\" data-kid=\"1-1-3-5\" data-name=\"customers page link\" href=\"customers.html\">\n                <i class=\"ti ti-users text-[18px]\" data-kid=\"1-1-3-5-1\" data-name=\"users icon\">\n                </i>\n                <span data-kid=\"1-1-3-5-2\" data-name=\"customers label\">\n                    Customers\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-auto border-t border-white/10 pt-5\" data-kid=\"1-1-4\" data-name=\"admin actions section\">\n            <a class=\"flex min-h-11 items-center gap-3 rounded-sm px-3 text-[14px] text-[#d0cbc3] hover:bg-white/5\" data-kid=\"1-1-4-1\" data-name=\"view storefront link\" href=\"index.html\">\n                <i class=\"ti ti-external-link text-[17px]\" data-kid=\"1-1-4-1-1\" data-name=\"external link icon\">\n                </i>\n                <span data-kid=\"1-1-4-1-2\" data-name=\"view storefront label\">\n                    View storefront\n                </span>\n            </a>\n            <div class=\"mt-7 flex items-center gap-3 border-t border-white/10 pt-5\" data-kid=\"1-1-4-2\" data-name=\"admin account profile\">\n                <div class=\"grid size-9 shrink-0 place-items-center rounded-full bg-[#b87558] text-[12px] font-semibold text-white\" data-kid=\"1-1-4-2-1\" data-name=\"admin initials avatar\">\n                    SA\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-4-2-2\" data-name=\"admin account info\">\n                    <p class=\"m-0 text-[13px] font-medium text-white\" data-kid=\"1-1-4-2-2-1\" data-name=\"admin name\">\n                        Studio Admin\n                    </p>\n                    <p class=\"m-0 mt-1 truncate text-[12px] text-[#aaa49c]\" data-kid=\"1-1-4-2-2-2\" data-name=\"admin email\">\n                        solids@studio.pk\n                    </p>\n                </div>\n            </div>\n        </div>\n    </aside>\n    <div class=\"min-h-screen lg:pl-[252px]\" data-kid=\"1-2\" data-name=\"main content container\">\n        <header class=\"flex min-h-[82px] items-center justify-between border-b border-[var(--line)] bg-[var(--paper)] px-5 sm:px-8 lg:px-11\" data-kid=\"1-2-1\" data-name=\"main header\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-1\" data-name=\"header title group\">\n                <div class=\"grid size-10 place-items-center border border-[var(--line)] text-[var(--ink)] lg:hidden\" data-kid=\"1-2-1-1-1\" data-name=\"mobile menu trigger button\">\n                    <i class=\"ti ti-menu-2 text-[20px]\" data-kid=\"1-2-1-1-1-1\" data-name=\"menu hamburger icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-1-1-2\" data-name=\"page path breadcrumbs\">\n                    <p class=\"m-0 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-1-1-2-1\" data-name=\"workspace label\">\n                        Solids Studio\n                    </p>\n                    <p class=\"m-0 mt-1 text-[14px] font-medium\" data-kid=\"1-2-1-1-2-2\" data-name=\"current page title\">\n                        Overview\n                    </p>\n                </div>\n            </div>\n            <a class=\"inline-flex min-h-11 items-center gap-2 border border-[var(--line)] px-3.5 text-[13px] font-medium text-[var(--ink)] hover:bg-white sm:px-4\" data-kid=\"1-2-1-2\" data-name=\"header view storefront link\" href=\"index.html\">\n                View storefront\n                <i class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"1-2-1-2-1\" data-name=\"external link icon\">\n                </i>\n            </a>\n        </header>\n        <main class=\"mx-auto max-w-[1320px] px-5 pb-14 pt-9 sm:px-8 sm:pt-11 lg:px-11 lg:pt-12\" data-kid=\"1-2-2\" data-name=\"main page content area\">\n            <div class=\"mb-8 flex flex-wrap items-end justify-between gap-4 border-b border-[var(--line)] pb-7 sm:mb-10 sm:pb-8\" data-kid=\"1-2-2-1\" data-name=\"page content header\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"page header text\">\n                    <h1 class=\"font-libre m-0 text-[30px] font-normal leading-tight tracking-[-.035em] sm:text-[36px]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-1\" data-name=\"page headline\" data-reason=\"text content reinitialized as spans for GSAP reveal animation\">\n                        Overview\n                    </h1>\n                    <p class=\"mb-0 mt-3 max-w-[580px] text-[15px] leading-6 text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2\" data-name=\"page description text\" data-reason=\"opacity/position reinitialized by GSAP scroll animation\">\n                        Orders, product stock and storefront presentation.\n                    </p>\n                </div>\n                <a class=\"inline-flex min-h-11 items-center justify-center gap-2 bg-[var(--ink)] px-4 text-[13px] font-medium text-white hover:bg-[#403d39]\" data-kid=\"1-2-2-1-2\" data-name=\"add product button\" href=\"products.html\">\n                    Add product\n                    <i class=\"ti ti-plus text-[16px]\" data-kid=\"1-2-2-1-2-1\" data-name=\"plus icon\">\n                    </i>\n                </a>\n            </div>\n            <section aria-labelledby=\"orders-heading\" class=\"border border-[var(--line)] bg-white/75\" data-kid=\"1-2-2-2\" data-name=\"orders section\">\n                <div class=\"flex flex-wrap items-end justify-between gap-3 border-b border-[var(--line)] px-5 py-5 sm:px-7 sm:py-6\" data-kid=\"1-2-2-2-1\" data-name=\"orders header\">\n                    <div data-kid=\"1-2-2-2-1-1\" data-name=\"orders header text\">\n                        <h2 class=\"font-libre m-0 text-[21px] font-normal tracking-[-.02em] sm:text-[23px]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"orders section heading\" data-reason=\"text content reinitialized as spans for GSAP reveal animation\" id=\"orders-heading\">\n                            Orders\n                        </h2>\n                        <p class=\"mb-0 mt-2 text-[14px] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"orders description text\" data-reason=\"opacity/position reinitialized by GSAP scroll animation\">\n                            Review the order awaiting a status update.\n                        </p>\n                    </div>\n                    <a class=\"inline-flex min-h-10 items-center gap-2 text-[13px] font-medium text-[var(--ink)] underline decoration-[var(--line)] underline-offset-4 hover:decoration-[var(--ink)]\" data-kid=\"1-2-2-2-1-2\" data-name=\"view all orders link\" href=\"orders.html\">\n                        View all orders\n                        <i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"hidden grid-cols-[1.35fr_1.1fr_1fr_.85fr_.7fr] gap-4 px-7 pb-3 pt-4 text-[11px] font-semibold tracking-[.08em] text-[var(--muted)] lg:grid\" data-kid=\"1-2-2-2-2\" data-name=\"orders table header labels\">\n                    <span data-kid=\"1-2-2-2-2-1\" data-name=\"order and customer column label\">\n                        ORDER & CUSTOMER\n                    </span>\n                    <span data-kid=\"1-2-2-2-2-2\" data-name=\"item column label\">\n                        ITEM\n                    </span>\n                    <span data-kid=\"1-2-2-2-2-3\" data-name=\"payment method column label\">\n                        PAYMENT METHOD\n                    </span>\n                    <span data-kid=\"1-2-2-2-2-4\" data-name=\"order status column label\">\n                        ORDER STATUS\n                    </span>\n                    <span class=\"text-right\" data-kid=\"1-2-2-2-2-5\" data-name=\"total column label\">\n                        TOTAL\n                    </span>\n                </div>\n                <div class=\"border-b border-[var(--line)] bg-[#f5f0e9] px-5 py-5 sm:px-7 lg:grid lg:grid-cols-[1.35fr_1.1fr_1fr_.85fr_.7fr] lg:items-center lg:gap-4 lg:py-4\" data-kid=\"1-2-2-2-3\" data-name=\"single order row details\">\n                    <div class=\"flex flex-wrap items-center gap-x-3 gap-y-1\" data-kid=\"1-2-2-2-3-1\" data-name=\"order and customer info\">\n                        <a class=\"text-[14px] font-semibold underline decoration-[#c8aa97] underline-offset-4\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"order ID link\" href=\"orders.html\">\n                            #SOL-1046\n                        </a>\n                        <span class=\"text-[14px] font-medium\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"customer name\">\n                            Hina Ahmed\n                        </span>\n                        <span class=\"w-full text-[13px] text-[var(--muted)]\" data-kid=\"1-2-2-2-3-1-3\" data-name=\"order timestamp\">\n                            Yesterday, 4:28 PM\n                        </span>\n                    </div>\n                    <div class=\"mt-3 lg:mt-0\" data-kid=\"1-2-2-2-3-2\" data-name=\"order item info\">\n                        <p class=\"m-0 text-[14px] font-medium\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"order item name\">\n                            Sculpt Knit Co-ord × 1\n                        </p>\n                        <p class=\"m-0 mt-1 text-[13px] text-[var(--muted)]\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"order item role\">\n                            Order item\n                        </p>\n                    </div>\n                    <div class=\"mt-3 lg:mt-0\" data-kid=\"1-2-2-2-3-3\" data-name=\"payment method info\">\n                        <p class=\"m-0 text-[14px]\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"payment method text\">\n                            Cash on delivery\n                        </p>\n                        <p class=\"m-0 mt-1 text-[13px] text-[var(--muted)]\" data-kid=\"1-2-2-2-3-3-2\" data-name=\"payment method role\">\n                            Payment method\n                        </p>\n                    </div>\n                    <div class=\"mt-3 flex items-center gap-2 lg:mt-0\" data-kid=\"1-2-2-2-3-4\" data-name=\"order status status indicator\">\n                        <span class=\"inline-flex min-h-7 items-center gap-1.5 border border-[#d7c29c] px-2.5 text-[12px] font-medium text-[var(--amber)]\" data-kid=\"1-2-2-2-3-4-1\" data-name=\"status pill\">\n                            <span class=\"size-1.5 rounded-full bg-[#aa844a]\" data-kid=\"1-2-2-2-3-4-1-1\" data-name=\"status dot icon\">\n                            </span>\n                            Pending\n                        </span>\n                        <span class=\"text-[12px] text-[var(--muted)] lg:hidden\" data-kid=\"1-2-2-2-3-4-2\" data-name=\"order status label\">\n                            Order status\n                        </span>\n                    </div>\n                    <div class=\"mt-4 flex items-center justify-between border-t border-[#e3d8cb] pt-3 lg:mt-0 lg:block lg:border-0 lg:pt-0 lg:text-right\" data-kid=\"1-2-2-2-3-5\" data-name=\"order total column\">\n                        <div data-kid=\"1-2-2-2-3-5-1\" data-name=\"total amount group\">\n                            <p class=\"m-0 text-[11px] font-semibold tracking-[.08em] text-[var(--muted)] lg:hidden\" data-kid=\"1-2-2-2-3-5-1-1\" data-name=\"total label mobile\">\n                                TOTAL\n                            </p>\n                            <p cl