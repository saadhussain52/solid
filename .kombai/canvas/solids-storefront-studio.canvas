        "x": 9240,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n#solids-catalog { --ink:#292827; --muted:#746f69; --paper:#f8f7f3; --cream:#efebe4; --line:#dedbd4; --accent:#b87558; font-family:'DM Sans',sans-serif; }\n#solids-catalog .display { font-family:'Libre Baskerville',serif; }\n#solids-catalog .product-photo { aspect-ratio: 4 / 5; }\n@media (max-width: 760px) {\n  #solids-catalog .desktop-nav { display:none; }\n  #solids-catalog .brand-logo { width:132px; }\n  #solids-catalog .catalog-main { padding-left:20px; padding-right:20px; }\n  #solids-catalog .catalog-heading { align-items:flex-end; }\n  #solids-catalog .filter-list { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }\n  #solids-catalog .filter-list a { justify-content:center; min-height:46px; padding:10px 8px; }\n  #solids-catalog .product-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:30px 12px; }\n  #solids-catalog .product-photo { aspect-ratio:3 / 4; }\n  #solids-catalog .product-row { flex-direction:column; align-items:flex-start; gap:5px; }\n}\n@media (max-width: 400px) {\n  #solids-catalog .utility-actions { gap:14px; }\n  #solids-catalog .brand-logo { width:114px; }\n  #solids-catalog .catalog-main { padding-left:16px; padding-right:16px; }\n}\n</style>\n<div class=\"min-h-screen bg-[var(--paper)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"solids catalog page\" id=\"solids-catalog\">\n    <div class=\"flex min-h-[34px] items-center justify-center bg-[var(--ink)] px-4 py-2 text-center text-[11px] font-medium tracking-[0.08em] text-[#f7f3ec] max-sm:text-[10px]\" data-kid=\"1-1\" data-name=\"promo banner\">\n        COMPLIMENTARY DELIVERY ON ORDERS ABOVE RS. 10,000\n    </div>\n    <header class=\"border-b border-[var(--line)] bg-[var(--paper)]\" data-kid=\"1-2\" data-name=\"header container\">\n        <div class=\"mx-auto grid h-[78px] max-w-[1360px] grid-cols-[1fr_auto_1fr] items-center px-8 max-sm:h-[68px] max-sm:px-4\" data-kid=\"1-2-1\" data-name=\"header navigation wrapper\">\n            <nav aria-label=\"Main navigation\" class=\"desktop-nav flex items-center gap-7 text-[14px] text-[var(--ink)]\" data-kid=\"1-2-1-1\" data-name=\"desktop navigation menu\">\n                <a class=\"transition-colors hover:text-[var(--accent)]\" data-kid=\"1-2-1-1-1\" data-name=\"home navigation link\" href=\"index.html\">\n                    Home\n                </a>\n                <a aria-current=\"page\" class=\"border-b border-[var(--ink)] pb-1 font-medium\" data-kid=\"1-2-1-1-2\" data-name=\"shop navigation link\" href=\"all.html\">\n                    Shop\n                </a>\n                <a class=\"transition-colors hover:text-[var(--accent)]\" data-kid=\"1-2-1-1-3\" data-name=\"brand story navigation link\" href=\"index.html#about\">\n                    Brand story\n                </a>\n            </nav>\n            <a aria-label=\"Solids home\" class=\"justify-self-center\" data-kid=\"1-2-1-2\" data-name=\"home link logo\" href=\"index.html\">\n                <img alt=\"Solids — No prints, just style\" class=\"brand-logo block w-[164px] object-contain\" data-kid=\"1-2-1-2-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n            </a>\n            <div class=\"utility-actions flex items-center justify-self-end gap-6 text-[14px] max-sm:gap-5\" data-kid=\"1-2-1-3\" data-name=\"utility actions\">\n                <button aria-label=\"Search products\" class=\"min-h-[44px] px-1 transition-colors hover:text-[var(--accent)]\" data-kid=\"1-2-1-3-1\" data-name=\"search products button\" type=\"button\">\n                    Search\n                </button>\n                <button aria-label=\"Open bag, 0 items\" class=\"min-h-[44px] border-l border-[var(--line)] pl-6 pr-1 transition-colors hover:text-[var(--accent)] max-sm:pl-4\" data-kid=\"1-2-1-3-2\" data-name=\"open shopping bag button\" type=\"button\">\n                    Bag\n                    <span class=\"ml-1 text-[var(--accent)]\" data-dynamic=\"true\" data-kid=\"1-2-1-3-2-1\" data-name=\"shopping bag item count\" data-reason=\"count replaced by shopping bag state script\">\n                        0\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"catalog-main mx-auto max-w-[1360px] px-8 pb-24 pt-9 max-sm:pt-7\" data-kid=\"1-3\" data-name=\"catalog content area\">\n        <nav aria-label=\"Breadcrumb\" class=\"mb-8 flex items-center gap-2 text-[13px] text-[var(--muted)] max-sm:mb-6\" data-kid=\"1-3-1\" data-name=\"breadcrumb navigation\">\n            <a class=\"hover:text-[var(--ink)]\" data-kid=\"1-3-1-1\" data-name=\"breadcrumb home link\" href=\"index.html\">\n                Home\n            </a>\n            <span aria-hidden=\"true\" data-kid=\"1-3-1-2\" data-name=\"breadcrumb separator\">\n                /\n            </span>\n            <span aria-current=\"page\" class=\"text-[var(--ink)]\" data-kid=\"1-3-1-3\" data-name=\"breadcrumb current page\">\n                Shop\n            </span>\n        </nav>\n        <div class=\"catalog-heading mb-7 flex justify-between gap-6\" data-kid=\"1-3-2\" data-name=\"catalog heading section\">\n            <div data-kid=\"1-3-2-1\" data-name=\"heading text container\">\n                <h1 class=\"display text-[42px] font-normal leading-tight tracking-[-0.045em] max-sm:text-[34px]\" data-kid=\"1-3-2-1-1\" data-name=\"catalog heading\">\n                    All products\n                </h1>\n                <p class=\"mt-2 text-[15px] text-[var(--muted)]\" data-kid=\"1-3-2-1-2\" data-name=\"catalog description\">\n                    Everyday pieces, made to be worn your way.\n                </p>\n            </div>\n            <p class=\"shrink-0 self-end pb-1 text-[14px] text-[var(--muted)]\" data-kid=\"1-3-2-2\" data-name=\"product count display\">\n                <span class=\"font-medium text-[var(--ink)]\" data-dynamic=\"true\" data-kid=\"1-3-2-2-1\" data-name=\"product count number\" data-reason=\"number replaced by product filter script\">\n                    13\n                </span>\n                products\n            </p>\n        </div>\n        <nav aria-label=\"Filter by category\" class=\"filter-list mb-8 flex items-center gap-2 border-y border-[var(--line)] py-3\" data-kid=\"1-3-3\" data-name=\"category filter menu\">\n            <a aria-current=\"true\" class=\"flex min-h-[42px] items-center border-b-2 border-[var(--ink)] px-4 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-3-3-1\" data-name=\"all products filter link\" href=\"all.html\">\n                All products\n            </a>\n            <a class=\"flex min-h-[42px] items-center border-b-2 border-transparent px-4 text-[14px] text-[var(--muted)] hover:border-[var(--line)] hover:text-[var(--ink)]\" data-kid=\"1-3-3-2\" data-name=\"new arrivals filter link\" href=\"all.html?category=new-arrivals\">\n                New Arrivals\n            </a>\n            <a class=\"flex min-h-[42px] items-center border-b-2 border-transparent px-4 text-[14px] text-[var(--muted)] hover:border-[var(--line)] hover:text-[var(--ink)]\" data-kid=\"1-3-3-3\" data-name=\"co-ord sets filter link\" href=\"all.html?category=co-ord-sets\">\n                Co-ord Sets\n            </a>\n            <a class=\"flex min-h-[42px] items-center border-b-2 border-transparent px-4 text-[14px] text-[var(--muted)] hover:border-[var(--line)] hover:text-[var(--ink)]\" data-kid=\"1-3-3-4\" data-name=\"dresses filter link\" href=\"all.html?category=dresses\">\n                Dresses\n            </a>\n            <a class=\"flex min-h-[42px] items-center border-b-2 border-transparent px-4 text-[14px] text-[var(--muted)] hover:border-[var(--line)] hover:text-[var(--ink)]\" data-kid=\"1-3-3-5\" data-name=\"tops filter link\" href=\"all.html?category=tops\">\n                Tops\n            </a>\n            <a class=\"flex min-h-[42px] items-center border-b-2 border-transparent px-4 text-[14px] text-[var(--muted)] hover:border-[var(--line)] hover:text-[var(--ink)]\" data-kid=\"1-3-3-6\" data-name=\"bottoms filter link\" href=\"all.html?category=bottoms\">\n                Bottoms\n            </a>\n        </nav>\n        <section aria-label=\"All Solids products\" data-kid=\"1-3-4\" data-name=\"products list section\">\n            <div class=\"product-grid grid grid-cols-4 gap-x-5 gap-y-12 max-[1000px]:grid-cols-2 max-sm:gap-y-8\" data-kid=\"1-3-4-1\" data-name=\"product grid container\">\n                <article class=\"min-w-0\" data-kid=\"1-3-4-1-1\" data-name=\"first product card\">\n                    <a aria-label=\"View Soft Rib Co-ord\" class=\"group block\" data-kid=\"1-3-4-1-1-1\" data-name=\"first product link\" href=\"product.html?product=0\">\n                        <div class=\"product-photo relative overflow-hidden bg-[var(--cream)]\" data-kid=\"1-3-4-1-1-1-1\" data-name=\"first product photo container\">\n                            <img alt=\"Soft Rib Co-ord\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-3-4-1-1-1-1-1\" data-name=\"first product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=900&q=85\"/>\n                            <span class=\"absolute left-3 top-3 bg-[var(--paper)] px-3 py-2 text-[12px] font-medium\" data-kid=\"1-3-4-1-1-1-1-2\" data-name=\"first product badge\">\n                                New\n                            </span>\n                        </div>\n                        <div class=\"product-row mt-4 flex items-start justify-between gap-4\" data-kid=\"1-3-4-1-1-1-2\" data-name=\"first product info row\">\n                            <div data-kid=\"1-3-4-1-1-1-2-1\" data-name=\"first product title container\">\n                                <h2 class=\"text-[16px] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"1-3-4-1-1-1-2-1-1\" data-name=\"first product title\">\n                                    Soft Rib Co-ord\n                                </h2>\n                                <p class=\"mt-1.5 text-[14px] text-[var(--muted)]\" data-kid=\"1-3-4-1-1-1-2-1-2\" data-name=\"first product category\">\n                                    Co-ord Sets\n                                </p>\n                            </div>\n                            <p class=\"shrink-0 pt-0.5 text-[15px] font-medium\" data-kid=\"1-3-4-1-1-1-2-2\" data-name=\"first product price\">\n                                Rs. 12,800\n                            </p>\n                        </div>\n                        <span class=\"mt-3 inline-flex min-h-[36px] items-center border-b border-[var(--ink)] text-[13px] font-medium\" data-kid=\"1-3-4-1-1-1-3\" data-name=\"first product view link\">\n                            View product\n                            <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-3-4-1-1-1-3-1\" data-name=\"first product arrow icon\">\n                                ↗\n                            </span>\n                        </span>\n                    </a>\n                </article>\n                <article class=\"min-w-0\" data-kid=\"1-3-4-1-2\" data-name=\"second product card\">\n                    <a aria-label=\"View Sculpt Knit Co-ord\" class=\"group block\" data-kid=\"1-3-4-1-2-1\" data-name=\"second product link\" href=\"product.html?product=1\">\n                        <div class=\"product-photo relative overflow-hidden bg-[var(--cream)]\" data-kid=\"1-3-4-1-2-1-1\" data-name=\"second product photo container\">\n                            <img alt=\"Sculpt Knit Co-ord\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-3-4-1-2-1-1-1\" data-name=\"second product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=85\"/>\n                            <span class=\"absolute left-3 top-3 bg-[var(--paper)] px-3 py-2 text-[12px] font-medium\" data-kid=\"1-3-4-1-2-1-1-2\" data-name=\"second product badge\">\n                                New\n                            </span>\n                        </div>\n                        <div class=\"product-row mt-4 flex items-start justify-between gap-4\" data-kid=\"1-3-4-1-2-1-2\" data-name=\"second product info row\">\n                            <div data-kid=\"1-3-4-1-2-1-2-1\" data-name=\"second product title container\">\n                                <h2 class=\"text-[16px] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"1-3-4-1-2-1-2-1-1\" data-name=\"second product title\">\n                                    Sculpt Knit Co-ord\n                                </h2>\n                                <p class=\"mt-1.5 text-[14px] text-[var(--muted)]\" data-kid=\"1-3-4-1-2-1-2-1-2\" data-name=\"second product category\">\n                                    Co-ord Sets\n                                </p>\n                            </div>\n                            <p class=\"shrink-0 pt-0.5 text-[15px] font-medium\" data-kid=\"1-3-4-1-2-1-2-2\" data-name=\"second product price\">\n                                Rs. 14,800\n                            </p>\n                        </div>\n                        <span class=\"mt-3 inline-flex min-h-[36px] items-center border-b border-[var(--ink)] text-[13px] font-medium\" data-kid=\"1-3-4-1-2-1-3\" data-name=\"second product view link\">\n                            View product\n                            <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-3-4-1-2-1-3-1\" data-name=\"second product arrow icon\">\n                                ↗\n                            </span>\n                        </span>\n                    </a>\n                </article>\n                <article class=\"min-w-0\" data-kid=\"1-3-4-1-3\" data-name=\"third product card\">\n                    <a aria-label=\"View Linen Lounge Set\" class=\"group block\" data-kid=\"1-3-4-1-3-1\" data-name=\"third product link\" href=\"product.html?product=2\">\n                        <div class=\"product-photo relative overflow-hidden bg-[var(--cream)]\" data-kid=\"1-3-4-1-3-1-1\" data-name=\"third product photo container\">\n                            <img alt=\"Linen Lounge Set\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-3-4-1-3-1-1-1\" data-name=\"third product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=900&q=85\"/>\n                            <span class=\"absolute left-3 top-3 bg-[var(--paper)] px-3 py-2 text-[12px] font-medium\" data-kid=\"1-3-4-1-3-1-1-2\" data-name=\"third product badge\">\n                                Bestseller\n                            </span>\n                        </div>\n                        <div class=\"product-row mt-4 flex items-start justify-between gap-4\" data-kid=\"1-3-4-1-3-1-2\" data-name=\"third product info row\">\n                            <div data-kid=\"1-3-4-1-3-1-2-1\" data-name=\"third product title container\">\n                                <h2 class=\"text-[16px] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"1-3-4-1-3-1-2-1-1\" data-name=\"third product title\">\n                                    Linen Lounge Set\n                                </h2>\n                                <p class=\"mt-1.5 text-[14px] text-[var(--muted)]\" data-kid=\"1-3-4-1-3-1-2-1-2\" data-name=\"third product category\">\n                                    Co-ord Sets\n                                </p>\n                            </div>\n                            <p class=\"shrink-0 pt-0.5 text-[15px] font-medium\" data-kid=\"1-3-4-1-3-1-2-2\" data-name=\"third product price\">\n                                Rs. 13,900\n                            </p>\n                        </div>\n                        <span class=\"mt-3 inline-flex min-h-[36px] items-center border-b border-[var(--ink)] text-[13px] font-medium\" data-kid=\"1-3-4-1-3-1-3\" data-name=\"third product view link\">\n                            View product\n                            <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-3-4-1-3-1-3-1\" data-name=\"third product arrow icon\">\n                                ↗\n                            </span>\n                        </span>\n                    </a>\n                </article>\n                <article class=\"min-w-0\" data-kid=\"1-3-4-1-4\" data-name=\"fourth product card\">\n                    <a aria-label=\"View Contour Slip Dress\" class=\"group block\" data-kid=\"1-3-4-1-4-1\" data-name=\"fourth product link\" href=\"product.html?product=4\">\n                        <div class=\"product-photo relative overflow-hidden bg-[var(--cream)]\" data-kid=\"1-3-4-1-4-1-1\" data-name=\"fourth product photo container\">\n                            <img alt=\"Contour Slip Dress\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-3-4-1-4-1-1-1\" data-name=\"fourth product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=900&q=85\"/>\n                            <span class=\"absolute left-3 top-3 bg-[var(--paper)] px-3 py-2 text-[12px] font-medium\" data-kid=\"1-3-4-1-4-1-1-2\" data-name=\"fourth product badge\">\n                                New\n                            </span>\n                        </div>\n                        <div class=\"product-row mt-4 flex items-start justify-between gap-4\" data-kid=\"1-3-4-1-4-1-2\" data-name=\"fourth product info row\">\n                            <div data-kid=\"1-3-4-1-4-1-2-1\" data-name=\"fourth product title container\">\n                                <h2 class=\"text-[16px] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"1-3-4-1-4-1-2-1-1\" data-name=\"fourth product title\">\n                                    Contour Slip Dress\n                                </h2>\n                                <p class=\"mt-1.5 text-[14px] text-[var(--muted)]\" data-kid=\"1-3-4-1-4-1-2-1-2\" data-name=\"fourth product category\">\n                                    Dresses\n                                </p>\n                            </div>\n                            <p class=\"shrink-0 pt-0.5 text-[15px] font-medium\" data-kid=\"1-3-4-1-4-1-2-2\" data-name=\"fourth product price\">\n                                Rs. 9,500\n                            </p>\n                        </div>\n                        <span class=\"mt-3 inline-flex min-h-[36px] items-center border-b border-[var(--ink)] text-[13px] font-medium\" data-kid=\"1-3-4-1-4-1-3\" data-name=\"fourth product view link\">\n                            View product\n                            <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-3-4-1-4-1-3-1\" data-name=\"fourth product arrow icon\">\n                                ↗\n                            </span>\n                        </span>\n                    </a>\n                </article>\n            </div>\n        </section>\n    </main>\n</div>\n",
