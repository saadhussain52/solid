    "var_56d5e4117740": {
      "type": "variant",
      "label": "01 · Editorial · Product",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap\");\n@layer components {\n  .solids-product-page {\n    --ink: #292827;\n    --muted: #746f68;\n    --paper: #f8f7f3;\n    --cream: #efebe4;\n    --line: #dedbd4;\n    --accent: #b87558;\n    color: var(--ink);\n    background: var(--paper);\n    font-family: 'DM Sans', sans-serif;\n  }\n  .solids-product-page button { color: inherit; font: inherit; }\n  .dp-serif { font-family: 'Libre Baskerville', serif; }\n  .dp-topbar { border-bottom: 1px solid var(--line); }\n  .dp-header { min-height: 82px; max-width: 1500px; padding: 0 5.3vw; margin: 0 auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }\n  .dp-nav { display: flex; align-items: center; gap: 31px; font-size: 13px; }\n  .dp-nav a { color: var(--muted); text-decoration: none; }\n  .dp-nav a.active { color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 6px; }\n  .dp-brand { display: block; justify-self: center; width: 150px; height: 62px; }\n  .dp-brand img { width: 100%; height: 100%; object-fit: contain; }\n  .dp-actions { justify-self: end; display: flex; gap: 24px; align-items: center; }\n  .dp-header-action { border: 0; background: none; display: inline-flex; align-items: center; gap: 9px; padding: 11px 0; font-size: 13px; cursor: pointer; }\n  .dp-bag-count { min-width: 23px; height: 23px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--muted); font-size: 11px; }\n  .dp-main { max-width: 1500px; padding: 0 5.3vw 84px; margin: 0 auto; }\n  .dp-breadcrumb { display: flex; align-items: center; gap: 12px; padding: 28px 0 23px; font-size: 12px; color: var(--muted); }\n  .dp-breadcrumb a { color: inherit; text-decoration: none; }\n  .dp-breadcrumb a:last-of-type { color: var(--ink); }\n  .dp-breadcrumb span { color: #b3ada5; }\n  .dp-layout { display: grid; grid-template-columns: minmax(0, 1.16fr) minmax(360px, .84fr); gap: clamp(54px, 8vw, 132px); align-items: start; }\n  .dp-image-stage { position: relative; background: var(--cream); min-width: 0; overflow: hidden; }\n  .dp-image-stage img { display: block; width: 100%; height: min(72vw, 765px); min-height: 615px; object-fit: cover; object-position: 50% 35%; }\n  .dp-image-caption { position: absolute; left: 24px; bottom: 22px; color: white; font-size: 11px; letter-spacing: .02em; text-shadow: 0 1px 8px rgba(25,22,20,.38); }\n  .dp-purchase { padding: 43px 0 10px; max-width: 475px; }\n  .dp-category { margin: 0 0 19px; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }\n  .dp-title { margin: 0; font: 400 clamp(33px, 3vw, 47px)/1.16 'Libre Baskerville', serif; letter-spacing: -.045em; }\n  .dp-price { margin: 17px 0 0; font-size: 18px; font-weight: 500; }\n  .dp-rule { border: 0; border-top: 1px solid var(--line); margin: 27px 0 20px; }\n  .dp-availability { display: flex; align-items: center; gap: 9px; margin: 0; font-size: 13px; color: #545149; }\n  .dp-dot { width: 7px; height: 7px; border-radius: 50%; background: #75866d; }\n  .dp-size-heading { display: flex; justify-content: space-between; align-items: baseline; margin: 27px 0 12px; }\n  .dp-size-heading label { font-size: 13px; font-weight: 600; }\n  .dp-selected { color: var(--muted); font-size: 12px; }\n  .dp-sizes { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }\n  .dp-size { min-height: 49px; border: 1px solid var(--line); background: transparent; font-size: 12px; cursor: pointer; }\n  .dp-size.selected { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); background: #fff; }\n  .dp-size:disabled { color: #a9a49e; background: linear-gradient(135deg, transparent 49.2%, #d7d1c9 49.5%, #d7d1c9 50.5%, transparent 50.8%); cursor: not-allowed; }\n  .dp-size-note { margin: 10px 0 0; min-height: 18px; font-size: 12px; color: var(--muted); }\n  .dp-qty-label { display: block; margin: 25px 0 10px; font-size: 13px; font-weight: 600; }\n  .dp-quantity { width: 132px; height: 48px; border: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; text-align: center; background: #fff; }\n  .dp-quantity button { height: 100%; border: 0; background: transparent; font-size: 18px; cursor: pointer; }\n  .dp-quantity span { font-size: 13px; }\n  .dp-add { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 58px; margin-top: 20px; border: 1px solid var(--ink); padding: 0 21px; background: var(--ink); color: white !important; font-size: 13px !important; font-weight: 600 !important; cursor: pointer; }\n  .dp-add em { font-size: 18px; font-style: normal; font-weight: 400; }\n  .dp-choice-note { margin: 11px 0 0; display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font-size: 12px; }\n  .dp-description { border-top: 1px solid var(--line); margin-top: 26px; padding-top: 22px; }\n  .dp-description h2 { margin: 0 0 10px; font-size: 13px; font-weight: 600; }\n  .dp-description p { max-width: 43ch; margin: 0; color: #59564f; font-size: 14px; line-height: 1.75; }\n  .dp-mobile-add { display: none; }\n  .dp-focus:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }\n  @media (max-width: 900px) {\n    .dp-header { min-height: 72px; padding: 0 24px; }\n    .dp-nav { gap: 18px; font-size: 12px; }\n    .dp-brand { width: 126px; height: 56px; }\n    .dp-actions { gap: 16px; }\n    .dp-main { padding: 0 24px 72px; }\n    .dp-layout { grid-template-columns: minmax(0, 1.08fr) minmax(320px, .92fr); gap: 38px; }\n    .dp-image-stage img { min-height: 540px; }\n    .dp-purchase { padding-top: 24px; }\n    .dp-sizes { gap: 5px; }\n    .dp-size { font-size: 11px; }\n  }\n  @media (max-width: 680px) {\n    .dp-header { min-height: 66px; padding: 0 18px; grid-template-columns: 1fr auto; }\n    .dp-nav { display: none; }\n    .dp-brand { justify-self: start; width: 120px; height: 54px; }\n    .dp-actions { gap: 14px; }\n    .dp-header-action { font-size: 12px; gap: 6px; min-height: 44px; }\n    .dp-bag-count { min-width: 21px; height: 21px; }\n    .dp-main { padding: 0 0 96px; }\n    .dp-breadcrumb { padding: 17px 20px 15px; font-size: 11px; }\n    .dp-layout { display: flex; flex-direction: column; gap: 0; }\n    .dp-image-stage { width: 100%; }\n    .dp-image-stage img { width: 100%; height: min(118vw, 490px); min-height: 0; object-position: 50% 36%; }\n    .dp-image-caption { left: 18px; bottom: 16px; }\n    .dp-purchase { max-width: none; width: 100%; padding: 25px 20px 20px; }\n    .dp-category { margin-bottom: 11px; font-size: 11px; }\n    .dp-title { font-size: 30px; line-height: 1.18; }\n    .dp-price { margin-top: 9px; font-size: 16px; }\n    .dp-rule { margin: 17px 0 15px; }\n    .dp-size-heading { margin-top: 22px; }\n    .dp-size { min-height: 48px; font-size: 12px; }\n    .dp-qty-label { margin-top: 20px; }\n    .dp-add { display: none; }\n    .dp-mobile-add { position: fixed; z-index: 12; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; align-items: center; gap: 15px; padding: 12px 18px max(12px, env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: rgba(248,247,243,.97); }\n    .dp-mobile-add p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.45; }\n    .dp-mobile-add p strong { display: block; color: var(--ink); font-size: 12px; font-weight: 600; }\n    .dp-mobile-add button { min-height: 48px; padding: 0 18px; border: 0; background: var(--ink); color: white; font-size: 12px; font-weight: 600; white-space: nowrap; }\n    .dp-description { margin-top: 20px; padding-top: 18px; }\n  }\n  @media (max-width: 390px) {\n    .dp-header { padding-inline: 14px; }\n    .dp-main { padding-bottom: 96px; }\n    .dp-purchase { padding-inline: 16px; }\n    .dp-size { font-size: 10px; }\n    .dp-mobile-add { padding-inline: 14px; }\n  }\n}\n</style>\n<div class=\"solids-product-page min-h-screen\" data-kid=\"1\">\n    <header class=\"dp-topbar\" data-kid=\"1-1\">\n        <div class=\"dp-header\" data-kid=\"1-1-1\">\n            <nav aria-label=\"Main navigation\" class=\"dp-nav\" data-kid=\"1-1-1-1\">\n                <a data-kid=\"1-1-1-1-1\" href=\"#home\">\n                    Home\n                </a>\n                <a class=\"active\" data-kid=\"1-1-1-1-2\" href=\"#shop\">\n                    Shop\n                </a>\n                <a data-kid=\"1-1-1-1-3\" href=\"#story\">\n                    Brand story\n                </a>\n            </nav>\n            <a aria-label=\"Solids home\" class=\"dp-brand\" data-kid=\"1-1-1-2\" href=\"#home\">\n                <img alt=\"Solids — No prints, just style\" data-kid=\"1-1-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n            </a>\n            <div class=\"dp-actions\" data-kid=\"1-1-1-3\">\n                <button aria-label=\"Search products\" class=\"dp-header-action dp-focus\" data-kid=\"1-1-1-3-1\">\n                    Search\n                </button>\n                <button aria-label=\"Open bag\" class=\"dp-header-action dp-focus\" data-kid=\"1-1-1-3-2\">\n                    Bag\n                    <span class=\"dp-bag-count\" data-dynamic=\"true\" data-kid=\"1-1-1-3-2-1\" data-name=\"bag count indicator\" data-reason=\"text replaced by bag state update script\">\n                        0\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"dp-main\" data-kid=\"1-2\">\n        <nav aria-label=\"Breadcrumb\" class=\"dp-breadcrumb\" data-kid=\"1-2-1\">\n            <a data-kid=\"1-2-1-1\" href=\"#home\">\n                Home\n            </a>\n            <span aria-hidden=\"true\" data-kid=\"1-2-1-2\">\n                /\n            </span>\n            <a data-kid=\"1-2-1-3\" href=\"#shop\">\n                All products\n            </a>\n            <span aria-hidden=\"true\" data-kid=\"1-2-1-4\">\n                /\n            </span>\n            <span data-kid=\"1-2-1-5\">\n                Soft Rib Co-ord\n            </span>\n        </nav>\n        <section aria-label=\"Soft Rib Co-ord product details\" class=\"dp-layout\" data-kid=\"1-2-2\">\n            <div class=\"dp-image-stage\" data-kid=\"1-2-2-1\">\n                <img alt=\"Neutral clothing and denim displayed on a rail\" data-kid=\"1-2-2-1-1\" data-name=\"product main image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&w=1400&q=82&fit=crop\"/>\n            </div>\n            <div class=\"dp-purchase\" data-kid=\"1-2-2-2\">\n                <p class=\"dp-category\" data-kid=\"1-2-2-2-1\">\n                    Co-ord Sets\n                </p>\n                <h1 class=\"dp-title\" data-kid=\"1-2-2-2-2\">\n                    Soft Rib Co-ord\n                </h1>\n                <p class=\"dp-price\" data-kid=\"1-2-2-2-3\">\n                    Rs. 12,800\n                </p>\n                <hr class=\"dp-rule\" data-kid=\"1-2-2-2-4\"/>\n                <p class=\"dp-availability\" data-kid=\"1-2-2-2-5\">\n                    <span aria-hidden=\"true\" class=\"dp-dot\" data-kid=\"1-2-2-2-5-1\">\n                    </span>\n                    In stock\n                </p>\n                <div class=\"dp-size-heading\" data-kid=\"1-2-2-2-6\">\n                    <label data-kid=\"1-2-2-2-6-1\">\n                        Choose a size\n                    </label>\n                    <span class=\"dp-selected\" data-kid=\"1-2-2-2-6-2\">\n                        Selected: Small\n                    </span>\n                </div>\n                <div aria-label=\"Available sizes\" class=\"dp-sizes\" data-kid=\"1-2-2-2-7\">\n                    <button class=\"dp-size dp-focus\" data-kid=\"1-2-2-2-7-1\">\n                        X-Small\n                    </button>\n                    <button aria-pressed=\"true\" class=\"dp-size selected dp-focus\" data-kid=\"1-2-2-2-7-2\">\n                        Small\n                    </button>\n                    <button class=\"dp-size dp-focus\" data-kid=\"1-2-2-2-7-3\">\n                        Medium\n                    </button>\n                    <button class=\"dp-size dp-focus\" data-kid=\"1-2-2-2-7-4\">\n                        Large\n                    </button>\n                    <button aria-label=\"X-Large unavailable\" class=\"dp-size dp-focus\" data-kid=\"1-2-2-2-7-5\" disabled=\"\">\n                        X-Large\n                    </button>\n                </div>\n                <p class=\"dp-size-note\" data-kid=\"1-2-2-2-8\">\n                    X-Large is currently unavailable.\n                </p>\n                <label class=\"dp-qty-label\" data-kid=\"1-2-2-2-9\">\n                    Quantity\n                </label>\n                <div aria-label=\"Quantity: 1\" class=\"dp-quantity\" data-kid=\"1-2-2-2-10\">\n                    <button aria-label=\"Decrease quantity\" class=\"dp-focus\" data-kid=\"1-2-2-2-10-1\">\n                        −\n                    </button>\n                    <span data-kid=\"1-2-2-2-10-2\">\n                        1\n                    </span>\n                    <button aria-label=\"Increase quantity\" class=\"dp-focus\" data-kid=\"1-2-2-2-10-3\">\n                        +\n                    </button>\n                </div>\n                <button class=\"dp-add dp-focus\" data-kid=\"1-2-2-2-11\">\n                    <span data-kid=\"1-2-2-2-11-1\">\n                        Add to bag\n                    </span>\n                    <em aria-hidden=\"true\" data-kid=\"1-2-2-2-11-2\">\n                        ↗\n                    </em>\n                </button>\n                <p class=\"dp-choice-note\" data-kid=\"1-2-2-2-12\">\n                    <span data-kid=\"1-2-2-2-12-1\">\n                        Small · 1 item\n                    </span>\n                    <span data-kid=\"1-2-2-2-12-2\">\n                        Bag: 0\n                    </span>\n                </p>\n                <div class=\"dp-description\" data-kid=\"1-2-2-2-13\">\n                    <h2 data-kid=\"1-2-2-2-13-1\">\n                        About this piece\n                    </h2>\n                    <p data-kid=\"1-2-2-2-13-2\">\n                        Thoughtfully made in a soft, breathable fabric with a considered fit for effortless everyday wear.\n                    </p>\n                </div>\n            </div>\n        </section>\n    </main>\n    <div class=\"dp-mobile-add\" data-kid=\"1-3\">\n        <p data-kid=\"1-3-1\">\n            <strong data-dynamic=\"true\" data-kid=\"1-3-1-1\" data-name=\"mobile choice summary size and quantity\" data-reason=\"text replaced when user updates size or quantity\">\n                Small · Quantity 1\n            </strong>\n            Rs. 12,800\n        </p>\n        <button class=\"dp-focus\" data-kid=\"1-3-2\">\n            Add to bag  ↗\n        </button>\n    </div>\n</div>\n",
