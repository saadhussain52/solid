      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n  .reading-progress { transform: scaleX(0); transform-origin: left center; }\n  .story-visual { position: sticky; top: 112px; height: min(68vh, 660px); }\n  .story-slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }\n  .story-slide:first-child { opacity: 1; }\n  .story-step { min-height: 61vh; }\n  .editorial-image { overflow: hidden; }\n  .editorial-image img { width: 100%; height: 100%; object-fit: cover; }\n  @media (max-width: 767px) {\n    .story-visual { position: relative; top: auto; height: 62vh; min-height: 390px; }\n    .story-step { min-height: 0; padding: 42px 0 58px; }\n  }\n</style>\n<div class=\"min-h-screen bg-[var(--paper)] font-[var(--sans)] text-[var(--ink)]\" data-kid=\"1\" style=\"--ink:#292827;--muted:#756f68;--paper:#f8f7f3;--cream:#efebe4;--line:#dedbd4;--accent:#b87558;--dark:#292827;--white:#fff;--sage:#6b8e72;--serif:'Libre Baskerville',serif;--sans:'DM Sans',sans-serif\">\n    <div class=\"reading-progress fixed inset-x-0 top-0 z-[60] h-[3px] bg-[var(--accent)]\" data-dynamic=\"true\" data-kid=\"1-1\" data-name=\"reading progress bar\" data-reason=\"rendered by GSAP scroll trigger\">\n    </div>\n    <div class=\"bg-[var(--ink)] px-5 py-2 text-center text-[10px] font-medium tracking-[0.13em] text-[#f7f3ec]\" data-kid=\"1-2\" data-name=\"announcement banner text\">\n        ORDERS DELIVER IN 4–7 WORKING DAYS\n        <span class=\"px-2 text-[var(--accent)]\" data-kid=\"1-2-1\" data-name=\"announcement banner bullet\">\n            •\n        </span>\n        COMPLIMENTARY DELIVERY ABOVE RS. 10,000\n    </div>\n    <header class=\"sticky top-0 z-40 grid h-[78px] grid-cols-[1fr_auto_1fr] items-center border-b border-[var(--line)] bg-[var(--paper)]/95 px-[5.5vw] backdrop-blur-md max-sm:h-[66px] max-sm:px-4\" data-kid=\"1-3\" data-name=\"sticky header\">\n        <nav aria-label=\"Main navigation\" class=\"flex items-center gap-8 text-[13px] max-md:hidden\" data-kid=\"1-3-1\" data-name=\"main navigation menu\">\n            <a class=\"hover:text-[var(--accent)]\" data-kid=\"1-3-1-1\" data-name=\"home link\" href=\"#home\">\n                Home\n            </a>\n            <a class=\"border-b border-[var(--ink)] pb-1\" data-kid=\"1-3-1-2\" data-name=\"shop link\" href=\"#product\">\n                Shop\n            </a>\n            <a class=\"hover:text-[var(--accent)]\" data-kid=\"1-3-1-3\" data-name=\"brand story link\" href=\"#story\">\n                Brand story\n            </a>\n        </nav>\n        <a aria-label=\"Solids home\" class=\"justify-self-center\" data-kid=\"1-3-2\" data-name=\"brand logo link\" href=\"#home\">\n            <img alt=\"Solids — No prints, just style\" class=\"h-[58px] w-[170px] object-contain max-sm:h-[42px] max-sm:w-[126px]\" data-kid=\"1-3-2-1\" data-name=\"brand logo image\" decoding=\"async\" height=\"58\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\" width=\"170\"/>\n        </a>\n        <div class=\"flex items-center justify-self-end gap-7 text-[13px] max-sm:gap-4\" data-kid=\"1-3-3\" data-name=\"header utility actions\">\n            <button aria-label=\"Search\" class=\"inline-flex items-center gap-2 hover:text-[var(--accent)] max-sm:gap-0\" data-kid=\"1-3-3-1\" data-name=\"search button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-search text-[17px]\" data-kid=\"1-3-3-1-1\" data-name=\"search icon\">\n                </i>\n                <span class=\"max-sm:hidden\" data-kid=\"1-3-3-1-2\" data-name=\"search label text\">\n                    Search\n                </span>\n            </button>\n            <button aria-label=\"Bag, 0 items\" class=\"inline-flex items-center gap-2 border-l border-[var(--line)] pl-6 hover:text-[var(--accent)] max-sm:pl-0\" data-kid=\"1-3-3-2\" data-name=\"shopping bag button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-shopping-bag text-[17px]\" data-kid=\"1-3-3-2-1\" data-name=\"shopping bag icon\">\n                </i>\n                <span data-kid=\"1-3-3-2-2\" data-name=\"shopping bag label text\">\n                    Bag\n                    <span class=\"text-[var(--accent)]\" data-dynamic=\"true\" data-kid=\"1-3-3-2-2-1\" data-name=\"shopping bag item count\" data-reason=\"count replaced when items are added to bag\">\n                        0\n                    </span>\n                </span>\n            </button>\n        </div>\n    </header>\n    <main data-kid=\"1-4\" data-name=\"main content area\" id=\"page-content\">\n        <section class=\"mx-auto max-w-[1240px] px-10 pb-24 pt-8 max-md:px-6 max-md:pb-16 max-sm:px-4 max-sm:pt-5\" data-kid=\"1-4-1\" data-name=\"product section\" id=\"product\">\n            <nav aria-label=\"Breadcrumb\" class=\"mb-7 flex items-center gap-2 text-[12px] text-[var(--muted)] max-sm:mb-4\" data-kid=\"1-4-1-1\" data-name=\"breadcrumb navigation\">\n                <a class=\"inline-flex items-center gap-2 text-[var(--ink)]\" data-kid=\"1-4-1-1-1\" data-name=\"back to all products link\" href=\"#collection\">\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-left text-[15px]\" data-kid=\"1-4-1-1-1-1\" data-name=\"left arrow icon\">\n                    </i>\n                    All products\n                </a>\n                <span class=\"px-1 text-[#b8b1a8]\" data-kid=\"1-4-1-1-2\" data-name=\"breadcrumb separator 1\">\n                    /\n                </span>\n                <span data-kid=\"1-4-1-1-3\" data-name=\"breadcrumb category label\">\n                    Co-ord Sets\n                </span>\n                <span class=\"px-1 text-[#b8b1a8]\" data-kid=\"1-4-1-1-4\" data-name=\"breadcrumb separator 2\">\n                    /\n                </span>\n                <span class=\"text-[var(--ink)]\" data-kid=\"1-4-1-1-5\" data-name=\"breadcrumb current product label\">\n                    Soft Rib Co-ord\n                </span>\n            </nav>\n            <div class=\"grid grid-cols-[1.08fr_0.92fr] items-start gap-[76px] max-lg:gap-12 max-md:grid-cols-1 max-md:gap-7\" data-kid=\"1-4-1-2\" data-name=\"product layout container\">\n                <div class=\"product-image-wrap relative overflow-hidden bg-[var(--cream)]\" data-kid=\"1-4-1-2-1\" data-name=\"product image wrapper\">\n                    <img alt=\"Soft Rib Co-ord preview from Solids\" class=\"product-hero-image block aspect-[0.88] w-full object-cover object-center max-md:aspect-[1.12] max-sm:aspect-[1.08]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-1-1\" data-name=\"product hero image\" data-reason=\"animated y-offset and scale by GSAP scroll trigger\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=1200&q=85\"/>\n                    <span class=\"absolute left-5 top-5 bg-[var(--paper)] px-3 py-2 text-[10px] uppercase tracking-[0.12em]\" data-kid=\"1-4-1-2-1-2\" data-name=\"new season tag\">\n                        New season\n                    </span>\n                    <span class=\"absolute bottom-5 right-5 bg-[var(--paper)]/90 px-3 py-2 text-[10px] tracking-[0.1em]\" data-kid=\"1-4-1-2-1-3\" data-name=\"image gallery counter\">\n                        01 / 04\n                    </span>\n                </div>\n                <div class=\"product-copy pt-5 max-md:pt-0 max-md:pb-2\" data-kid=\"1-4-1-2-2\" data-name=\"product purchase details\">\n                    <p class=\"mb-4 text-[12px] font-medium tracking-[0.08em] text-[var(--muted)]\" data-kid=\"1-4-1-2-2-1\" data-name=\"product category label\">\n                        CO-ORD SETS\n                        <span class=\"px-2 text-[var(--accent)]\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"category label separator\">\n                            /\n                        </span>\n                        THE AUTUMN EDIT\n                    </p>\n                    <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-4-1-2-2-2\" data-name=\"product title and price header\">\n                        <h1 class=\"font-[var(--serif)] text-[36px] font-normal leading-[1.2] tracking-[-0.035em] max-sm:text-[27px]\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"product title headline\">\n                            Soft Rib Co-ord\n                        </h1>\n                        <p class=\"shrink-0 pt-1 font-[var(--serif)] text-[21px] leading-tight max-sm:text-[18px]\" data-kid=\"1-4-1-2-2-2-2\" data-name=\"product price text\">\n                            Rs. 12,800\n                        </p>\n                    </div>\n                    <div aria-label=\"Product-level availability: In stock\" class=\"mt-5 flex items-center gap-2.5 text-[13px]\" data-kid=\"1-4-1-2-2-3\" data-name=\"availability status indicator\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--sage)]\" data-kid=\"1-4-1-2-2-3-1\" data-name=\"in stock status dot\">\n                        </span>\n                        <span data-kid=\"1-4-1-2-2-3-2\" data-name=\"availability status text\">\n                            In stock\n                            <span class=\"ml-2 text-[var(--muted)]\" data-kid=\"1-4-1-2-2-3-2-1\" data-name=\"ready to wear note\">\n                                · Ready to wear, made to last\n                            </span>\n                        </span>\n                    </div>\n                    <p class=\"mt-7 max-w-[430px] text-[14px] leading-[1.85] text-[#57534e]\" data-kid=\"1-4-1-2-2-4\" data-name=\"product description text\">\n                        A considered two-piece in soft, breathable rib. Quietly structured, easy to move in, and made for the days that ask a little more of you.\n                    </p>\n                    <p class=\"mt-7 text-[13px] font-medium\" data-kid=\"1-4-1-2-2-5\" data-name=\"size selector header\">\n                        Select a size\n                        <span class=\"font-normal text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2-5-1\" data-name=\"selected size display\" data-reason=\"size text updated based on selected button\">\n                            · Selected: XS\n                        </span>\n                    </p>\n                    <div aria-label=\"Select a size\" class=\"mt-3 flex flex-wrap gap-2.5\" data-kid=\"1-4-1-2-2-6\" data-name=\"size selection group\" role=\"group\">\n                        <button aria-pressed=\"true\" class=\"min-h-12 min-w-14 border border-[var(--ink)] bg-[var(--ink)] px-4 text-[13px] font-medium text-white\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2-6-1\" data-name=\"XS size button\" data-reason=\"pressed state toggled by user interaction\" type=\"button\">\n                            XS\n                        </button>\n                        <button aria-pressed=\"false\" class=\"min-h-12 min-w-14 border border-[var(--line)] bg-[var(--paper)] px-4 text-[13px]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2-6-2\" data-name=\"S size button\" data-reason=\"pressed state toggled by user interaction\" type=\"button\">\n                            S\n                        </button>\n                        <button aria-pressed=\"false\" class=\"min-h-12 min-w-14 border border-[var(--line)] bg-[var(--paper)] px-4 text-[13px]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2-6-3\" data-name=\"M size button\" data-reason=\"pressed state toggled by user interaction\" type=\"button\">\n                            M\n                        </button>\n                        <button aria-pressed=\"false\" class=\"min-h-12 min-w-14 border border-[var(--line)] bg-[var(--paper)] px-4 text-[13px]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2-6-4\" data-name=\"L size button\" data-reason=\"pressed state toggled by user interaction\" type=\"button\">\n                            L\n                        </button>\n                        <button aria-label=\"XL, unavailable\" class=\"flex min-h-12 min-w-16 flex-col items-center justify-center border border-[var(--line)] bg-[#f1efeb] px-3 text-[12px] text-[#8a847c]\" data-kid=\"1-4-1-2-2-6-5\" data-name=\"XL unavailable size button\" disabled=\"\" type=\"button\">\n                            <span data-kid=\"1-4-1-2-2-6-5-1\" data-name=\"size label\">\n                                XL\n                            </span>\n                            <span class=\"text-[9px]\" data-kid=\"1-4-1-2-2-6-5-2\" data-name=\"unavailable status text\">\n                                Unavailable\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"mt-6 flex items-center gap-4\" data-kid=\"1-4-1-2-2-7\" data-name=\"quantity selector group\">\n                        <span class=\"text-[13px] font-medium\" data-kid=\"1-4-1-2-2-7-1\" data-name=\"quantity label\">\n                            Quantity\n                        </span>\n                        <div class=\"flex h-11 items-center border border-[var(--line)] bg-[var(--paper)]\" data-kid=\"1-4-1-2-2-7-2\" data-name=\"quantity control group\">\n                            <button aria-label=\"Decrease quantity\" class=\"grid h-11 w-11 place-items-center text-[20px] text-[var(--muted)]\" data-kid=\"1-4-1-2-2-7-2-1\" data-name=\"decrease quantity button\" type=\"button\">\n                                −\n                            </button>\n                            <span class=\"min-w-8 text-center text-[13px]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2-7-2-2\" data-name=\"current quantity count\" data-reason=\"number incremented/decremented by buttons\">\n                                1\n                            </span>\n                            <button aria-label=\"Increase quantity\" class=\"grid h-11 w-11 place-items-center text-[20px] text-[var(--muted)]\" data-kid=\"1-4-1-2-2-7-2-3\" data-name=\"increase quantity button\" type=\"button\">\n                                +\n                            </button>\n                        </div>\n                    </div>\n                    <button class=\"mt-6 flex min-h-[54px] w-full items-center justify-between bg-[var(--dark)] px-6 text-[13px] font-semibold tracking-[0.03em] text-white max-sm:mt-5\" data-kid=\"1-4-1-2-2-8\" data-name=\"add to bag button\" type=\"button\">\n                        <span data-kid=\"1-4-1-2-2-8-1\" data-name=\"add to bag label text\">\n                            Add to bag\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[17px]\" data-kid=\"1-4-1-2-2-8-2\" data-name=\"arrow right icon\">\n                        </i>\n                    </button>\n                    <div class=\"mt-5 flex items-center gap-3 text-[11px] text-[var(--muted)]\" data-kid=\"1-4-1-2-2-9\" data-name=\"delivery benefits summary\">\n                        <i aria-hidden=\"true\" class=\"ti ti-truck-delivery text-[15px] text-[var(--accent)]\" data-kid=\"1-4-1-2-2-9-1\" data-name=\"delivery truck icon\">\n                        </i>\n                        <span data-kid=\"1-4-1-2-2-9-2\" data-name=\"complimentary delivery label\">\n                            Complimentary delivery over Rs. 10,000\n                        </span>\n                        <span class=\"text-[var(--line)]\" data-kid=\"1-4-1-2-2-9-3\" data-name=\"separator 1\">\n                            |\n                        </span>\n                        <span data-kid=\"1-4-1-2-2-9-4\" data-name=\"easy returns label\">\n                            Easy 7-day returns\n                        </span>\n                    </div>\n                    <a class=\"mt-8 inline-flex items-center gap-2 border-b border-[var(--ink)] pb-1 text-[11px] uppercase tracking-[0.12em]\" data-kid=\"1-4-1-2-2-10\" data-name=\"discover details link\" href=\"#story\">\n                        Discover the details\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-down-right text-[15px]\" data-kid=\"1-4-1-2-2-10-1\" data-name=\"arrow down right icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y border-[var(--line)] bg-[#f1eee8] px-6 py-20 text-center max-sm:py-14\" data-kid=\"1-4-2\" data-name=\"the solids standard section\" id=\"story\">\n            <p class=\"mb-5 text-[10px] font-semibold tracking-[0.24em] text-[var(--accent)]\" data-kid=\"1-4-2-1\" data-name=\"section overline text\">\n                THE SOLIDS STANDARD\n            </p>\n            <h2 class=\"mx-auto max-w-[850px] font-[var(--serif)] text-[clamp(30px,4.2vw,58px)] leading-[1.25] tracking-[-0.04em]\" data-kid=\"1-4-2-2\" data-name=\"section headline\">\n                Fewer things.\n                <span class=\"italic text-[var(--muted)]\" data-kid=\"1-4-2-2-1\" data-name=\"italic headline accent\">\n                    Better considered.\n                </span>\n            </h2>\n            <p class=\"mx-auto mt-6 max-w-[470px] text-[14px] leading-[1.9] text-[var(--muted)]\" data-kid=\"1-4-2-3\" data-name=\"section description text\">\n                Follow the fabric, the fit, and the little choices that make this a piece you reach for again.\n            </p>\n            <div class=\"mx-auto mt-9 flex items-center justify-center gap-3 text-[10px] tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-4-2-4\" data-name=\"scroll prompt\">\n                <span class=\"h-px w-10 bg-[var(--accent)]\" data-kid=\"1-4-2-4-1\" data-name=\"scroll prompt line 1\">\n                </span>\n                SCROLL TO EXPLORE\n                <span class=\"h-px w-10 bg-[var(--accent)]\" data-kid=\"1-4-2-4-2\" data-name=\"scroll prompt line 2\">\n                </span>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1240px] px-10 py-28 max-md:px-6 max-md:py-20 max-sm:px-4\" data-kid=\"1-4-3\" data-name=\"fabric story section\" id=\"fabric-story\">\n            <div class=\"mb-12 grid grid-cols-[1fr_auto] items-end gap-6 max-sm:grid-cols-1\" data-kid=\"1-4-3-1\" data-name=\"section header container\">\n                <div data-kid=\"1-4-3-1-1\" data-name=\"section header info\">\n                    <p class=\"mb-4 text-[10px] font-semibold tracking-[0.2em] text-[var(--accent)]\" data-kid=\"1-4-3-1-1-1\" data-name=\"section overline\">\n                        A CLOSER LOOK\n                    </p>\n                    <h2 class=\"font-[var(--serif)] text-[clamp(30px,4vw,50px)] leading-[1.2] tracking-[-0.04em]\" data-kid=\"1-4-3-1-1-2\" data-name=\"section headline\">\n                        Made for the everyday,\n                        <span class=\"italic text-[var(--muted)]\" data-kid=\"1-4-3-1-1-2-1\" data-name=\"italic headline accent\">\n                            not just the occasion.\n                        </span>\n                    </h2>\n                </div>\n                <span class=\"text-[11px] tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-4-3-1-2\" data-name=\"slide counter\">\n                    01 — 03\n                </span>\n            </div>\n            <div class=\"grid grid-cols-[0.96fr_1.04fr] gap-[8vw] max-md:grid-cols-1 max-md:gap-4\" data-kid=\"1-4-3-2\" data-name=\"story container\">\n                <div class=\"story-visual overflow-hidden bg-[var(--cream)] max-md:order-1\" data-kid=\"1-4-3-2-1\" data-name=\"sticky story visual\">\n                    <img alt=\"Soft neutral clothing, styled for everyday wear\" class=\"story-slide\" data-dynamic=\"true\" data-kid=\"1-4-3-2-1-1\" data-name=\"story slide 1\" data-reason=\"opacity animated by GSAP scroll trigger\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1100&q=85\"/>\n                    <img alt=\"A close view of considered everyday layers\" class=\"story-slide\" data-dynamic=\"true\" data-kid=\"1-4-3-2-1-2\" data-name=\"story slide 2\" data-reason=\"opacity animated by GSAP scroll trigger\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=1100&q=85\"/>\n                    <img alt=\"An easy silhouette in a quiet neutral palette\" class=\"story-slide\" data-dynamic=\"true\" data-kid=\"1-4-3-2-1-3\" data-name=\"story slide 3\" data-reason=\"opacity animated by GSAP scroll trigger\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1100&q=85\"/>\n                    <div class=\"absolute inset-x-0 bottom-0 flex items-end justify-between bg-gradient-to-t from-black/55 to-transparent px-6 pb-6 pt-20 text-white\" data-kid=\"1-4-3-2-1-4\" data-name=\"image caption overlay\">\n                        <span class=\"story-caption text-[10px] tracking-[0.16em]\" data-dynamic=\"true\" data-kid=\"1-4-3-2-1-4-1\" data-name=\"caption label\" data-reason=\"text updated based on current active story step\">\n                            01 / SOFT STRUCTURE\n                        </span>\n                        <span class=\"font-[var(--serif)] text-[12px] italic\" data-kid=\"1-4-3-2-1-4-2\" data-name=\"designed in lahore note\">\n                            Designed in Lahore\n                        </span>\n                    </div>\n                </div>\n                <div class=\"story-copy max-md:order-2\" data-kid=\"1-4-3-2-2\" data-name=\"story copy container\">\n                    <article class=\"story-step flex flex-col justify-center border-b border-[var(--line)] py-12 max-md:py-9\" data-chapter=\"01 / SOFT STRUCTURE\" data-dynamic=\"true\" data-kid=\"1-4-3-2-2-1\" data-name=\"story step 1\" data-reason=\"opacity and position updated by GSAP animation on scroll\">\n                        <p class=\"mb-5 text-[10px] tracking-[0.18em] text-[var(--accent)]\" data-kid=\"1-4-3-2-2-1-1\" data-name=\"step overline 1\">\n                            01\n                            <span class=\"px-2\" data-kid=\"1-4-3-2-2-1-1-1\" data-name=\"step separator 1\">\n                                /\n                            </span>\n                            THE FEEL\n                        </p>\n                        <h3 class=\"mb-5 max-w-[430px] font-[var(--serif)] text-[32px] leading-[1.3] tracking-[-0.03em] max-sm:text-[27px]\" data-kid=\"1-4-3-2-2-1-2\" data-name=\"step headline 1\">\n                            Softness with a little structure.\n                        </h3>\n                        <p class=\"max-w-[390px] text-[14px] leading-[1.9] text-[var(--muted)]\" data-kid=\"1-4-3-2-2-1-3\" data-name=\"step description 1\">\n                            A breathable rib-knit drapes close without feeling restrictive. The texture gives the silhouette its shape, so the rest can stay simple.\n                        </p>\n                        <span class=\"mt-8 h-px w-12 bg-[var(--accent)]\" data-kid=\"1-4-3-2-2-1-4\" data-name=\"step accent line 1\">\n                        </span>\n                    </article>\n                    <article class=\"story-step flex flex-col justify-center border-b border-[var(--line)] py-12 max-md:py-9\" data-chapter=\"02 / THOUGHTFUL FIT\" data-dynamic=\"true\" data-kid=\"1-4-3-2-2-2\" data-name=\"story step 2\" data-reason=\"opacity and position updated by GSAP animation on scroll\">\n                        <p class=\"mb-5 text-[10px] tracking-[0.18em] text-[var(--accent)]\" data-kid=\"1-4-3-2-2-2-1\" data-name=\"step overline 2\">\n                            02\n                            <span class=\"px-2\" data-kid=\"1-4-3-2-2-2-1-1\" data-name=\"step separator 2\">\n                                /\n                            </span>\n                            THE FIT\n                        </p>\n                        <h3 class=\"mb-5 max-w-[430px] font-[var(--serif)] text-[32px] leading-[1.3] tracking-[-0.03em] max-sm:text-[27px]\" data-kid=\"1-4-3-2-2-2-2\" data-name=\"step headline 2\">\n                            Room to move, and room to be.\n                        </h3>\n                        <p class=\"max-w-[390px] text-[14px] leading-[1.9] text-[var(--muted)]\" data-kid=\"1-4-3-2-2-2-3\" data-name=\"step description 2\">\n                            Easy proportions bring the two pieces together. Wear them as a set or let each one find its own place in your wardrobe.\n                        </p>\n                        <span class=\"mt-8 h-px w-12 bg-[var(--accent)]\" data-kid=\"1-4-3-2-2-2-4\" data-name=\"step accent line 2\">\n                        </span>\n                    </article>\n                    <article class=\"story-step flex flex-col justify-center py-12 max-md:py-9\" data-chapter=\"03 / QUIETLY VERSATILE\" data-dynamic=\"true\" data-kid=\"1-4-3-2-2-3\" data-name=\"story step 3\" data-reason=\"opacity and position updated by GSAP animation on scroll\">\n                        <p class=\"mb-5 text-[10px] tracking-[0.18em] text-[var(--accent)]\" data-kid=\"1-4-3-2-2-3-1\" data-name=\"step overline 3\">\n                            03\n                            <span class=\"px-2\" data-kid=\"1-4-3-2-2-3-1-1\" data-name=\"step separator 3\">\n                                /\n                            </span>\n                            THE WAY YOU WEAR IT\n                        </p>\n                        <h3 class=\"mb-5 max-w-[430px] font-[var(--serif)] text-[32px] leading-[1.3] tracking-[-0.03em] max-sm:text-[27px]\" data-kid=\"1-4-3-2-2-3-2\" data-name=\"step headline 3\">\n                            One set. More than one story.\n                        </h3>\n                        <p class=\"max-w-[390px] text-[14px] leading-[1.9] text-[var(--muted)]\" data-kid=\"1-4-3-2-2-3-3\" data-name=\"step description 3\">\n                            Keep it tonal for a quiet uniform, or pair the top and culottes with pieces already in your rotation. Nothing too precious to live in.\n                        </p>\n                        <a class=\"mt-8 inline-flex w-fit items-center gap-3 border-b border-[var(--ink)] pb-2 text-[11px] uppercase tracking-[0.12em]\" data-kid=\"1-4-3-2-2-3-4\" data-name=\"explore details link\" href=\"#details\">\n                            Explore the details\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-down-right text-[15px]\" data-kid=\"1-4-3-2-2-3-4-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"grid min-h-[600px] grid-cols-2 bg-[var(--ink)] text-[#f7f3ec] max-md:grid-cols-1\" data-kid=\"1-4-4\" data-name=\"editorial section\" id=\"details\">\n            <div class=\"editorial-image relative min-h-[520px] max-md:min-h-[440px]\" data-kid=\"1-4-4-1\" data-name=\"editorial image wrap\">\n                <img alt=\"Quiet fashion editorial in natural light\" class=\"detail-image\" data-dynamic=\"true\" data-kid=\"1-4-4-1-1\" data-name=\"detail image\" data-reason=\"animated y-offset by GSAP scroll trigger\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1400&q=85\"/>\n                <span class=\"absolute bottom-6 left-6 text-[10px] tracking-[0.17em] text-white\" data-kid=\"1-4-4-1-2\" data-name=\"editorial credit tag\">\n                    THE AUTUMN EDIT / 26\n                </span>\n            </div>\n            <div class=\"flex flex-col justify-center px-[9vw] py-20 max-md:px-8 max-md:py-16\" data-kid=\"1-4-4-2\" data-name=\"editorial content\">\n                <p class=\"mb-6 text-[10px] tracking-[0.2em] text-[#d2a38e]\" data-kid=\"1-4-4-2-1\" data-name=\"editorial overline\">\n                    CONSIDERED FROM THE FIRST THREAD\n                </p>\n                <h2 class=\"detail-title max-w-[520px] font-[var(--serif)] text-[clamp(34px,4vw,58px)] leading-[1.2] tracking-[-0.04em]\" data-kid=\"1-4-4-2-2\" data-name=\"editorial headline\">\n                    The beauty is in what you\n                    <span class=\"italic text-[#d7b9a8]\" data-kid=\"1-4-4-2-2-1\" data-name=\"italic headline accent\">\n                        don’t need to think about.\n                    </span>\n                </h2>\n                <p class=\"mt-7 max-w-[390px] text-[14px] leading-[1.9] text-[#c7c1b8]\" data-kid=\"1-4-4-2-3\" data-name=\"editorial description\">\n                    Easy care. A comfortable feel. A shape that works across the day. Quiet design gives you more ways to wear what you already love.\n                </p>\n                <div class=\"mt-10 grid max-w-[460px] grid-cols-2 gap-x-10 gap-y-7 border-t border-white/20 pt-7\" data-kid=\"1-4-4-2-4\" data-name=\"editorial specs grid\">\n                    <div data-kid=\"1-4-4-2-4-1\" data-name=\"spec 1 wrap\">\n                        <span class=\"block text-[9px] tracking-[0.15em] text-[#b8a99b]\" data-kid=\"1-4-4-2-4-1-1\" data-name=\"spec 1 label\">\n                            FABRIC\n                        </span>\n                        <strong class=\"mt-2 block font-[var(--serif)] text-[15px] font-normal\" data-kid=\"1-4-4-2-4-1-2\" data-name=\"spec 1 value\">\n                            Soft rib knit\n                        </strong>\n                    </div>\n                    <div data-kid=\"1-4-4-2-4-2\" data-name=\"spec 2 wrap\">\n                        <span class=\"block text-[9px] tracking-[0.15em] text-[#b8a99b]\" data-kid=\"1-4-4-2-4-2-1\" data-name=\"spec 2 label\">\n                            FEEL\n                        </span>\n                        <strong class=\"mt-2 block font-[var(--serif)] text-[15px] font-normal\" data-kid=\"1-4-4-2-4-2-2\" data-name=\"spec 2 value\">\n                            Breathable, easy\n                        </strong>\n                    </div>\n                    <div data-kid=\"1-4-4-2-4-3\" data-name=\"spec 3 wrap\">\n                        <span class=\"block text-[9px] tracking-[0.15em] text-[#b8a99b]\" data-kid=\"1-4-4-2-4-3-1\" data-name=\"spec 3 label\">\n                            MADE\n                        </span>\n                        <strong class=\"mt-2 block font-[var(--serif)] text-[15px] font-normal\" data-kid=\"1-4-4-2-4-3-2\" data-name=\"spec 3 value\">\n                            In-house in Lahore\n                        </strong>\n                    </div>\n                    <div data-kid=\"1-4-4-2-4-4\" data-name=\"spec 4 wrap\">\n                        <span class=\"block text-[9px] tracking-[0.15em] text-[#b8a99b]\" data-kid=\"1-4-4-2-4-4-1\" data-name=\"spec 4 label\">\n                            CARE\n                        </span>\n                        <strong class=\"mt-2 block font-[var(--serif)] text-[15px] font-normal\" data-kid=\"1-4-4-2-4-4-2\" data-name=\"spec 4 value\">\n                            Made for repeat wear\n                        </strong>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1240px] px-10 py-28 max-md:px-6 max-md:py-20 max-sm:px-4\" data-kid=\"1-4-5\" data-name=\"collection section\" id=\"collection\">\n            <div class=\"mb-12 flex items-end justify-between gap-8 max-sm:flex-col max-sm:items-start\" data-kid=\"1-4-5-1\" data-name=\"collection header\">\n                <div data-kid=\"1-4-5-1-1\" data-name=\"collection header text\">\n                    <p class=\"mb-4 text-[10px] font-semibold tracking-[0.2em] text-[var(--accent)]\" data-kid=\"1-4-5-1-1-1\" data-name=\"collection overline\">\n                        MORE TO LIVE IN\n                    </p>\n                    <h2 class=\"font-[var(--serif)] text-[clamp(30px,4vw,48px)] tracking-[-0.04em]\" data-kid=\"1-4-5-1-1-2\" data-name=\"collection headline\">\n                        The considered edit\n                    </h2>\n                </div>\n                <a class=\"border-b border-[var(--ink)] pb-2 text-[11px] uppercase tracking-[0.12em]\" data-kid=\"1-4-5-1-2\" data-name=\"view all link\" href=\"#product\">\n                    View all pieces\n                    <span class=\"ml-2\" data-kid=\"1-4-5-1-2-1\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n            <div class=\"grid grid-cols-3 gap-5 max-md:grid-cols-2 max-sm:grid-cols-1\" data-kid=\"1-4-5-2\" data-name=\"recommendation grid\">\n                <article class=\"recommend-card\" data-dynamic=\"true\" data-kid=\"1-4-5-2-1\" data-name=\"recommendation card 1\" data-reason=\"autoAlpha/y-offset animated by GSAP on scroll\">\n                    <div class=\"editorial-image relative aspect-[0.8] bg-[var(--cream)]\" data-kid=\"1-4-5-2-1-1\" data-name=\"recommendation image 1 wrap\">\n                        <img alt=\"Relaxed minimalist womenswear in natural light\" class=\"recommend-image\" data-dynamic=\"true\" data-kid=\"1-4-5-2-1-1-1\" data-name=\"recommendation image 1\" data-reason=\"animated y-offset by GSAP scroll trigger\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=850&q=85\"/>\n                        <span class=\"absolute left-4 top-4 bg-[var(--paper)] px-3 py-2 text-[9px] tracking-[0.12em]\" data-kid=\"1-4-5-2-1-1-2\" data-name=\"recommendation tag 1\">\n                            BESTSELLER\n                        </spa