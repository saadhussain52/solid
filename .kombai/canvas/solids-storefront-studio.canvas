    "var_de6772ee957b": {
      "type": "variant",
      "label": "02 · Shop-first · Home",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 13860,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n  .solids-home {\n    --ink: #292827;\n    --muted: #726d66;\n    --paper: #f8f7f3;\n    --cream: #efebe4;\n    --line: #d9d4cc;\n    --accent: #a96549;\n    color: var(--ink);\n    background: var(--paper);\n    font-family: 'DM Sans', sans-serif;\n    font-size: 15px;\n  }\n  .solids-home .serif { font-family: 'Libre Baskerville', Georgia, serif; }\n  .solids-home .home-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 82px; padding: 0 clamp(24px, 5.2vw, 76px); border-bottom: 1px solid var(--line); }\n  .solids-home .header-links, .solids-home .header-actions { display: flex; align-items: center; gap: clamp(14px, 2vw, 30px); }\n  .solids-home .header-actions { justify-content: flex-end; }\n  .solids-home .header-actions button { padding: 0; border: 0; background: none; color: inherit; font: inherit; cursor: pointer; }\n  .solids-home .header-logo { width: 164px; height: 56px; object-fit: contain; }\n  .solids-home .nav-link, .solids-home .action-link { font-size: 14px; text-decoration: none; white-space: nowrap; }\n  .solids-home .action-link { min-height: 44px; display: inline-flex; align-items: center; gap: 6px; }\n  .solids-home .header-links a, .solids-home .header-actions a { color: inherit; }\n  .solids-home .header-links a:hover, .solids-home .header-actions a:hover { color: var(--accent); }\n  .solids-home .delivery-note { min-height: 35px; padding: 8px 20px; text-align: center; background: #292827; color: #f7f3ec; font-size: 12px; letter-spacing: .02em; }\n  .solids-home .delivery-note span { color: #d7a38a; padding: 0 8px; }\n  .solids-home .hero-split { display: grid; grid-template-columns: 1.12fr .88fr; min-height: 590px; }\n  .solids-home .campaign-image { position: relative; min-height: 590px; overflow: hidden; background: #d7d0c8; }\n  .solids-home .campaign-image img { display: block; width: 100%; height: 100%; min-height: 590px; object-fit: cover; object-position: center 38%; }\n  .solids-home .campaign-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(24, 22, 20, .52) 0%, rgba(24, 22, 20, .08) 44%, rgba(24, 22, 20, 0) 76%); }\n  .solids-home .campaign-copy { position: absolute; left: clamp(24px, 4vw, 58px); right: 28px; bottom: 40px; color: #fff; }\n  .solids-home .campaign-copy h1 { max-width: 610px; margin: 0 0 12px; font-size: clamp(44px, 5.2vw, 74px); font-weight: 400; line-height: 1.05; letter-spacing: -.055em; }\n  .solids-home .campaign-copy p { max-width: 370px; margin: 0; color: rgba(255,255,255,.92); font-size: 15px; line-height: 1.6; }\n  .solids-home .category-index { display: flex; flex-direction: column; justify-content: center; padding: 58px clamp(30px, 5.1vw, 74px); background: var(--cream); }\n  .solids-home .category-index h2 { margin: 0 0 8px; font-size: clamp(28px, 3vw, 38px); font-weight: 400; line-height: 1.18; letter-spacing: -.04em; }\n  .solids-home .category-index > p { margin: 0 0 26px; color: var(--muted); font-size: 14px; line-height: 1.55; }\n  .solids-home .shop-list { border-top: 1px solid #d4cec4; }\n  .solids-home .shop-list a { min-height: 51px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px solid #d4cec4; color: var(--ink); font-size: 16px; text-decoration: none; }\n  .solids-home .shop-list a span:last-child { color: var(--accent); font-size: 19px; transition: transform .2s; }\n  .solids-home .shop-list a:hover span:last-child { transform: translateX(4px); }\n  .solids-home .section-shell { padding: 92px clamp(24px, 6vw, 88px) 100px; }\n  .solids-home .section-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }\n  .solids-home .section-head h2 { margin: 0; font-size: clamp(34px, 3.7vw, 48px); font-weight: 400; line-height: 1.15; letter-spacing: -.045em; }\n  .solids-home .section-head p { max-width: 390px; margin: 10px 0 0; color: var(--muted); font-size: 14px; line-height: 1.6; }\n  .solids-home .view-all { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; border-bottom: 1px solid var(--ink); color: var(--ink); font-size: 14px; text-decoration: none; white-space: nowrap; }\n  .solids-home .product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }\n  .solids-home .product-card { min-width: 0; }\n  .solids-home .product-photo { position: relative; overflow: hidden; background: #e4dfd7; aspect-ratio: 4 / 5; }\n  .solids-home .product-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }\n  .solids-home .product-photo .product-new { position: absolute; left: 12px; top: 12px; padding: 6px 9px; background: var(--paper); color: var(--ink); font-size: 12px; }\n  .solids-home .product-meta { display: flex; align-items: start; justify-content: space-between; gap: 10px; padding: 14px 1px 0; }\n  .solids-home .product-meta h3 { margin: 0 0 5px; font-size: 15px; font-weight: 500; line-height: 1.4; }\n  .solids-home .product-meta p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.45; }\n  .solids-home .product-price { flex: 0 0 auto; font-size: 14px; white-space: nowrap; }\n  .solids-home .product-visit { display: inline-flex; align-items: center; gap: 8px; min-height: 42px; margin-top: 6px; color: var(--ink); font-size: 13px; text-decoration: none; }\n  .solids-home .product-visit span { color: var(--accent); }\n  .solids-home .brand-story { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: clamp(42px, 8vw, 120px); padding: 72px clamp(24px, 12vw, 172px); background: #e4dfd6; }\n  .solids-home .brand-story h2 { max-width: 530px; margin: 0; font-size: clamp(34px, 4vw, 52px); font-weight: 400; line-height: 1.18; letter-spacing: -.045em; }\n  .solids-home .brand-story-copy p { max-width: 440px; margin: 0 0 20px; color: #514c46; font-size: 16px; line-height: 1.75; }\n  .solids-home .brand-story-copy a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--ink); font-size: 14px; text-decoration: none; border-bottom: 1px solid #857e73; }\n  .solids-home .site-footer { padding: 62px clamp(24px, 6vw, 88px) 22px; color: #f7f3ec; background: #292827; }\n  .solids-home .footer-main { display: grid; grid-template-columns: .85fr 1.15fr; gap: 48px; padding-bottom: 52px; }\n  .solids-home .footer-logo { width: 165px; height: 56px; object-fit: contain; filter: brightness(0) invert(1); }\n  .solids-home .footer-tagline { margin: 5px 0 0; color: #c1bbb2; font-size: 14px; }\n  .solids-home .footer-content { display: grid; grid-template-columns: .8fr .8fr 1.4fr; gap: 30px; }\n  .solids-home .footer-content h3 { margin: 0 0 14px; color: #e8d9cc; font-size: 13px; font-weight: 600; }\n  .solids-home .footer-content a { display: block; width: fit-content; margin: 11px 0; color: #f1ede6; font-size: 14px; text-decoration: none; }\n  .solids-home .footer-content p { max-width: 290px; margin: 0; color: #c1bbb2; font-size: 14px; line-height: 1.6; }\n  .solids-home .newsletter-form { display: flex; max-width: 325px; margin-top: 17px; border-bottom: 1px solid #77716a; }\n  .solids-home .newsletter-form input { min-width: 0; flex: 1; min-height: 46px; border: 0; outline: 0; background: transparent; color: #fff; font: inherit; font-size: 14px; }\n  .solids-home .newsletter-form input::placeholder { color: #c1bbb2; opacity: 1; }\n  .solids-home .newsletter-form button { min-width: 72px; min-height: 44px; padding: 0 8px; border: 0; background: transparent; color: #fff; font: inherit; font-size: 14px; cursor: pointer; }\n  .solids-home .footer-bottom { display: flex; justify-content: space-between; gap: 16px; padding-top: 19px; border-top: 1px solid #4d4a45; color: #c1bbb2; font-size: 13px; }\n  .solids-home a:focus-visible, .solids-home button:focus-visible, .solids-home input:focus-visible { outline: 2px solid #bd8367; outline-offset: 3px; }\n  @media (max-width: 850px) {\n    .solids-home .home-header { padding-inline: 22px; }\n    .solids-home .hero-split { grid-template-columns: 1fr .95fr; min-height: 520px; }\n    .solids-home .campaign-image, .solids-home .campaign-image img { min-height: 520px; }\n    .solids-home .category-index { padding: 38px 28px; }\n    .solids-home .category-index > p { margin-bottom: 16px; }\n    .solids-home .shop-list a { min-height: 46px; font-size: 15px; }\n    .solids-home .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 16px; }\n    .solids-home .section-shell { padding-block: 70px 76px; }\n    .solids-home .brand-story { padding-inline: 8vw; }\n    .solids-home .footer-main { grid-template-columns: 1fr; gap: 34px; }\n  }\n  @media (max-width: 600px) {\n    .solids-home .home-header { grid-template-columns: 1fr auto 1fr; min-height: 70px; padding-inline: 14px; gap: 8px; }\n    .solids-home .header-links { gap: 0; }\n    .solids-home .header-links .home-link, .solids-home .header-links .story-link { display: none; }\n    .solids-home .header-links .shop-link { display: inline-flex; min-height: 44px; align-items: center; font-size: 13px; }\n    .solids-home .header-logo { width: 128px; height: 48px; }\n    .solids-home .header-actions { gap: 8px; }\n    .solids-home .action-link { min-height: 44px; padding: 0 5px; font-size: 13px; }\n    .solids-home .delivery-note { min-height: 32px; padding: 7px 10px; font-size: 11px; }\n    .solids-home .delivery-note span { padding-inline: 4px; }\n    .solids-home .hero-split { grid-template-columns: .82fr 1.18fr; min-height: 498px; }\n    .solids-home .campaign-image, .solids-home .campaign-image img { min-height: 498px; }\n    .solids-home .campaign-image img { object-position: 54% center; }\n    .solids-home .campaign-shade { background: linear-gradient(0deg, rgba(24,22,20,.62), rgba(24,22,20,.06) 70%); }\n    .solids-home .campaign-copy { left: 16px; right: 10px; bottom: 22px; }\n    .solids-home .campaign-copy h1 { margin-bottom: 8px; font-size: clamp(27px, 8vw, 34px); line-height: 1.12; letter-spacing: -.045em; }\n    .solids-home .campaign-copy p { font-size: 12px; line-height: 1.45; }\n    .solids-home .category-index { padding: 24px 17px; }\n    .solids-home .category-index h2 { margin-bottom: 7px; font-size: 24px; }\n    .solids-home .category-index > p { margin-bottom: 13px; font-size: 12px; line-height: 1.45; }\n    .solids-home .shop-list a { min-height: 43px; gap: 5px; font-size: 13px; }\n    .solids-home .shop-list a span:last-child { font-size: 17px; }\n    .solids-home .section-shell { padding: 54px 17px 62px; }\n    .solids-home .section-head { align-items: end; margin-bottom: 22px; }\n    .solids-home .section-head h2 { font-size: 32px; }\n    .solids-home .section-head p { max-width: 230px; margin-top: 7px; font-size: 13px; }\n    .solids-home .view-all { min-height: 42px; gap: 6px; font-size: 13px; }\n    .solids-home .product-grid { gap: 22px 11px; }\n    .solids-home .product-photo .product-new { left: 8px; top: 8px; padding: 5px 7px; font-size: 11px; }\n    .solids-home .product-meta { display: block; padding-top: 10px; }\n    .solids-home .product-meta h3 { margin-bottom: 3px; font-size: 14px; }\n    .solids-home .product-meta p { font-size: 12px; }\n    .solids-home .product-price { display: block; margin-top: 5px; font-size: 13px; }\n    .solids-home .product-visit { min-height: 40px; margin-top: 1px; font-size: 13px; }\n    .solids-home .brand-story { grid-template-columns: 1fr; gap: 17px; padding: 45px 22px 48px; }\n    .solids-home .brand-story h2 { max-width: 360px; font-size: 34px; }\n    .solids-home .brand-story-copy p { font-size: 15px; line-height: 1.65; }\n    .solids-home .site-footer { padding: 43px 22px 18px; }\n    .solids-home .footer-main { gap: 28px; padding-bottom: 34px; }\n    .solids-home .footer-content { grid-template-columns: 1fr 1fr; gap: 20px 14px; }\n    .solids-home .footer-content .newsletter { grid-column: 1 / -1; }\n    .solids-home .footer-bottom { flex-direction: column; gap: 6px; font-size: 12px; }\n  }\n  @media (max-width: 390px) {\n    .solids-home .home-header { padding-inline: 10px; }\n    .solids-home .header-logo { width: 116px; }\n    .solids-home .header-actions { gap: 2px; }\n    .solids-home .action-link { padding-inline: 3px; font-size: 12px; }\n    .solids-home .hero-split { grid-template-columns: .78fr 1.22fr; }\n    .solids-home .campaign-copy h1 { font-size: 27px; }\n    .solids-home .campaign-copy p { font-size: 11px; }\n    .solids-home .category-index { padding-inline: 13px; }\n  }\n</style>\n<div class=\"solids-home min-h-screen w-full overflow-x-clip\" data-kid=\"1\">\n    <div class=\"delivery-note\" data-kid=\"1-1\">\n        Complimentary delivery on orders above Rs. 10,000\n        <span data-kid=\"1-1-1\">\n            ·\n        </span>\n        4–7 working days\n    </div>\n    <header class=\"home-header\" data-kid=\"1-2\">\n        <nav aria-label=\"Main navigation\" class=\"header-links\" data-kid=\"1-2-1\">\n            <a class=\"nav-link home-link\" data-kid=\"1-2-1-1\" href=\"index.html\">\n                Home\n            </a>\n            <a class=\"nav-link shop-link\" data-kid=\"1-2-1-2\" href=\"all.html\">\n                Shop\n            </a>\n            <a class=\"nav-link story-link\" data-kid=\"1-2-1-3\" href=\"#brand-story\">\n                Brand story\n            </a>\n        </nav>\n        <a aria-label=\"Solids home\" class=\"justify-self-center\" data-kid=\"1-2-2\" href=\"index.html\">\n            <img alt=\"Solids — No prints, just style\" class=\"header-logo\" data-kid=\"1-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n        </a>\n        <div class=\"header-actions\" data-kid=\"1-2-3\">\n            <button aria-label=\"Open search\" class=\"action-link\" data-kid=\"1-2-3-1\" type=\"button\">\n                Search\n            </button>\n            <button aria-label=\"Open bag\" class=\"action-link\" data-kid=\"1-2-3-2\" type=\"button\">\n                Bag\n                <span class=\"text-[var(--accent)]\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1\" data-name=\"bag item count\" data-reason=\"count updated by shop cart script\">\n                    0\n                </span>\n            </button>\n        </div>\n    </header>\n    <main data-kid=\"1-3\">\n        <section aria-label=\"Solids campaign and shop categories\" class=\"hero-split\" data-kid=\"1-3-1\">\n            <div class=\"campaign-image\" data-kid=\"1-3-1-1\">\n                <img alt=\"Editorial fashion portrait in a solid-colour outfit against a clean architectural background, photographed by Emmanuel Black on Unsplash\" data-kid=\"1-3-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1724416965302-4c176fa51019?auto=format&w=1400&q=80&fit=crop\"/>\n                <div class=\"campaign-shade\" data-kid=\"1-3-1-1-2\">\n                </div>\n                <div class=\"campaign-copy\" data-kid=\"1-3-1-1-3\">\n                    <h1 class=\"serif\" data-kid=\"1-3-1-1-3-1\">\n                        Less, but better.\n                    </h1>\n                    <p data-kid=\"1-3-1-1-3-2\">\n                        Quiet silhouettes, tactile layers, and a palette that lets you be the statement.\n                    </p>\n                </div>\n            </div>\n            <nav aria-label=\"Shop by category\" class=\"category-index\" data-kid=\"1-3-1-2\">\n                <h2 class=\"serif\" data-kid=\"1-3-1-2-1\">\n                    Shop by category\n                </h2>\n                <p data-kid=\"1-3-1-2-2\">\n                    Considered pieces for considered days.\n                </p>\n                <div class=\"shop-list\" data-kid=\"1-3-1-2-3\">\n                    <a data-kid=\"1-3-1-2-3-1\" href=\"all.html\">\n                        <span data-kid=\"1-3-1-2-3-1-1\">\n                            New Arrivals\n                        </span>\n                        <span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-1-2\">\n                            ↗\n                        </span>\n                    </a>\n                    <a data-kid=\"1-3-1-2-3-2\" href=\"all.html\">\n                        <span data-kid=\"1-3-1-2-3-2-1\">\n                            Co-ord Sets\n                        </span>\n                        <span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-2-2\">\n                            ↗\n                        </span>\n                    </a>\n                    <a data-kid=\"1-3-1-2-3-3\" href=\"all.html\">\n                        <span data-kid=\"1-3-1-2-3-3-1\">\n                            Dresses\n                        </span>\n                        <span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-3-2\">\n                            ↗\n                        </span>\n                    </a>\n                    <a data-kid=\"1-3-1-2-3-4\" href=\"all.html\">\n                        <span data-kid=\"1-3-1-2-3-4-1\">\n                            Tops\n                        </span>\n                        <span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-4-2\">\n                            ↗\n                        </span>\n                    </a>\n                    <a data-kid=\"1-3-1-2-3-5\" href=\"all.html\">\n                        <span data-kid=\"1-3-1-2-3-5-1\">\n                            Bottoms\n                        </span>\n                        <span aria-hidden=\"true\" data-kid=\"1-3-1-2-3-5-2\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n            </nav>\n        </section>\n        <section class=\"section-shell\" data-kid=\"1-3-2\" id=\"new-arrivals\">\n            <div class=\"section-head\" data-kid=\"1-3-2-1\">\n                <div data-kid=\"1-3-2-1-1\">\n                    <h2 class=\"serif\" data-kid=\"1-3-2-1-1-1\">\n                        New arrivals\n                    </h2>\n                    <p data-kid=\"1-3-2-1-1-2\">\n                        Fresh pieces in considered shapes and soft, easy layers.\n                    </p>\n                </div>\n                <a class=\"view-all\" data-kid=\"1-3-2-1-2\" href=\"all.html\">\n                    Shop all\n                    <span aria-hidden=\"true\" data-kid=\"1-3-2-1-2-1\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n            <div class=\"product-grid\" data-kid=\"1-3-2-2\">\n                <article class=\"product-card\" data-kid=\"1-3-2-2-1\">\n                    <a aria-label=\"View Soft Rib Co-ord\" class=\"product-photo block\" data-kid=\"1-3-2-2-1-1\" href=\"product.html?product=0\">\n                        <img alt=\"Soft Rib Co-ord in a neutral solid colour\" data-kid=\"1-3-2-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=780&q=80\"/>\n                        <span class=\"product-new\" data-kid=\"1-3-2-2-1-1-2\">\n                            New\n                        </span>\n                    </a>\n                    <div class=\"product-meta\" data-kid=\"1-3-2-2-1-2\">\n                        <div data-kid=\"1-3-2-2-1-2-1\">\n                            <h3 data-kid=\"1-3-2-2-1-2-1-1\">\n                                Soft Rib Co-ord\n                            </h3>\n                            <p data-kid=\"1-3-2-2-1-2-1-2\">\n                                Co-ord Sets\n                            </p>\n                        </div>\n                        <span class=\"product-price\" data-kid=\"1-3-2-2-1-2-2\">\n                            Rs. 12,800\n                        </span>\n                    </div>\n                    <a class=\"product-visit\" data-kid=\"1-3-2-2-1-3\" href=\"product.html?product=0\">\n                        View product\n                        <span aria-hidden=\"true\" data-kid=\"1-3-2-2-1-3-1\">\n                            →\n                        </span>\n                    </a>\n                </article>\n                <article class=\"product-card\" data-kid=\"1-3-2-2-2\">\n                    <a aria-label=\"View Sculpt Knit Co-ord\" class=\"product-photo block\" data-kid=\"1-3-2-2-2-1\" href=\"product.html?product=1\">\n                        <img alt=\"Sculpt Knit Co-ord in a simple solid silhouette\" data-kid=\"1-3-2-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=780&q=80\"/>\n                        <span class=\"product-new\" data-kid=\"1-3-2-2-2-1-2\">\n                            New\n                        </span>\n                    </a>\n                    <div class=\"product-meta\" data-kid=\"1-3-2-2-2-2\">\n                        <div data-kid=\"1-3-2-2-2-2-1\">\n                            <h3 data-kid=\"1-3-2-2-2-2-1-1\">\n                                Sculpt Knit Co-ord\n                            </h3>\n                            <p data-kid=\"1-3-2-2-2-2-1-2\">\n                                Co-ord Sets\n                            </p>\n                        </div>\n                        <span class=\"product-price\" data-kid=\"1-3-2-2-2-2-2\">\n                            Rs. 14,800\n                        </span>\n                    </div>\n                    <a class=\"product-visit\" data-kid=\"1-3-2-2-2-3\" href=\"product.html?product=1\">\n                        View product\n                        <span aria-hidden=\"true\" data-kid=\"1-3-2-2-2-3-1\">\n                            →\n                        </span>\n                    </a>\n                </article>\n                <article class=\"product-card\" data-kid=\"1-3-2-2-3\">\n                    <a aria-label=\"View Contour Slip Dress\" class=\"product-photo block\" data-kid=\"1-3-2-2-3-1\" href=\"product.html?product=4\">\n                        <img alt=\"Contour Slip Dress\" data-kid=\"1-3-2-2-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=780&q=80\"/>\n                        <span class=\"product-new\" data-kid=\"1-3-2-2-3-1-2\">\n                            New\n                        </span>\n                    </a>\n                    <div class=\"product-meta\" data-kid=\"1-3-2-2-3-2\">\n                        <div data-kid=\"1-3-2-2-3-2-1\">\n                            <h3 data-kid=\"1-3-2-2-3-2-1-1\">\n                                Contour Slip Dress\n                            </h3>\n                            <p data-kid=\"1-3-2-2-3-2-1-2\">\n                                Dresses\n                            </p>\n                        </div>\n                        <span class=\"product-price\" data-kid=\"1-3-2-2-3-2-2\">\n                            Rs. 9,500\n                        </span>\n                    </div>\n                    <a class=\"product-visit\" data-kid=\"1-3-2-2-3-3\" href=\"product.html?product=4\">\n                        View product\n                        <span aria-hidden=\"true\" data-kid=\"1-3-2-2-3-3-1\">\n                            →\n                        </span>\n                    </a>\n                </article>\n                <article class=\"product-card\" data-kid=\"1-3-2-2-4\">\n                    <a aria-label=\"View Everyday Linen Co-ord\" class=\"product-photo block\" data-kid=\"1-3-2-2-4-1\" href=\"product.html?product=12\">\n                        <img alt=\"Everyday Linen Co-ord\" data-kid=\"1-3-2-2-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=780&q=80\"/>\n                        <span class=\"product-new\" data-kid=\"1-3-2-2-4-1-2\">\n                            New\n                        </span>\n                    </a>\n                    <div class=\"product-meta\" data-kid=\"1-3-2-2-4-2\">\n                        <div data-kid=\"1-3-2-2-4-2-1\">\n                            <h3 data-kid=\"1-3-2-2-4-2-1-1\">\n                                Everyday Linen Co-ord\n                            </h3>\n                            <p data-kid=\"1-3-2-2-4-2-1-2\">\n                                Co-ord Sets\n                            </p>\n                        </div>\n                        <span class=\"product-price\" data-kid=\"1-3-2-2-4-2-2\">\n                            Rs. 13,200\n                        </span>\n                    </div>\n                    <a class=\"product-visit\" data-kid=\"1-3-2-2-4-3\" href=\"product.html?product=12\">\n                        View product\n                        <span aria-hidden=\"true\" data-kid=\"1-3-2-2-4-3-1\">\n                            →\n                        </span>\n                    </a>\n                </article>\n            </div>\n        </section>\n        <section class=\"brand-story\" data-kid=\"1-3-3\" id=\"brand-story\">\n            <h2 class=\"serif\" data-kid=\"1-3-3-1\">\n                Clothes that give you room to live.\n            </h2>\n            <div class=\"brand-story-copy\" data-kid=\"1-3-3-2\">\n                <p data-kid=\"1-3-3-2-1\">\n                    We believe in fewer, better things. Honest fabrics, thoughtful cuts, and a slower approach to getting dressed.\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"site-footer\" data-kid=\"1-4\">\n        <div class=\"footer-main\" data-kid=\"1-4-1\">\n            <div data-kid=\"1-4-1-1\">\n                <a aria-label=\"Solids home\" data-kid=\"1-4-1-1-1\" href=\"index.html\">\n                    <img alt=\"Solids — No prints, just style\" class=\"footer-logo\" data-kid=\"1-4-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n                </a>\n                <p class=\"footer-tagline\" data-kid=\"1-4-1-1-2\">\n                    Everyday, refined.\n                </p>\n            </div>\n            <div class=\"footer-content\" data-kid=\"1-4-1-2\">\n                <div data-kid=\"1-4-1-2-1\">\n                    <h3 data-kid=\"1-4-1-2-1-1\">\n                        Shop\n                    </h3>\n                    <a data-kid=\"1-4-1-2-1-2\" href=\"all.html\">\n                        All products\n                    </a>\n                    <a data-kid=\"1-4-1-2-1-3\" href=\"#new-arrivals\">\n                        New arrivals\n                    </a>\n                    <a data-kid=\"1-4-1-2-1-4\" href=\"#brand-story\">\n                        Our story\n                    </a>\n                </div>\n                <div data-kid=\"1-4-1-2-2\">\n                    <h3 data-kid=\"1-4-1-2-2-1\">\n                        Help\n                    </h3>\n                    <a data-kid=\"1-4-1-2-2-2\" href=\"mailto:solids@studio.pk?subject=Shipping%20and%20returns\">\n                        Shipping & returns\n                    </a>\n                    <a data-kid=\"1-4-1-2-2-3\" href=\"mailto:solids@studio.pk\">\n                        Contact the studio\n                    </a>\n                </div>\n                <div class=\"newsletter\" data-kid=\"1-4-1-2-3\" id=\"search\">\n                    <h3 data-kid=\"1-4-1-2-3-1\">\n                        The mailing list\n                    </h3>\n                    <p data-kid=\"1-4-1-2-3-2\">\n                        First look at new drops and quiet notes from the studio.\n                    </p>\n                    <form class=\"newsletter-form\" data-kid=\"1-4-1-2-3-3\">\n                        <input aria-label=\"Your email address\" data-kid=\"1-4-1-2-3-3-1\" placeholder=\"Your email address\" type=\"email\"/>\n                        <button data-kid=\"1-4-1-2-3-3-2\" type=\"button\">\n                            Sign up\n                        </button>\n                    </form>\n                </div>\n            </div>\n        </div>\n        <div class=\"footer-bottom\" data-kid=\"1-4-2\">\n            <span data-kid=\"1-4-2-1\">\n                © 2026 Solids Official\n            </span>\n            <span data-kid=\"1-4-2-2\">\n                Pakistan / PKR\n            </span>\n        </div>\n    </footer>\n</div>\n",
