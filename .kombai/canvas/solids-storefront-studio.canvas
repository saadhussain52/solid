      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.studio-shell{--ink:#292827;--muted:#716d67;--line:#e3dfd8;--paper:#f7f6f2;--white:#fffefa;--cream:#efebe4;--accent:#b87558;--green:#52745f;min-height:100vh;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:14px;display:flex;}\n.studio-shell *{box-sizing:border-box}\n.studio-sidebar{background:#2b2a27;color:#f8f6f0;width:248px;flex:0 0 248px;min-height:100vh;padding:29px 17px 20px;display:flex;flex-direction:column;}\n.studio-brand{height:78px;display:flex;align-items:flex-start;padding:0 8px;border-bottom:1px solid rgba(255,255,255,.1);margin-bottom:28px;}\n.studio-brand img{width:164px;height:56px;object-fit:contain;filter:brightness(0) invert(1);}\n.studio-nav-label{font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:#a49f95;padding:0 11px;margin:0 0 12px;font-weight:600;}\n.studio-nav{display:grid;gap:4px;}\n.studio-nav a,.studio-store-link{min-height:46px;text-decoration:none;display:flex;align-items:center;gap:12px;padding:0 12px;border-radius:4px;color:#d1cdc5;font-size:14px;font-weight:500;}\n.studio-nav a i,.studio-store-link i{font-size:18px;width:20px;text-align:center;color:#b8b1a7;}\n.studio-nav a.selected{background:#403d37;color:#fffefa;box-shadow:inset 2px 0 #c98a6b;}\n.studio-nav a.selected i{color:#e0ae93;}\n.studio-nav a:hover,.studio-store-link:hover{background:rgba(255,255,255,.07);color:#fff;}\n.studio-side-bottom{margin-top:auto;padding-top:18px;border-top:1px solid rgba(255,255,255,.12);}\n.studio-store-link{min-height:44px;color:#c8c2b8;font-size:13px;}\n.studio-main{flex:1;min-width:0;padding:0 52px 60px;max-width:1600px;margin:0 auto;}\n.studio-topbar{height:84px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);}\n.studio-topbar-label{color:var(--muted);font-size:13px;letter-spacing:.02em;}\n.studio-admin{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:600;color:var(--ink);}\n.studio-admin-mark{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;border:1px solid #d7cfc5;color:#7d5544;background:#f2e9e0;font-size:12px;font-weight:700;}\n.studio-content{max-width:1260px;margin:0 auto;}\n.studio-page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;padding:38px 0 27px;}\n.studio-page-heading h1{font:400 34px/1.16 'Libre Baskerville',serif;margin:0;letter-spacing:-.045em;}\n.studio-page-heading p{color:var(--muted);margin:8px 0 0;font-size:14px;line-height:1.55;}\n.studio-range{font-size:13px;color:var(--muted);padding:9px 12px;border:1px solid var(--line);background:var(--white);border-radius:3px;white-space:nowrap;}\n.studio-work-grid{display:grid;grid-template-columns:minmax(0,1.14fr) minmax(0,.86fr);gap:25px;align-items:start;}\n.studio-work-section{background:var(--white);border:1px solid var(--line);border-radius:4px;min-width:0;}\n.studio-work-section header{padding:20px 20px 17px;display:flex;align-items:baseline;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);}\n.studio-work-section h2{font:400 19px/1.3 'Libre Baskerville',serif;margin:0;letter-spacing:-.025em;}\n.studio-count{color:var(--muted);font-size:13px;white-space:nowrap;}\n.studio-review-item{padding:17px 20px 19px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:14px;}\n.studio-order-ident{display:flex;align-items:center;gap:9px;margin-bottom:8px;color:var(--muted);font-size:13px;}\n.studio-order-ident strong{color:var(--ink);font-weight:600;}\n.studio-dot{height:7px;width:7px;border-radius:50%;background:#c68462;display:inline-block;flex:0 0 7px;}\n.studio-order-customer{font-size:15px;font-weight:600;line-height:1.45;}\n.studio-order-amount{font:400 15px 'Libre Baskerville',serif;color:var(--ink);margin-top:3px;}\n.studio-status{display:inline-flex;align-items:center;gap:6px;color:#8b5e43;background:#f6ebe3;border-radius:3px;padding:5px 8px;font-size:12px;font-weight:600;white-space:nowrap;margin-top:8px;}\n.studio-order-actions{display:flex;flex-direction:column;align-items:flex-end;gap:7px;}\n.studio-link-primary{display:inline-flex;min-height:42px;align-items:center;justify-content:center;gap:8px;border:1px solid #b87558;color:#8e573f;text-decoration:none;padding:0 12px;font-size:13px;font-weight:600;border-radius:3px;white-space:nowrap;}\n.studio-link-primary:hover{background:#f6eee8;}\n.studio-action-note{font-size:12px;color:var(--muted);}\n.studio-stock-list{padding:0 20px;}\n.studio-stock-row{min-height:76px;display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:12px;border-bottom:1px solid var(--line);}\n.studio-stock-row:last-child{border-bottom:0;}\n.studio-thumb{height:58px;width:46px;background:#eeeae4;object-fit:cover;}\n.studio-stock-name{font-size:14px;line-height:1.35;font-weight:600;}\n.studio-stock-category{font-size:12px;color:var(--muted);margin-top:4px;}\n.studio-stock-qty{text-align:right;color:#945d45;font-size:13px;font-weight:600;white-space:nowrap;}\n.studio-stock-qty span{display:block;color:var(--muted);font-size:11px;font-weight:500;margin-top:2px;}\n.studio-stock-footer{display:flex;justify-content:flex-end;padding:10px 20px 16px;}\n.studio-text-action{font-size:13px;font-weight:600;color:#8e573f;text-decoration:none;display:inline-flex;align-items:center;gap:7px;min-height:36px;}\n.studio-text-action:hover{text-decoration:underline;text-underline-offset:3px;}\n.studio-recent{margin-top:25px;background:var(--white);border:1px solid var(--line);border-radius:4px;}\n.studio-recent-head{padding:18px 20px 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);}\n.studio-recent h2{font:400 19px/1.3 'Libre Baskerville',serif;margin:0;}\n.studio-order-table{padding:0 20px;}\n.studio-order-row{min-height:56px;display:grid;grid-template-columns:minmax(148px,1.1fr) minmax(150px,1.3fr) minmax(96px,.75fr) minmax(104px,.7fr);align-items:center;gap:12px;border-bottom:1px solid var(--line);font-size:13px;}\n.studio-order-row:last-child{border-bottom:0;}\n.studio-order-id{font-weight:600;}\n.studio-order-name{color:#55514b;}\n.studio-order-price{font-weight:500;white-space:nowrap;}\n.studio-paid{display:inline-flex;align-items:center;gap:6px;color:var(--green);font-weight:600;white-space:nowrap;}\n.studio-paid::before{content:'';width:7px;height:7px;border-radius:50%;background:#6f9678;}\n.studio-pending{display:inline-flex;align-items:center;gap:6px;color:#8b5e43;font-weight:600;white-space:nowrap;}\n.studio-pending::before{content:'';width:7px;height:7px;border-radius:50%;background:#c68462;}\n.studio-snapshot{margin-top:25px;padding:17px 20px;display:flex;gap:36px;align-items:center;border-top:1px solid var(--line);border-bottom:1px solid var(--line);color:var(--muted);font-size:13px;}\n.studio-snapshot strong{font:400 18px 'Libre Baskerville',serif;color:var(--ink);margin-right:4px;}\n.studio-mobile-bar{display:none;}\n@media(max-width:1100px){.studio-sidebar{width:220px;flex-basis:220px;}.studio-main{padding:0 30px 48px;}.studio-work-grid{grid-template-columns:1fr;gap:18px;}.studio-page-heading{padding-top:30px;}.studio-range{display:none;}}\n@media(max-width:720px){.studio-shell{display:block;padding-bottom:72px;}.studio-sidebar{display:none;}.studio-main{padding:0 18px 32px;}.studio-topbar{height:58px;}.studio-topbar-label{font-size:12px;}.studio-admin{font-size:12px;gap:8px;}.studio-admin-mark{width:31px;height:31px;}.studio-page-heading{padding:25px 0 20px;display:block;}.studio-page-heading h1{font-size:29px;}.studio-page-heading p{font-size:13px;max-width:38ch;}.studio-work-grid{gap:15px;}.studio-work-section header{padding:16px 15px 13px;}.studio-work-section h2,.studio-recent h2{font-size:17px;}.studio-count{font-size:12px;}.studio-review-item{padding:15px;grid-template-columns:1fr;gap:13px;}.studio-order-ident{font-size:12px;}.studio-order-customer{font-size:14px;}.studio-order-amount{font-size:14px;}.studio-order-actions{align-items:stretch;}.studio-link-primary{width:100%;min-height:44px;}.studio-action-note{text-align:center;}.studio-stock-list{padding:0 15px;}.studio-stock-row{grid-template-columns:43px minmax(0,1fr) auto;gap:10px;min-height:72px;}.studio-thumb{width:42px;height:53px;}.studio-stock-name{font-size:13px;}.studio-stock-category{font-size:11px;}.studio-stock-qty{font-size:12px;}.studio-stock-footer{padding:7px 15px 12px;}.studio-recent{margin-top:15px;}.studio-recent-head{padding:15px;}.studio-order-table{padding:0 15px;}.studio-order-row{grid-template-columns:minmax(100px,1fr) minmax(0,1.2fr);gap:6px 10px;padding:12px 0;min-height:unset;font-size:12px;}.studio-order-id{grid-column:1;}.studio-order-name{grid-column:2;grid-row:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.studio-order-price{grid-column:1;grid-row:2;}.studio-order-row .studio-status{grid-column:2;grid-row:2;justify-self:start;margin:0;}.studio-order-row .studio-paid,.studio-order-row .studio-pending{grid-column:2;grid-row:2;font-size:12px;}.studio-snapshot{padding:15px 2px;gap:22px;font-size:12px;}.studio-snapshot strong{font-size:16px;}.studio-mobile-bar{position:fixed;z-index:5;bottom:0;left:0;right:0;height:64px;padding:4px 6px calc(4px + env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(5,1fr);background:#2b2a27;border-top:1px solid rgba(255,255,255,.12);}\n.studio-mobile-bar a{color:#d1cdc5;text-decoration:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:10px;font-weight:500;line-height:1.15;text-align:center;}\n.studio-mobile-bar a i{font-size:17px;color:#b8b1a7;}.studio-mobile-bar a.selected{color:#fffefa;}.studio-mobile-bar a.selected i{color:#e0ae93;}}\n</style>\n<div class=\"studio-shell\" data-kid=\"1\" data-name=\"studio layout wrapper\">\n    <aside class=\"studio-sidebar\" data-kid=\"1-1\" data-name=\"sidebar navigation\">\n        <a aria-label=\"Solids Studio overview\" class=\"studio-brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n            <img alt=\"Solids\" data-kid=\"1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n        </a>\n        <p class=\"studio-nav-label\" data-kid=\"1-1-2\" data-name=\"sidebar navigation label\">\n            Store management\n        </p>\n        <nav aria-label=\"Store management\" class=\"studio-nav\" data-kid=\"1-1-3\" data-name=\"sidebar navigation menu\">\n            <a class=\"selected\" data-kid=\"1-1-3-1\" data-name=\"overview link\" href=\"#overview\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-3-1-1\" data-name=\"dashboard icon\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"overview link text\">\n                    Overview\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-2\" data-name=\"products link\" href=\"#products\">\n                <i aria-hidden=\"true\" class=\"ti ti-hanger\" data-kid=\"1-1-3-2-1\" data-name=\"hanger icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"products link text\">\n                    Products & inventory\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-3\" data-name=\"orders link\" href=\"#orders\">\n                <i aria-hidden=\"true\" class=\"ti ti-receipt\" data-kid=\"1-1-3-3-1\" data-name=\"receipt icon\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"orders link text\">\n                    Orders\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-4\" data-name=\"categories link\" href=\"#categories\">\n                <i aria-hidden=\"true\" class=\"ti ti-category\" data-kid=\"1-1-3-4-1\" data-name=\"category icon\">\n                </i>\n                <span data-kid=\"1-1-3-4-2\" data-name=\"categories link text\">\n                    Categories & banners\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-5\" data-name=\"customers link\" href=\"#customers\">\n                <i aria-hidden=\"true\" class=\"ti ti-users\" data-kid=\"1-1-3-5-1\" data-name=\"users icon\">\n                </i>\n                <span data-kid=\"1-1-3-5-2\" data-name=\"customers link text\">\n                    Customers\n                </span>\n            </a>\n        </nav>\n        <div class=\"studio-side-bottom\" data-kid=\"1-1-4\" data-name=\"sidebar bottom container\">\n            <a class=\"studio-store-link\" data-kid=\"1-1-4-1\" data-name=\"view storefront link\" href=\"#storefront\">\n                <i aria-hidden=\"true\" class=\"ti ti-external-link\" data-kid=\"1-1-4-1-1\" data-name=\"external link icon\">\n                </i>\n                <span data-kid=\"1-1-4-1-2\" data-name=\"view storefront link text\">\n                    View storefront\n                </span>\n            </a>\n        </div>\n    </aside>\n    <main class=\"studio-main\" data-kid=\"1-2\" data-name=\"main content area\" id=\"overview\">\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n        </script>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n        </script>\n        <script>\n            document.addEventListener('DOMContentLoaded', () => {\n            gsap.registerPlugin(ScrollTrigger);\n            gsap.utils.toArray('main h1, main h2').forEach((heading) => {\n              const label = heading.textContent.trim().replace(/\\\\s+/g, ' ');\n              heading.setAttribute('aria-label', label);\n              heading.textContent = '';\n              const words = label.split(' ').map((word) => {\n                const mask = document.createElement('span');\n                const revealWord = document.createElement('span');\n                mask.style.display = 'inline-block';\n                mask.style.overflow = 'hidden';\n                mask.style.verticalAlign = 'bottom';\n                mask.style.paddingBottom = '.12em';\n                mask.style.marginBottom = '-.12em';\n                revealWord.style.display = 'inline-block';\n                revealWord.textContent = word;\n                mask.appendChild(revealWord);\n                heading.appendChild(mask);\n                heading.appendChild(document.createTextNode(' '));\n                return revealWord;\n              });\n              gsap.fromTo(words, { yPercent: 112, autoAlpha: 0 }, {\n                yPercent: 0,\n                autoAlpha: 1,\n                duration: 0.58,\n                stagger: 0.075,\n                ease: 'power3.out',\n                scrollTrigger: { trigger: heading, start: 'top 91%', toggleActions: 'play none none reverse' }\n              });\n            });\n            const descriptions = gsap.utils.toArray('main p').filter((copy) => (copy.dataset.name || '').toLowerCase().includes('description'));\n            descriptions.forEach((copy) => {\n              gsap.fromTo(copy, { autoAlpha: 0, y: 15 }, {\n                autoAlpha: 1,\n                y: 0,\n                duration: 0.62,\n                ease: 'power2.out',\n                scrollTrigger: { trigger: copy, start: 'top 92%', toggleActions: 'play none none reverse' }\n              });\n            });\n            const cards = gsap.utils.toArray('.studio-review-item, .studio-stock-row, .studio-order-row');\n            gsap.set(cards, { autoAlpha: 0, y: 18 });\n            ScrollTrigger.batch(cards, {\n              start: 'top 90%',\n              interval: 0.08,\n              batchMax: 4,\n              onEnter: (items) => gsap.to(items, { autoAlpha: 1, y: 0, duration: 0.58, stagger: 0.075, ease: 'power2.out', overwrite: true }),\n              onEnterBack: (items) => gsap.to(items, { autoAlpha: 1, y: 0, duration: 0.48, stagger: 0.06, ease: 'power2.out', overwrite: true }),\n              onLeaveBack: (items) => gsap.set(items, { autoAlpha: 0, y: 18, overwrite: true })\n            });\n            window.addEventListener('load', () => ScrollTrigger.refresh());\n          });\n        </script>\n        <div class=\"studio-topbar\" data-kid=\"1-2-1\" data-name=\"top navigation bar\">\n            <span class=\"studio-topbar-label\" data-kid=\"1-2-1-1\" data-name=\"application name label\">\n                Solids Studio\n            </span>\n            <div class=\"studio-admin\" data-kid=\"1-2-1-2\" data-name=\"user account info\">\n                <span data-kid=\"1-2-1-2-1\" data-name=\"admin role label\">\n                    Store admin\n                </span>\n                <span aria-hidden=\"true\" class=\"studio-admin-mark\" data-kid=\"1-2-1-2-2\" data-name=\"admin initials mark\">\n                    SA\n                </span>\n            </div>\n        </div>\n        <div class=\"studio-content\" data-kid=\"1-2-2\" data-name=\"main content container\">\n            <header class=\"studio-page-heading\" data-kid=\"1-2-2-1\" data-name=\"page header section\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"header title group\">\n                    <h1 data-dynamic=\"true\" data-kid=\"1-2-2-1-1-1\" data-name=\"page title\" data-reason=\"text content replaced with GSAP-animated spans\">\n                        Overview\n                    </h1>\n                    <p data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2\" data-name=\"page description\" data-reason=\"opacity and position controlled by GSAP animation\">\n                        Orders that need a decision and products to restock.\n                    </p>\n                </div>\n                <span class=\"studio-range\" data-kid=\"1-2-2-1-2\" data-name=\"activity range label\">\n                    PKR · Store activity\n                </span>\n            </header>\n            <div class=\"studio-work-grid\" data-kid=\"1-2-2-2\" data-name=\"dashboard work grid\">\n                <section aria-labelledby=\"orders-review-title\" class=\"studio-work-section\" data-kid=\"1-2-2-2-1\" data-name=\"orders review section\">\n                    <header data-kid=\"1-2-2-2-1-1\" data-name=\"orders header\">\n                        <h2 data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"orders header title\" data-reason=\"text content replaced with GSAP-animated spans\" id=\"orders-review-title\">\n                            Orders needing review\n                        </h2>\n                        <span class=\"studio-count\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"orders count\">\n                            1 order\n                        </span>\n                    </header>\n                    <article class=\"studio-review-item\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2\" data-name=\"order review item\" data-reason=\"visibility controlled by ScrollTrigger animation\">\n                        <div data-kid=\"1-2-2-2-1-2-1\" data-name=\"order summary details\">\n                            <div class=\"studio-order-ident\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"order identifier container\">\n                                <span aria-hidden=\"true\" class=\"studio-dot\" data-kid=\"1-2-2-2-1-2-1-1-1\" data-name=\"order status dot\">\n                                </span>\n                                <strong data-kid=\"1-2-2-2-1-2-1-1-2\" data-name=\"order id\">\n                                    #SOL-1046\n                                </strong>\n                            </div>\n                            <div class=\"studio-order-customer\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"customer name\">\n                                Hina Ahmed\n                            </div>\n                            <div class=\"studio-order-amount\" data-kid=\"1-2-2-2-1-2-1-3\" data-name=\"order total amount\">\n                                Rs. 22,100\n                            </div>\n                            <span class=\"studio-status\" data-kid=\"1-2-2-2-1-2-1-4\" data-name=\"order status text\">\n                                Pending\n                            </span>\n                        </div>\n                        <div class=\"studio-order-actions\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"order action container\">\n                            <a class=\"studio-link-primary\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"open order link\" href=\"#order-sol-1046\">\n                                Open order #SOL-1046\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-2-2-2-1-2-2-1-1\" data-name=\"arrow icon\">\n                                </i>\n                            </a>\n                            <span class=\"studio-action-note\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"order action note\">\n                                Review order status\n                            </span>\n                        </div>\n                    </article>\n                </section>\n                <section aria-labelledby=\"stock-title\" class=\"studio-work-section\" data-kid=\"1-2-2-2-2\" data-name=\"low stock section\">\n                    <header data-kid=\"1-2-2-2-2-1\" data-name=\"stock header\">\n                        <h2 data-dynamic=\"true\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"stock header title\" data-reason=\"text content replaced with GSAP-animated spans\" id=\"stock-title\">\n                            Low-stock products\n                        </h2>\n                        <span class=\"studio-count\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"stock products count\">\n                            3 products\n                        </span>\n                    </header>\n                    <div class=\"studio-stock-list\" data-kid=\"1-2-2-2-2-2\" data-name=\"stock products list\">\n                        <article class=\"studio-stock-row\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"stock item row\" data-reason=\"visibility controlled by ScrollTrigger animation\">\n                            <img alt=\"Sculpt Knit Co-ord\" class=\"studio-thumb\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"product thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=160&q=80\"/>\n                            <div data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"product info container\">\n                                <div class=\"studio-stock-name\" data-kid=\"1-2-2-2-2-2-1-2-1\" data-name=\"product name\">\n                                    Sculpt Knit Co-ord\n                                </div>\n                                <div class=\"studio-stock-category\" data-kid=\"1-2-2-2-2-2-1-2-2\" data-name=\"product category\">\n                                    Co-ord Sets\n                                </div>\n                            </div>\n                            <div class=\"studio-stock-qty\" data-kid=\"1-2-2-2-2-2-1-3\" data-name=\"product stock quantity\">\n                                6\n                                <span data-kid=\"1-2-2-2-2-2-1-3-1\" data-name=\"stock status label\">\n                                    in stock\n                                </span>\n                            </div>\n                        </article>\n                        <article class=\"studio-stock-row\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"stock item row\" data-reason=\"visibility controlled by ScrollTrigger animation\">\n                            <img alt=\"Oatmeal Column Dress\" class=\"studio-thumb\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"product thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1539008835657-9e8e9680c956?auto=format&fit=crop&w=160&q=80\"/>\n                            <div data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"product info container\">\n                                <div class=\"studio-stock-name\" data-kid=\"1-2-2-2-2-2-2-2-1\" data-name=\"product name\">\n                                    Oatmeal Column Dress\n                                </div>\n                                <div class=\"studio-stock-category\" data-kid=\"1-2-2-2-2-2-2-2-2\" data-name=\"product category\">\n                                    Dresses\n                                </div>\n                            </div>\n                            <div class=\"studio-stock-qty\" data-kid=\"1-2-2-2-2-2-2-3\" data-name=\"product stock quantity\">\n                                6\n                                <span data-kid=\"1-2-2-2-2-2-2-3-1\" data-name=\"stock status label\">\n                                    in stock\n                                </span>\n                            </div>\n                        </article>\n                        <article class=\"studio-stock-row\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"stock item row\" data-reason=\"visibility controlled by ScrollTrigger animation\">\n                            <img alt=\"Fine Rib Tank\" class=\"studio-thumb\" data-kid=\"1-2-2-2-2-2-3-1\" data-name=\"product thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=160&q=80\"/>\n                            <div data-kid=\"1-2-2-2-2-2-3-2\" data-name=\"product info container\">\n                                <div class=\"studio-stock-name\" data-kid=\"1-2-2-2-2-2-3-2-1\" data-name=\"product name\">\n                                    Fine Rib Tank\n                                </div>\n                                <div class=\"studio-stock-category\" data-kid=\"1-2-2-2-2-2-3-2-2\" data-name=\"product category\">\n                                    Tops\n                                </div>\n                            </div>\n                            <div class=\"studio-stock-qty\" data-kid=\"1-2-2-2-2-2-3-3\" data-name=\"product stock quantity\">\n                                6\n                                <span data-kid=\"1-2-2-2-2-2-3-3-1\" data-name=\"stock status label\">\n                                    in stock\n                                </span>\n                            </div>\n                        </article>\n                    </div>\n                    <div class=\"studio-stock-footer\" data-kid=\"1-2-2-2-2-3\" data-name=\"stock footer container\">\n                        <a class=\"studio-text-action\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"review stock link\" href=\"#products\">\n                            Review product stock\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-2-2-2-2-3-1-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </section>\n            </div>\n            <section aria-labelledby=\"recent-orders-title\" class=\"studio-recent\" data-kid=\"1-2-2-3\" data-name=\"recent orders section\">\n                <header class=\"studio-recent-head\" data-kid=\"1-2-2-3-1\" data-name=\"recent orders header\">\n                    <h2 data-dynamic=\"true\" data-kid=\"1-2-2-3-1-1\" data-name=\"recent orders title\" data-reason=\"text content replaced with GSAP-animated spans\" id=\"recent-orders-title\">\n                        Recent orders\n                    </h2>\n                    <span class=\"studio-count\" data-kid=\"1-2-2-3-1-2\" data-name=\"recent orders count\">\n                        4 total\n                    </span>\n                </header>\n                <div aria-label=\"Recent orders\" class=\"studio-order-table\" data-kid=\"1-2-2-3-2\" data-name=\"recent orders table\" role=\"table\">\n                    <div class=\"studio-order-row\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-1\" data-name=\"order row\" data-reason=\"visibility controlled by ScrollTrigger animation\" role=\"row\">\n                        <span class=\"studio-order-id\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"order id\" role=\"cell\">\n                            #SOL-1048\n                        </span>\n                        <span class=\"studio-order-name\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"customer name\" role=\"cell\">\n                            Noor Rehman\n                        </span>\n                        <span class=\"studio-order-price\" data-kid=\"1-2-2-3-2-1-3\" data-name=\"order price\" role=\"cell\">\n                            Rs. 18,400\n                        </span>\n                        <span class=\"studio-paid\" data-kid=\"1-2-2-3-2-1-4\" data-name=\"order payment status\" role=\"cell\">\n                            Paid\n                        </span>\n                    </div>\n                    <div class=\"studio-order-row\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2\" data-name=\"order row\" data-reason=\"visibility controlled by ScrollTrigger animation\" role=\"row\">\n                        <span class=\"studio-order-id\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"order id\" role=\"cell\">\n                            #SOL-1047\n                        </span>\n                        <span class=\"studio-order-name\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"customer name\" role=\"cell\">\n                            Areeba Malik\n                        </span>\n                        <span class=\"studio-order-price\" data-kid=\"1-2-2-3-2-2-3\" data-name=\"order price\" role=\"cell\">\n                            Rs. 9,800\n                        </span>\n                        <span class=\"studio-paid\" data-kid=\"1-2-2-3-2-2-4\" data-name=\"order payment status\" role=\"cell\">\n                            Paid\n                        </span>\n                    </div>\n                    <div class=\"studio-order-row\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3\" data-name=\"order row\" data-reason=\"visibility controlled by ScrollTrigger animation\" role=\"row\">\n                        <span class=\"studio-order-id\" data-kid=\"1-2-2-3-2-3-1\" data-name=\"order id\" role=\"cell\">\n                            #SOL-1046\n                        </span>\n                        <span class=\"studio-order-name\" data-kid=\"1-2-2-3-2-3-2\" data-name=\"customer name\" role=\"cell\">\n                            Hina Ahmed\n                        </span>\n                        <span class=\"studio-order-price\" data-kid=\"1-2-2-3-2-3-3\" data-name=\"order price\" role=\"cell\">\n                            Rs. 22,100\n                        </span>\n                        <span class=\"studio-pending\" data-kid=\"1-2-2-3-2-3-4\" data-name=\"order payment status\" role=\"cell\">\n                            Pending\n                        </span>\n                    </div>\n                    <div class=\"studio-order-row\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-4\" data-name=\"order row\" data-reason=\"visibility controlled by ScrollTrigger animation\" role=\"row\">\n                        <span class=\"studio-order-id\" data-kid=\"1-2-2-3-2-4-1\" data-name=\"order id\" role=\"cell\">\n                            #SOL-1045\n                        </span>\n                        <span class=\"studio-order-name\" data-kid=\"1-2-2-3-2-4-2\" data-name=\"customer name\" role=\"cell\">\n                            Fatima Khan\n                        </span>\n                        <span class=\"studio-order-price\" data-kid=\"1-2-2-3-2-4-3\" data-name=\"order price\" role=\"cell\">\n                            Rs. 14,500\n                        </span>\n                        <span class=\"studio-paid\" data-kid=\"1-2-2-3-2-4-4\" data-name=\"order payment status\" role=\"cell\">\n                            Paid\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <div aria-label=\"Store snapshot\" class=\"studio-snapshot\" data-kid=\"1-2-2-4\" data-name=\"store summary snapshot\">\n                <span data-kid=\"1-2-2-4-1\" data-name=\"orders summary\">\n                    <strong data-kid=\"1-2-2-4-1-1\" data-name=\"orders count value\">\n                        4\n                    </strong>\n                    orders\n                </span>\n                <span data-kid=\"1-2-2-4-2\" data-name=\"products summary\">\n                    <strong data-kid=\"1-2-2-4-2-1\" data-name=\"products count value\">\n                        13\n                    </strong>\n                    products\n                </span>\n            </div>\n        </div>\n    </main>\n    <nav aria-label=\"Store management\" class=\"studio-mobile-bar\" data-kid=\"1-3\" data-name=\"mobile navigation bar\">\n        <a class=\"selected\" data-kid=\"1-3-1\" data-name=\"overview mobile link\" href=\"#overview\">\n            <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-3-1-1\" data-name=\"dashboard icon\">\n            </i>\n            <span data-kid=\"1-3-1-2\" data-name=\"overview text\">\n                Overview\n            </span>\n        </a>\n        <a data-kid=\"1-3-2\" data-name=\"products mobile link\" href=\"#products\">\n            <i aria-hidden=\"true\" class=\"ti ti-hanger\" data-kid=\"1-3-2-1\" data-name=\"hanger icon\">\n            </i>\n            <span data-kid=\"1-3-2-2\" data-name=\"products text\">\n                Products\n            </span>\n        </a>\n        <a data-kid=\"1-3-3\" data-name=\"orders mobile link\" href=\"#orders\">\n            <i aria-hidden=\"true\" class=\"ti ti-receipt\" data-kid=\"1-3-3-1\" data-name=\"receipt icon\">\n            </i>\n            <span data-kid=\"1-3-3-2\" data-name=\"orders text\">\n                Orders\n            </span>\n        </a>\n        <a data-kid=\"1-3-4\" data-name=\"categories mobile link\" href=\"#categories\">\n            <i aria-hidden=\"true\" class=\"ti ti-category\" data-kid=\"1-3-4-1\" data-name=\"category icon\">\n            </i>\n            <span data-kid=\"1-3-4-2\" data-name=\"categories text\">\n                Categories\n            </span>\n        </a>\n        <a data-kid=\"1-3-5\" data-name=\"customers mobile link\" href=\"#customers\">\n            <i aria-hidden=\"true\" class=\"ti ti-users\" data-kid=\"1-3-5-1\" data-name=\"users icon\">\n            </i>\n            <span data-kid=\"1-3-5-2\" data-name=\"customers text\">\n                Customers\n            </span>\n        </a>\n    </nav>\n</div>\n",
