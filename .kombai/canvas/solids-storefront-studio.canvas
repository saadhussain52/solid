    "var_3d13bbc94ee3": {
      "type": "variant",
      "label": "03 · Merchandise edit · Home",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 12320,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.solids-home{--ink:#292827;--muted:#77716c;--paper:#f8f7f3;--cream:#efebe4;--line:#dedbd4;--accent:#b87558;font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--paper)}\n.solids-home .display{font-family:'Libre Baskerville',serif}\n.solids-home .hero-image{object-position:center 46%}\n.solids-home .hero-shade{background:linear-gradient(90deg,rgba(26,24,23,.55) 0%,rgba(26,24,23,.20) 43%,rgba(26,24,23,0) 76%),linear-gradient(0deg,rgba(26,24,23,.22),transparent 46%)}\n.solids-home .product-img{transition:filter .25s ease}\n.solids-home .product-card:hover .product-img{filter:brightness(.97)}\n.solids-home .category-link:focus-visible,.solids-home button:focus-visible,.solids-home a:focus-visible,.solids-home input:focus-visible{outline:2px solid var(--accent);outline-offset:4px}\n.solids-home .category-link:hover{background:#f0ece5}\n.solids-home .newsletter-input:focus{outline:0;border-color:var(--ink)}\n@media(max-width:900px){.solids-home .desktop-nav{display:none}.solids-home .site-head{height:68px}.solids-home .hero{height:580px}.solids-home .hero-copy{left:6vw;right:6vw;bottom:54px}.solids-home .hero-title{font-size:clamp(56px,10vw,86px)}.solids-home .home-wrap{padding-left:6vw!important;padding-right:6vw!important}.solids-home .categories{grid-template-columns:repeat(3,minmax(0,1fr))!important}.solids-home .products{grid-template-columns:repeat(2,minmax(0,1fr))!important}.solids-home .story{grid-template-columns:1fr 1fr!important}}\n@media(max-width:600px){.solids-home .announcement{display:none}.solids-home .site-head{height:62px;padding-left:14px!important;padding-right:14px!important;grid-template-columns:auto 1fr auto;gap:12px}.solids-home .brand-logo{width:116px!important;height:46px!important}.solids-home .mobile-shop{display:inline-flex!important}.solids-home .header-actions{gap:4px!important}.solids-home .head-action{min-width:42px;padding:0 7px!important}.solids-home .head-action-label{display:none}.solids-home .hero{height:560px;min-height:0}.solids-home .hero-image{object-position:55% center}.solids-home .hero-shade{background:linear-gradient(0deg,rgba(26,24,23,.66) 0%,rgba(26,24,23,.14) 55%,rgba(26,24,23,0) 100%)}.solids-home .hero-copy{left:22px;right:22px;bottom:32px}.solids-home .hero-title{font-size:clamp(50px,14vw,72px);letter-spacing:-.055em}.solids-home .campaign-subtitle{font-size:16px!important;margin-top:8px!important}.solids-home .campaign-copy{font-size:14px!important;max-width:310px!important;margin-top:12px!important}.solids-home .hero-cta{min-height:48px!important;margin-top:22px!important}.solids-home .home-wrap{padding-left:20px!important;padding-right:20px!important}.solids-home .categories-section{padding-top:49px!important;padding-bottom:52px!important}.solids-home .categories{grid-template-columns:1fr!important;gap:0!important}.solids-home .category-link{min-height:58px;padding:8px 2px!important}.solids-home .category-link + .category-link{border-top:1px solid var(--line)}.solids-home .category-link span{font-size:16px!important}.solids-home .arrival-section{padding-top:48px!important;padding-bottom:52px!important}.solids-home .section-heading{align-items:flex-end!important;margin-bottom:22px!important}.solids-home .section-heading h2{font-size:30px!important}.solids-home .products{gap:24px 11px!important}.solids-home .product-img-wrap{aspect-ratio:4/5!important}.solids-home .product-name{font-size:13px!important}.solids-home .product-price{font-size:13px!important}.solids-home .product-category{font-size:11px!important}.solids-home .product-action{display:inline-flex!important;margin-top:8px!important;font-size:11px!important}.solids-home .story{grid-template-columns:1fr!important;gap:20px!important;padding-top:52px!important;padding-bottom:52px!important}.solids-home .story h2{font-size:34px!important}.solids-home .footer-main{grid-template-columns:1fr!important;gap:28px!important}.solids-home .footer-bottom{flex-direction:column;gap:8px!important;align-items:flex-start!important}.solids-home .footer-main,.solids-home .footer-bottom{padding-left:20px!important;padding-right:20px!important}}\n</style>\n<div class=\"solids-home min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"announcement bg-[#292827] px-6 py-[9px] text-center text-[11px] tracking-[.04em] text-[#f7f3ec]\" data-kid=\"1-1\" data-name=\"announcement bar\">\n        Complimentary delivery on orders above Rs. 10,000\n        <span class=\"px-2 text-[#c1876d]\" data-kid=\"1-1-1\" data-name=\"bullet separator icon\">\n            ·\n        </span>\n        4–7 working days\n    </div>\n    <header class=\"site-head grid h-[78px] grid-cols-[1fr_auto_1fr] items-center border-b border-[#dedbd4] bg-[#f8f7f3] px-[5.5vw]\" data-kid=\"1-2\" data-name=\"site header bar\">\n        <nav aria-label=\"Main navigation\" class=\"desktop-nav flex items-center gap-8 text-[13px]\" data-kid=\"1-2-1\" data-name=\"desktop navigation menu\">\n            <a class=\"border-b border-[#292827] pb-1\" data-kid=\"1-2-1-1\" data-name=\"home link\" href=\"#\">\n                Home\n            </a>\n            <a class=\"pb-1 text-[#716b65] hover:text-[#292827]\" data-kid=\"1-2-1-2\" data-name=\"shop link\" href=\"#\">\n                Shop\n            </a>\n            <a class=\"pb-1 text-[#716b65] hover:text-[#292827]\" data-kid=\"1-2-1-3\" data-name=\"brand story link\" href=\"#\">\n                Brand story\n            </a>\n        </nav>\n        <a aria-label=\"Solids home\" class=\"justify-self-center\" data-kid=\"1-2-2\" data-name=\"brand logo link\" href=\"#\">\n            <img alt=\"Solids — No prints, just style\" class=\"brand-logo block h-[55px] w-[158px] object-contain\" data-kid=\"1-2-2-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n        </a>\n        <a class=\"mobile-shop hidden justify-self-center text-[13px]\" data-kid=\"1-2-3\" data-name=\"mobile shop link\" href=\"#\">\n            Shop\n        </a>\n        <div class=\"header-actions flex items-center justify-self-end gap-5\" data-kid=\"1-2-4\" data-name=\"header actions container\">\n            <button aria-label=\"Search products\" class=\"head-action inline-flex min-h-[44px] items-center gap-2 px-2 text-[13px]\" data-kid=\"1-2-4-1\" data-name=\"search button\">\n                <i aria-hidden=\"true\" class=\"ti ti-search text-[18px]\" data-kid=\"1-2-4-1-1\" data-name=\"search icon\">\n                </i>\n                <span class=\"head-action-label\" data-kid=\"1-2-4-1-2\" data-name=\"search button label\">\n                    Search\n                </span>\n            </button>\n            <button aria-label=\"Shopping bag, 0 items\" class=\"head-action inline-flex min-h-[44px] items-center gap-2 border-l border-[#dedbd4] pl-5 pr-1 text-[13px]\" data-kid=\"1-2-4-2\" data-name=\"shopping bag button\">\n                <i aria-hidden=\"true\" class=\"ti ti-shopping-bag text-[18px]\" data-kid=\"1-2-4-2-1\" data-name=\"shopping bag icon\">\n                </i>\n                <span class=\"head-action-label\" data-kid=\"1-2-4-2-2\" data-name=\"shopping bag label\">\n                    Bag\n                </span>\n                <span class=\"text-[#b87558]\" data-kid=\"1-2-4-2-3\" data-name=\"shopping bag count\">\n                    0\n                </span>\n            </button>\n        </div>\n    </header>\n    <main data-kid=\"1-3\" data-name=\"main page content\">\n        <section aria-label=\"Chapter 09 campaign\" class=\"hero relative isolate h-[min(66vh,720px)] min-h-[580px] overflow-hidden bg-[#a9a39a] text-white\" data-kid=\"1-3-1\" data-name=\"hero section\">\n            <img alt=\"Model seated in a contemporary interior, photographed by Brandy Glover on Unsplash\" class=\"hero-image absolute inset-0 h-full w-full object-cover\" data-kid=\"1-3-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1687884605539-62f6c3db9348?auto=format&fit=crop&w=2200&q=85\"/>\n            <div class=\"hero-shade absolute inset-0\" data-kid=\"1-3-1-2\" data-name=\"hero overlay shade\">\n            </div>\n            <div class=\"hero-copy absolute bottom-[11%] left-[8vw] z-10 max-w-[620px]\" data-kid=\"1-3-1-3\" data-name=\"hero copy container\">\n                <p class=\"mb-4 text-[13px] font-medium tracking-[.1em] text-white/90\" data-kid=\"1-3-1-3-1\" data-name=\"hero campaign tag\">\n                    End of summer\n                </p>\n                <h1 class=\"hero-title display text-[clamp(64px,8vw,112px)] leading-[.99] tracking-[-.055em]\" data-kid=\"1-3-1-3-2\" data-name=\"hero headline\">\n                    Chapter 09\n                </h1>\n                <p class=\"campaign-copy mt-5 max-w-[440px] text-[16px] leading-[1.65] text-white/90\" data-kid=\"1-3-1-3-3\" data-name=\"hero description text\">\n                    Quiet silhouettes, tactile layers, and a palette that lets you be the statement.\n                </p>\n                <button class=\"hero-cta mt-7 inline-flex min-h-[50px] items-center justify-between gap-9 bg-[#f8f7f3] px-5 text-[13px] font-semibold text-[#292827] hover:bg-white\" data-kid=\"1-3-1-3-4\" data-name=\"hero call to action button\">\n                    Shop new arrivals\n                    <span aria-hidden=\"true\" data-kid=\"1-3-1-3-4-1\" data-name=\"hero button arrow icon\">\n                        ↗\n                    </span>\n                </button>\n            </div>\n        </section>\n        <section aria-labelledby=\"shop-categories-title\" class=\"categories-section home-wrap mx-auto max-w-[1320px] px-[5.5vw] pb-[76px] pt-[73px]\" data-kid=\"1-3-2\" data-name=\"categories section\">\n            <div class=\"mb-7 flex items-end justify-between gap-8\" data-kid=\"1-3-2-1\" data-name=\"section heading container\">\n                <div data-kid=\"1-3-2-1-1\" data-name=\"section heading\">\n                    <h2 class=\"display text-[34px] font-normal leading-tight tracking-[-.035em]\" data-kid=\"1-3-2-1-1-1\" data-name=\"section title\" id=\"shop-categories-title\">\n                        Shop by category\n                    </h2>\n                    <p class=\"mt-2 text-[14px] text-[#77716c]\" data-kid=\"1-3-2-1-1-2\" data-name=\"section subtitle\">\n                        Find a piece for the way you dress.\n                    </p>\n                </div>\n                <span class=\"hidden text-[12px] text-[#77716c] md:inline\" data-kid=\"1-3-2-1-2\" data-name=\"brand statement text\">\n                    Designed in Lahore, made for everywhere.\n                </span>\n            </div>\n            <div class=\"categories grid grid-cols-5 border-y border-[#dedbd4]\" data-kid=\"1-3-2-2\" data-name=\"categories list container\" role=\"list\">\n                <button class=\"category-link flex min-h-[76px] items-center justify-between border-r border-[#dedbd4] px-5 text-left\" data-kid=\"1-3-2-2-1\" data-name=\"category link new arrivals\" role=\"listitem\">\n                    <span class=\"text-[15px]\" data-kid=\"1-3-2-2-1-1\" data-name=\"category label new arrivals\">\n                        New Arrivals\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-[18px] text-[#9b7462]\" data-kid=\"1-3-2-2-1-2\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </button>\n                <button class=\"category-link flex min-h-[76px] items-center justify-between border-r border-[#dedbd4] px-5 text-left\" data-kid=\"1-3-2-2-2\" data-name=\"category link co-ord sets\" role=\"listitem\">\n                    <span class=\"text-[15px]\" data-kid=\"1-3-2-2-2-1\" data-name=\"category label co-ord sets\">\n                        Co-ord Sets\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-[18px] text-[#9b7462]\" data-kid=\"1-3-2-2-2-2\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </button>\n                <button class=\"category-link flex min-h-[76px] items-center justify-between border-r border-[#dedbd4] px-5 text-left\" data-kid=\"1-3-2-2-3\" data-name=\"category link dresses\" role=\"listitem\">\n                    <span class=\"text-[15px]\" data-kid=\"1-3-2-2-3-1\" data-name=\"category label dresses\">\n                        Dresses\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-[18px] text-[#9b7462]\" data-kid=\"1-3-2-2-3-2\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </button>\n                <button class=\"category-link flex min-h-[76px] items-center justify-between border-r border-[#dedbd4] px-5 text-left\" data-kid=\"1-3-2-2-4\" data-name=\"category link tops\" role=\"listitem\">\n                    <span class=\"text-[15px]\" data-kid=\"1-3-2-2-4-1\" data-name=\"category label tops\">\n                        Tops\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-[18px] text-[#9b7462]\" data-kid=\"1-3-2-2-4-2\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </button>\n                <button class=\"category-link flex min-h-[76px] items-center justify-between px-5 text-left\" data-kid=\"1-3-2-2-5\" data-name=\"category link bottoms\" role=\"listitem\">\n                    <span class=\"text-[15px]\" data-kid=\"1-3-2-2-5-1\" data-name=\"category label bottoms\">\n                        Bottoms\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-[18px] text-[#9b7462]\" data-kid=\"1-3-2-2-5-2\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </button>\n            </div>\n        </section>\n        <section aria-labelledby=\"new-arrivals-title\" class=\"arrival-section bg-[#efebe4] pb-[92px] pt-[76px]\" data-kid=\"1-3-3\" data-name=\"new arrivals section\">\n            <div class=\"home-wrap mx-auto max-w-[1320px] px-[5.5vw]\" data-kid=\"1-3-3-1\" data-name=\"arrivals content wrapper\">\n                <div class=\"section-heading mb-9 flex items-end justify-between gap-6\" data-kid=\"1-3-3-1-1\" data-name=\"section header wrapper\">\n                    <div data-kid=\"1-3-3-1-1-1\" data-name=\"section title and subtitle wrapper\">\n                        <h2 class=\"display text-[38px] font-normal leading-tight tracking-[-.04em]\" data-kid=\"1-3-3-1-1-1-1\" data-name=\"section title\" id=\"new-arrivals-title\">\n                            New arrivals\n                        </h2>\n                        <p class=\"mt-2 text-[14px] text-[#716b65]\" data-kid=\"1-3-3-1-1-1-2\" data-name=\"section subtitle\">\n                            Considered pieces for considered days.\n                        </p>\n                    </div>\n                    <button class=\"inline-flex min-h-[44px] items-center gap-3 border-b border-[#292827] pb-1 text-[13px]\" data-kid=\"1-3-3-1-1-2\" data-name=\"view all link\">\n                        View all\n                        <span aria-hidden=\"true\" data-kid=\"1-3-3-1-1-2-1\" data-name=\"arrow icon\">\n                            ↗\n                        </span>\n                    </button>\n                </div>\n                <div class=\"products grid grid-cols-4 gap-[19px]\" data-kid=\"1-3-3-1-2\" data-name=\"products grid container\">\n                    <article class=\"product-card min-w-0\" data-kid=\"1-3-3-1-2-1\" data-name=\"product card soft rib co-ord\">\n                        <div class=\"product-img-wrap relative aspect-[4/5] overflow-hidden bg-[#e4dfd7]\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"product image container\">\n                            <img alt=\"Soft Rib Co-ord\" class=\"product-img h-full w-full object-cover\" data-kid=\"1-3-3-1-2-1-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=850&q=80\"/>\n                            <span class=\"absolute left-3 top-3 bg-[#f8f7f3] px-3 py-1.5 text-[11px]\" data-kid=\"1-3-3-1-2-1-1-2\" data-name=\"new badge\">\n                                New\n                            </span>\n                        </div>\n                        <div class=\"flex items-start justify-between gap-3 pt-4\" data-kid=\"1-3-3-1-2-1-2\" data-name=\"product info container\">\n                            <div class=\"min-w-0\" data-kid=\"1-3-3-1-2-1-2-1\" data-name=\"product title and category wrapper\">\n                                <h3 class=\"product-name text-[14px] font-medium\" data-kid=\"1-3-3-1-2-1-2-1-1\" data-name=\"product name\">\n                                    Soft Rib Co-ord\n                                </h3>\n                                <p class=\"product-category mt-1 text-[12px] text-[#716b65]\" data-kid=\"1-3-3-1-2-1-2-1-2\" data-name=\"product category\">\n                                    Co-ord Sets\n                                </p>\n                            </div>\n                            <span class=\"product-price whitespace-nowrap text-[14px]\" data-kid=\"1-3-3-1-2-1-2-2\" data-name=\"product price\">\n                                Rs. 12,800\n                            </span>\n                        </div>\n                        <button class=\"product-action hidden min-h-[38px] items-center gap-2 text-left text-[12px] font-medium text-[#6a5144]\" data-kid=\"1-3-3-1-2-1-3\" data-name=\"view product button\">\n                            View product\n                            <span aria-hidden=\"true\" data-kid=\"1-3-3-1-2-1-3-1\" data-name=\"arrow icon\">\n                                ↗\n                            </span>\n                        </button>\n                    </article>\n                    <article class=\"product-card min-w-0\" data-kid=\"1-3-3-1-2-2\" data-name=\"product card sculpt knit co-ord\">\n                        <div class=\"product-img-wrap relative aspect-[4/5] overflow-hidden bg-[#e4dfd7]\" data-kid=\"1-3-3-1-2-2-1\" data-name=\"product image container\">\n                            <img alt=\"Sculpt Knit Co-ord\" class=\"product-img h-full w-full object-cover\" data-kid=\"1-3-3-1-2-2-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=850&q=80\"/>\n                            <span class=\"absolute left-3 top-3 bg-[#f8f7f3] px-3 py-1.5 text-[11px]\" data-kid=\"1-3-3-1-2-2-1-2\" data-name=\"new badge\">\n                                New\n                            </span>\n                        </div>\n                        <div class=\"flex items-start justify-between gap-3 pt-4\" data-kid=\"1-3-3-1-2-2-2\" data-name=\"product info container\">\n                            <div class=\"min-w-0\" data-kid=\"1-3-3-1-2-2-2-1\" data-name=\"product title and category wrapper\">\n                                <h3 class=\"product-name text-[14px] font-medium\" data-kid=\"1-3-3-1-2-2-2-1-1\" data-name=\"product name\">\n                                    Sculpt Knit Co-ord\n                                </h3>\n                                <p class=\"product-category mt-1 text-[12px] text-[#716b65]\" data-kid=\"1-3-3-1-2-2-2-1-2\" data-name=\"product category\">\n                                    Co-ord Sets\n                                </p>\n                            </div>\n                            <span class=\"product-price whitespace-nowrap text-[14px]\" data-kid=\"1-3-3-1-2-2-2-2\" data-name=\"product price\">\n                                Rs. 14,800\n                            </span>\n                        </div>\n                        <button class=\"product-action hidden min-h-[38px] items-center gap-2 text-left text-[12px] font-medium text-[#6a5144]\" data-kid=\"1-3-3-1-2-2-3\" data-name=\"view product button\">\n                            View product\n                            <span aria-hidden=\"true\" data-kid=\"1-3-3-1-2-2-3-1\" data-name=\"arrow icon\">\n                                ↗\n                            </span>\n                        </button>\n                    </article>\n                    <article class=\"product-card min-w-0\" data-kid=\"1-3-3-1-2-3\" data-name=\"product card contour slip dress\">\n                        <div class=\"product-img-wrap relative aspect-[4/5] overflow-hidden bg-[#e4dfd7]\" data-kid=\"1-3-3-1-2-3-1\" data-name=\"product image container\">\n                            <img alt=\"Contour Slip Dress\" class=\"product-img h-full w-full object-cover\" data-kid=\"1-3-3-1-2-3-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=850&q=80\"/>\n                            <span class=\"absolute left-3 top-3 bg-[#f8f7f3] px-3 py-1.5 text-[11px]\" data-kid=\"1-3-3-1-2-3-1-2\" data-name=\"new badge\">\n                                New\n                            </span>\n                        </div>\n                        <div class=\"flex items-start justify-between gap-3 pt-4\" data-kid=\"1-3-3-1-2-3-2\" data-name=\"product info container\">\n                            <div class=\"min-w-0\" data-kid=\"1-3-3-1-2-3-2-1\" data-name=\"product title and category wrapper\">\n                                <h3 class=\"product-name text-[14px] font-medium\" data-kid=\"1-3-3-1-2-3-2-1-1\" data-name=\"product name\">\n                                    Contour Slip Dress\n                                </h3>\n                                <p class=\"product-category mt-1 text-[12px] text-[#716b65]\" data-kid=\"1-3-3-1-2-3-2-1-2\" data-name=\"product category\">\n                                    Dresses\n                                </p>\n                            </div>\n                            <span class=\"product-price whitespace-nowrap text-[14px]\" data-kid=\"1-3-3-1-2-3-2-2\" data-name=\"product price\">\n                                Rs. 9,500\n                            </span>\n                        </div>\n                        <button class=\"product-action hidden min-h-[38px] items-center gap-2 text-left text-[12px] font-medium text-[#6a5144]\" data-kid=\"1-3-3-1-2-3-3\" data-name=\"view product button\">\n                            View product\n                            <span aria-hidden=\"true\" data-kid=\"1-3-3-1-2-3-3-1\" data-name=\"arrow icon\">\n                                ↗\n                            </span>\n                        </button>\n                    </article>\n                    <article class=\"product-card min-w-0\" data-kid=\"1-3-3-1-2-4\" data-name=\"product card everyday linen co-ord\">\n                        <div class=\"product-img-wrap relative aspect-[4/5] overflow-hidden bg-[#e4dfd7]\" data-kid=\"1-3-3-1-2-4-1\" data-name=\"product image container\">\n                            <img alt=\"Everyday Linen Co-ord\" class=\"product-img h-full w-full object-cover\" data-kid=\"1-3-3-1-2-4-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=850&q=80\"/>\n                            <span class=\"absolute left-3 top-3 bg-[#f8f7f3] px-3 py-1.5 text-[11px]\" data-kid=\"1-3-3-1-2-4-1-2\" data-name=\"new badge\">\n                                New\n                            </span>\n                        </div>\n                        <div class=\"flex items-start justify-between gap-3 pt-4\" data-kid=\"1-3-3-1-2-4-2\" data-name=\"product info container\">\n                            <div class=\"min-w-0\" data-kid=\"1-3-3-1-2-4-2-1\" data-name=\"product title and category wrapper\">\n                                <h3 class=\"product-name text-[14px] font-medium\" data-kid=\"1-3-3-1-2-4-2-1-1\" data-name=\"product name\">\n                                    Everyday Linen Co-ord\n                                </h3>\n                                <p class=\"product-category mt-1 text-[12px] text-[#716b65]\" data-kid=\"1-3-3-1-2-4-2-1-2\" data-name=\"product category\">\n                                    Co-ord Sets\n                                </p>\n                            </div>\n                            <span class=\"product-price whitespace-nowrap text-[14px]\" data-kid=\"1-3-3-1-2-4-2-2\" data-name=\"product price\">\n                                Rs. 13,200\n                            </span>\n                        </div>\n                        <button class=\"product-action hidden min-h-[38px] items-center gap-2 text-left text-[12px] font-medium text-[#6a5144]\" data-kid=\"1-3-3-1-2-4-3\" data-name=\"view product button\">\n                            View product\n                            <span aria-hidden=\"true\" data-kid=\"1-3-3-1-2-4-3-1\" data-name=\"arrow icon\">\n                                ↗\n                            </span>\n                        </button>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"story-title\" class=\"story home-wrap mx-auto grid max-w-[1120px] grid-cols-[.9fr_1.1fr] items-center gap-20 px-[6vw] py-[96px]\" data-kid=\"1-3-4\" data-name=\"brand story section\" id=\"brand-story\">\n            <div data-kid=\"1-3-4-1\" data-name=\"brand story title container\">\n                <h2 class=\"display max-w-[440px] text-[42px] font-normal leading-[1.16] tracking-[-.04em]\" data-kid=\"1-3-4-1-1\" data-name=\"brand story headline\" id=\"story-title\">\n                    Clothes that give you room to live.\n                </h2>\n            </div>\n            <div class=\"max-w-[500px]\" data-kid=\"1-3-4-2\" data-name=\"brand story description\">\n                <p class=\"text-[15px] leading-[1.85] text-[#514d49]\" data-kid=\"1-3-4-2-1\" data-name=\"story text paragraph\">\n                    We believe in fewer, better things. Honest fabrics, thoughtful cuts, and a slower approach to getting dressed.\n                </p>\n                <p class=\"mt-5 text-[14px] text-[#716b65]\" data-kid=\"1-3-4-2-2\" data-name=\"story location text\">\n                    Designed in Lahore, made for everywhere.\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#292827] text-[#f7f3ec]\" data-kid=\"1-4\" data-name=\"site footer\">\n        <div class=\"footer-main mx-auto grid max-w-[1320px] grid-cols-[1fr_1fr_1.3fr] gap-12 px-[5.5vw] py-[62px]\" data-kid=\"1-4-1\" data-name=\"footer main content\">\n            <div data-kid=\"1-4-1-1\" data-name=\"footer branding\">\n                <img alt=\"Solids\" class=\"block h-[53px] w-[150px] object-contain brightness-0 invert\" data-kid=\"1-4-1-1-1\" data-name=\"footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n                <p class=\"mt-3 text-[13px] text-[#c5beb5]\" data-kid=\"1-4-1-1-2\" data-name=\"footer tagline\">\n                    Everyday, refined.\n                </p>\n            </div>\n            <div data-kid=\"1-4-1-2\" data-name=\"footer navigation\">\n                <p class=\"text-[13px] font-semibold\" data-kid=\"1-4-1-2-1\" data-name=\"footer nav title\">\n                    Explore\n                </p>\n                <div class=\"mt-4 grid gap-3 text-[13px] text-[#c5beb5]\" data-kid=\"1-4-1-2-2\" data-name=\"footer nav links container\">\n                    <button class=\"w-fit text-left\" data-kid=\"1-4-1-2-2-1\" data-name=\"footer shop all link\">\n                        Shop all\n                    </button>\n                    <button class=\"w-fit text-left\" data-kid=\"1-4-1-2-2-2\" data-name=\"footer new arrivals link\">\n                        New arrivals\n                    </button>\n                    <button class=\"w-fit text-left\" data-kid=\"1-4-1-2-2-3\" data-name=\"footer story link\">\n                        Our story\n                    </button>\n                </div>\n            </div>\n            <div class=\"max-w-[420px]\" data-kid=\"1-4-1-3\" data-name=\"newsletter signup section\">\n                <h2 class=\"display text-[23px] font-normal\" data-kid=\"1-4-1-3-1\" data-name=\"newsletter title\">\n                    Notes from the studio\n                </h2>\n                <p class=\"mt-2 text-[13px] leading-6 text-[#c5beb5]\" data-kid=\"1-4-1-3-2\" data-name=\"newsletter description\">\n                    First look at new drops and quiet notes from the studio.\n                </p>\n                <form aria-label=\"Join the Solids mailing list\" class=\"mt-5 flex items-center border-b border-[#716a62]\" data-kid=\"1-4-1-3-3\" data-name=\"newsletter form\">\n                    <label class=\"sr-only\" data-kid=\"1-4-1-3-3-1\" data-name=\"newsletter email label\" for=\"solids-email\">\n                        Your email address\n                    </label>\n                    <input class=\"newsletter-input min-h-[48px] w-full bg-transparent text-[14px] text-white placeholder:text-[#a8a097]\" data-kid=\"1-4-1-3-3-2\" data-name=\"newsletter email input field\" id=\"solids-email\" placeholder=\"Your email address\" type=\"email\"/>\n                    <button aria-label=\"Subscribe\" class=\"min-h-[48px] px-3 text-[20px]\" data-kid=\"1-4-1-3-3-3\" data-name=\"newsletter subscribe button\">\n                        ↗\n                    </button>\n                </form>\n            </div>\n        </div>\n        <div class=\"footer-bottom mx-auto flex max-w-[1320px] items-center justify-between border-t border-[#45423e] px-[5.5vw] py-5 text-[12px] text-[#aaa39a]\" data-kid=\"1-4-2\" data-name=\"footer bottom bar\">\n            <span data-kid=\"1-4-2-1\" data-name=\"copyright text\">\n                © 2026 Solids Official\n            </span>\n            <span data-kid=\"1-4-2-2\" data-name=\"region currency text\">\n                Pakistan · PKR\n            </span>\n        </div>\n    </footer>\n</div>\n",
