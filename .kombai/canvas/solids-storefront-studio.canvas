      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.solids-store{--ink:#292827;--muted:#77716a;--paper:#f8f7f3;--cream:#efebe4;--line:#dedbd4;--accent:#b87558;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;min-height:100vh}\n.solids-store a{text-decoration:none}\n.solids-store .serif{font-family:'Libre Baskerville',Georgia,serif}\n.solids-store .photo-frame img{display:block;width:100%;height:100%;object-fit:cover}\n.solids-store .hero-photo{object-position:center 42%}\n.solids-store .collection-card{position:relative;overflow:hidden;background:var(--cream)}\n.solids-store .collection-card img{display:block;width:100%;height:100%;object-fit:cover}\n.solids-store .collection-card:after{content:'';position:absolute;inset:36% 0 0;background:linear-gradient(transparent,rgba(25,22,20,.56));pointer-events:none}\n.solids-store .collection-caption{position:absolute;z-index:1;bottom:24px;left:24px;right:20px;color:white}\n.solids-store .hero-copy>a{background:var(--ink);color:var(--paper);font-size:13px}\n.solids-store .product-photo{aspect-ratio:4/5;background:var(--cream);overflow:hidden}\n.solids-store .product-photo img{display:block;width:100%;height:100%;object-fit:cover}\n.solids-store .mobile-collection-index{display:none}\n.solids-store .brand-story-mark{font:400 clamp(70px,9vw,128px)/.9 'Libre Baskerville',Georgia,serif;color:var(--accent)}\n@media(max-width:760px){\n .solids-store .desktop-nav{display:none!important}\n .solids-store .mobile-nav{display:flex!important}\n .solids-store .hero-layout{grid-template-columns:1fr;min-height:0}\n .solids-store .hero-photo-wrap{height:340px}\n .solids-store .hero-copy{padding:30px 24px 32px}\n .solids-store .hero-title{font-size:clamp(46px,12vw,66px);line-height:1.04}\n .solids-store .collections-desktop{display:none!important}\n .solids-store .mobile-collection-index{display:block}\n .solids-store .mobile-collection-row:last-child{border-bottom:0}\n .solids-store .products-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 12px}\n .solids-store .product-photo{aspect-ratio:3/4}\n .solids-store .story-layout{grid-template-columns:1fr;gap:22px}\n .solids-store .footer-grid{grid-template-columns:1fr 1fr;gap:30px 20px}\n .solids-store .newsletter-cell{grid-column:1/-1}\n}\n@media(max-width:420px){\n .solids-store .header-actions{gap:12px}\n .solids-store .logo-img{width:130px}\n .solids-store .hero-photo-wrap{height:290px}\n .solids-store .hero-title{font-size:46px}\n .solids-store .products-heading{align-items:flex-start;flex-direction:column;gap:12px}\n .solids-store .product-photo{aspect-ratio:2.6/3.5}\n .solids-store .product-name{font-size:13px}\n .solids-store .footer-grid{grid-template-columns:1fr 1fr}\n}\n</style>\n<div class=\"solids-store\" data-kid=\"1\">\n    <header class=\"border-b border-[var(--line)]\" data-kid=\"1-1\">\n        <div class=\"mx-auto grid min-h-[84px] max-w-[1440px] grid-cols-[1fr_auto_1fr] items-center px-8 max-[760px]:min-h-[72px] max-[760px]:grid-cols-[1fr_auto] max-[760px]:px-5\" data-kid=\"1-1-1\">\n            <div class=\"desktop-nav flex items-center gap-8 text-[14px]\" data-kid=\"1-1-1-1\">\n                <a class=\"border-b border-[var(--ink)] pb-1\" data-kid=\"1-1-1-1-1\" href=\"#home\">\n                    Home\n                </a>\n                <a class=\"text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-2\" href=\"./all.html\">\n                    Shop\n                </a>\n                <a class=\"text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-3\" href=\"#story\">\n                    Brand story\n                </a>\n            </div>\n            <a aria-label=\"Solids home\" class=\"justify-self-center max-[760px]:justify-self-start\" data-kid=\"1-1-1-2\" href=\"#home\">\n                <img alt=\"Solids — No prints, just style\" class=\"logo-img block h-auto w-[164px] object-contain max-[760px]:w-[146px]\" data-kid=\"1-1-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n            </a>\n            <div class=\"header-actions flex items-center justify-self-end gap-6 text-[13px] max-[760px]:gap-4\" data-kid=\"1-1-1-3\">\n                <a aria-label=\"Search products\" class=\"inline-flex min-h-[44px] items-center gap-2\" data-kid=\"1-1-1-3-1\" href=\"./all.html\">\n                    <i aria-hidden=\"true\" class=\"ti ti-search text-[18px]\" data-kid=\"1-1-1-3-1-1\">\n                    </i>\n                    <span class=\"max-[760px]:hidden\" data-kid=\"1-1-1-3-1-2\">\n                        Search\n                    </span>\n                </a>\n                <button aria-label=\"Bag, 0 items\" class=\"inline-flex min-h-[44px] items-center gap-2 border-0 bg-transparent p-0\" data-kid=\"1-1-1-3-2\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-shopping-bag text-[18px]\" data-kid=\"1-1-1-3-2-1\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-2-2\">\n                        Bag\n                        <span class=\"text-[var(--accent)]\" data-dynamic=\"true\" data-kid=\"1-1-1-3-2-2-1\" data-name=\"cart item count number\" data-reason=\"value reinitialized by cart state script\">\n                            0\n                        </span>\n                    </span>\n                </button>\n            </div>\n            <nav aria-label=\"Main navigation\" class=\"mobile-nav col-span-2 hidden items-center gap-7 border-t border-[var(--line)] py-3 text-[13px]\" data-kid=\"1-1-1-4\">\n                <a data-kid=\"1-1-1-4-1\" href=\"#home\">\n                    Home\n                </a>\n                <a data-kid=\"1-1-1-4-2\" href=\"./all.html\">\n                    Shop\n     