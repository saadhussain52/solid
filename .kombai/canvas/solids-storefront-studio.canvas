    "var_2eb82df87930": {
      "type": "variant",
      "label": "01 · Editorial · Catalog",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n:root{--solids-ink:#292724;--solids-muted:#746f68;--solids-paper:#f8f6f1;--solids-surface:#f1ede6;--solids-line:#ded8cd;--solids-clay:#a76248;--solids-white:#fffdf9;--solids-serif:'Libre Baskerville',Georgia,serif;--solids-sans:'DM Sans',Arial,sans-serif}\nbody{margin:0;background:var(--solids-paper);color:var(--solids-ink);font-family:var(--solids-sans);font-size:14px;-webkit-font-smoothing:antialiased}\na{color:inherit;text-decoration:none}\nbutton{font:inherit;color:inherit;cursor:pointer}\n.solids-announcement{min-height:32px;box-sizing:border-box;display:flex;justify-content:center;align-items:center;background:var(--solids-ink);color:#f7f2e9;text-align:center;padding:7px 16px;font-size:11px;letter-spacing:.025em}\n.solids-announcement span{color:#d6a58d;padding:0 10px}\n.solids-header{height:78px;box-sizing:border-box;padding:0 5.15%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;background:rgba(248,246,241,.96);border-bottom:1px solid var(--solids-line)}\n.solids-nav{display:flex;align-items:center;gap:29px;font-size:13px;color:#45413c}\n.solids-nav a{min-height:44px;display:flex;align-items:center;position:relative}\n.solids-nav a:nth-child(2):after{position:absolute;content:'';bottom:9px;left:0;right:0;background:var(--solids-clay);height:1px}\n.solids-logo{width:170px;height:58px;object-fit:contain;display:block}\n.solids-actions{justify-self:end;display:flex;align-items:center;gap:19px}\n.solids-action{min-height:44px;display:flex;align-items:center;gap:8px;background:transparent;border:0;font-size:12px;padding:0;color:var(--solids-ink)}\n.solids-action .ti{font-size:18px;color:var(--solids-clay)}\n.solids-bag-count{color:var(--solids-clay);font-variant-numeric:tabular-nums}\n.solids-main{max-width:1320px;margin:0 auto;padding:30px 40px 80px}\n.solids-crumbs{display:flex;align-items:center;gap:9px;color:#716b63;font-size:12px;min-height:28px}\n.solids-crumbs span{color:#aaa196;font-size:13px}\n.solids-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,390px);align-items:end;gap:32px;padding:38px 0 27px;border-bottom:1px solid var(--solids-line)}\n.solids-heading h1{font:400 clamp(40px,4.5vw,61px)/1.13 var(--solids-serif);letter-spacing:-.065em;margin:0}\n.solids-subline{margin:13px 0 0;color:#5f5a53;font-size:14px;line-height:1.65;max-width:480px}\n.solids-count-block{justify-self:end;text-align:right;padding-bottom:5px}\n.solids-count{font:400 30px/1 var(--solids-serif);letter-spacing:-.04em;color:var(--solids-clay);font-variant-numeric:tabular-nums}\n.solids-count-label{display:block;color:var(--solids-muted);font-size:12px;margin-top:8px}\n.solids-filter-wrap{padding:19px 0 24px;border-bottom:1px solid var(--solids-line)}\n.solids-filter-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:13px;color:#4f4a44}\n.solids-filter-title{font-size:12px;font-weight:600}\n.solids-current-filter{font-size:12px;color:var(--solids-muted)}\n.solids-filter-list{display:flex;flex-wrap:wrap;align-items:center;gap:8px}\n.solids-filter{min-height:42px;padding:0 17px;background:transparent;border:1px solid #d4cec4;color:#4c4741;font-size:13px;white-space:nowrap}\n.solids-filter.active{background:var(--solids-ink);border-color:var(--solids-ink);color:var(--solids-white)}\n.solids-results-head{display:flex;justify-content:space-between;align-items:center;padding:21px 0 18px}\n.solids-results-label{font-size:13px;color:#47423c}\n.solids-results-label strong{font-weight:600;color:var(--solids-ink)}\n.solids-results-note{font-size:12px;color:var(--solids-muted)}\n.solids-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:37px 18px}\n.solids-product{min-width:0}\n.solids-photo{position:relative;overflow:hidden;aspect-ratio: .795;background:#e8e2d8}\n.solids-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 37%}\n.solids-tag{position:absolute;top:13px;left:13px;background:rgba(248,246,241,.94);padding:7px 10px;color:#504840;font-size:11px;letter-spacing:.01em}\n.solids-product-info{padding:13px 1px 0;display:flex;justify-content:space-between;gap:12px;align-items:flex-start}\n.solids-product-copy{min-width:0}\n.solids-product-name{font-size:14px;font-weight:500;line-height:1.4;margin:0;color:#302d29}\n.solids-product-category{font-size:12px;line-height:1.5;margin:4px 0 0;color:var(--solids-muted)}\n.solids-product-price{font-size:13px;font-weight:500;white-space:nowrap;padding-top:2px;color:#302d29;font-variant-numeric:tabular-nums}\n.solids-view-link{margin-top:10px;display:inline-flex;align-items:center;gap:6px;color:#7e4936;font-size:12px;min-height:32px}\n.solids-view-link .ti{font-size:14px}\n.solids-empty-state{display:none;margin:18px 0 4px;padding:48px 24px;text-align:center;border-top:1px solid var(--solids-line);border-bottom:1px solid var(--solids-line);color:var(--solids-muted)}\n.solids-empty-state strong{display:block;font:400 23px var(--solids-serif);color:var(--solids-ink);margin-bottom:8px}\n.solids-footer{padding:27px 5.15%;background:var(--solids-ink);color:#f6f1e9;display:flex;align-items:center;justify-content:space-between;gap:20px}\n.solids-footer-brand{font:400 17px var(--solids-serif);letter-spacing:.17em}\n.solids-footer-note{font-size:12px;color:#c7beb2}\n.solids-footer-links{display:flex;gap:23px;font-size:12px;color:#f3ede4}\n@media(max-width:1050px){.solids-main{padding-left:30px;padding-right:30px}.solids-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:32px 16px}.solids-header{padding-left:4%;padding-right:4%}.solids-nav{gap:20px}}\n@media(max-width:720px){.solids-announcement{min-height:27px;padding:5px 10px;font-size:10px}.solids-announcement span{padding:0 6px}.solids-header{height:65px;padding:0 17px;grid-template-columns:1fr auto}.solids-nav{display:none}.solids-logo{justify-self:start;width:132px;height:49px}.solids-actions{gap:14px}.solids-action{font-size:12px;gap:5px}.solids-action .ti{font-size:17px}.solids-main{padding:20px 17px 52px}.solids-crumbs{font-size:12px;min-height:25px}.solids-heading{grid-template-columns:minmax(0,1fr) auto;gap:13px;padding:25px 0 20px}.solids-heading h1{font-size:39px;line-height:1.12}.solids-subline{font-size:12px;line-height:1.55;max-width:300px;margin-top:9px}.solids-count-block{align-self:start;padding-top:6px}.solids-count{font-size:24px}.solids-count-label{font-size:11px;margin-top:5px}.solids-filter-wrap{padding:15px 0 17px}.solids-filter-head{margin-bottom:10px}.solids-filter-title,.solids-current-filter{font-size:12px}.solids-filter-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.solids-filter{padding:0 7px;min-height:40px;font-size:12px;text-align:center}.solids-results-head{padding:16px 0 13px}.solids-results-label{font-size:12px}.solids-results-note{display:none}.solids-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 11px}.solids-photo{aspect-ratio:.74}.solids-photo img{object-position:center 34%}.solids-tag{top:8px;left:8px;padding:6px 8px;font-size:10px}.solids-product-info{display:block;padding-top:9px}.solids-product-name{font-size:12px;line-height:1.45}.solids-product-category{font-size:11px;margin-top:3px}.solids-product-price{font-size:12px;padding-top:6px;display:block}.solids-view-link{margin-top:7px;min-height:37px;font-size:12px}.solids-footer{padding:23px 18px;align-items:flex-start;flex-direction:column;gap:11px}.solids-footer-links{gap:18px;flex-wrap:wrap;font-size:12px}}\n@media(max-width:370px){.solids-main{padding-left:13px;padding-right:13px}.solids-header{padding-left:13px;padding-right:13px}.solids-heading{grid-template-columns:minmax(0,1fr) auto;gap:8px}.solids-heading h1{font-size:34px}.solids-grid{gap:22px 9px}.solids-filter{font-size:11px;padding:0 5px}}\n</style>\n<div class=\"solids-announcement\" data-kid=\"1\" data-name=\"announcement bar\">\n    COMPLIMENTARY DELIVERY ON ORDERS ABOVE RS. 10,000\n    <span data-kid=\"1-1\" data-name=\"separator dot\">\n        •\n    </span>\n    4–7 WORKING DAYS\n</div>\n<header class=\"solids-header\" data-kid=\"2\" data-name=\"site header\">\n    <nav aria-label=\"Main navigation\" class=\"solids-nav\" data-kid=\"2-1\" data-name=\"main navigation\">\n        <a data-kid=\"2-1-1\" data-name=\"navigation home link\" href=\"#home\">\n            Home\n        </a>\n        <a aria-current=\"page\" data-kid=\"2-1-2\" data-name=\"navigation shop link\" href=\"#shop\">\n            Shop\n        </a>\n        <a data-kid=\"2-1-3\" data-name=\"navigation story link\" href=\"#story\">\n            Brand story\n        </a>\n    </nav>\n    <a aria-label=\"Solids home\" data-kid=\"2-2\" data-name=\"logo link\" href=\"#home\">\n        <img alt=\"Solids — No prints, just style\" class=\"solids-logo\" data-kid=\"2-2-1\" data-name=\"brand logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n    </a>\n    <div class=\"solids-actions\" data-kid=\"2-3\" data-name=\"header actions container\">\n        <button class=\"solids-action\" data-kid=\"2-3-1\" data-name=\"search button\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-search\" data-kid=\"2-3-1-1\" data-name=\"search icon\">\n            </i>\n            <span data-kid=\"2-3-1-2\" data-name=\"search button text\">\n                Search\n            </span>\n        </button>\n        <button class=\"solids-action\" data-kid=\"2-3-2\" data-name=\"shopping bag button\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-shopping-bag\" data-kid=\"2-3-2-1\" data-name=\"shopping bag icon\">\n            </i>\n            <span data-kid=\"2-3-2-2\" data-name=\"shopping bag label\">\n                Bag\n            </span>\n            <span class=\"solids-bag-count\" data-dynamic=\"true\" data-kid=\"2-3-2-3\" data-name=\"bag item count\" data-reason=\"count value updated by store state\">\n                0\n            </span>\n        </button>\n    </div>\n</header>\n<main class=\"solids-main\" data-kid=\"3\" data-name=\"main product catalog\" id=\"shop\">\n    <nav aria-label=\"Breadcrumb\" class=\"solids-crumbs\" data-kid=\"3-1\" data-name=\"breadcrumb navigation\">\n        <a data-kid=\"3-1-1\" data-name=\"breadcrumb home link\" href=\"#home\">\n            Home\n        </a>\n        <span data-kid=\"3-1-2\" data-name=\"breadcrumb separator\">\n            ›\n        </span>\n        <span aria-current=\"page\" data-kid=\"3-1-3\" data-name=\"current page breadcrumb\">\n            Shop all\n        </span>\n    </nav>\n    <section aria-labelledby=\"catalog-title\" class=\"solids-heading\" data-kid=\"3-2\" data-name=\"catalog heading section\">\n        <div data-kid=\"3-2-1\" data-name=\"catalog title container\">\n            <h1 data-kid=\"3-2-1-1\" data-name=\"catalog main heading\" id=\"catalog-title\">\n                All products\n            </h1>\n            <p class=\"solids-subline\" data-kid=\"3-2-1-2\" data-name=\"catalog description text\">\n                Considered pieces for considered days. Designed in Lahore, made for everywhere.\n            </p>\n        </div>\n        <div class=\"solids-count-block\" data-kid=\"3-2-2\" data-name=\"product count block\">\n            <div class=\"solids-count\" data-dynamic=\"true\" data-kid=\"3-2-2-1\" data-name=\"product count number\" data-reason=\"number updated by filtering script\">\n                13\n            </div>\n            <span class=\"solids-count-label\" data-kid=\"3-2-2-2\" data-name=\"product count label\">\n                products\n            </span>\n        </div>\n    </section>\n    <section aria-label=\"Product categories\" class=\"solids-filter-wrap\" data-kid=\"3-3\" data-name=\"category filter section\">\n        <div class=\"solids-filter-head\" data-kid=\"3-3-1\" data-name=\"filter heading container\">\n            <span class=\"solids-filter-title\" data-kid=\"3-3-1-1\" data-name=\"filter title\">\n                Shop by category\n            </span>\n            <span class=\"solids-current-filter\" data-dynamic=\"true\" data-kid=\"3-3-1-2\" data-name=\"currently showing filter label\" data-reason=\"text updated when filter is applied\">\n                Showing all products\n            </span>\n        </div>\n        <div class=\"solids-filter-list\" data-kid=\"3-3-2\" data-name=\"filter options list\">\n            <button aria-pressed=\"true\" class=\"solids-filter active\" data-dynamic=\"true\" data-kid=\"3-3-2-1\" data-name=\"all products filter button\" data-reason=\"active state toggled by script\">\n                All products\n            </button>\n            <button aria-pressed=\"false\" class=\"solids-filter\" data-dynamic=\"true\" data-kid=\"3-3-2-2\" data-name=\"new arrivals filter button\" data-reason=\"active state toggled by script\">\n                New Arrivals\n            </button>\n            <button aria-pressed=\"false\" class=\"solids-filter\" data-dynamic=\"true\" data-kid=\"3-3-2-3\" data-name=\"co-ord sets filter button\" data-reason=\"active state toggled by script\">\n                Co-ord Sets\n            </button>\n            <button aria-pressed=\"false\" class=\"solids-filter\" data-dynamic=\"true\" data-kid=\"3-3-2-4\" data-name=\"dresses filter button\" data-reason=\"active state toggled by script\">\n                Dresses\n            </button>\n            <button aria-pressed=\"false\" class=\"solids-filter\" data-dynamic=\"true\" data-kid=\"3-3-2-5\" data-name=\"tops filter button\" data-reason=\"active state toggled by script\">\n                Tops\n            </button>\n            <button aria-pressed=\"false\" class=\"solids-filter\" data-dynamic=\"true\" data-kid=\"3-3-2-6\" data-name=\"bottoms filter button\" data-reason=\"active state toggled by script\">\n                Bottoms\n            </button>\n        </div>\n    </section>\n    <div class=\"solids-results-head\" data-kid=\"3-4\" data-name=\"results information head\">\n        <span class=\"solids-results-label\" data-dynamic=\"true\" data-kid=\"3-4-1\" data-name=\"results label\" data-reason=\"label text and count updated by filter\">\n            <strong data-dynamic=\"true\" data-kid=\"3-4-1-1\" data-name=\"filtered category name\" data-reason=\"text updated when filter is applied\">\n                All\n            </strong>\n            · 13 pieces\n        </span>\n        <span class=\"solids-results-note\" data-kid=\"3-4-2\" data-name=\"results note\">\n            Everyday, refined.\n        </span>\n    </div>\n    <section aria-label=\"All products\" class=\"solids-grid\" data-dynamic=\"true\" data-kid=\"3-5\" data-name=\"product grid container\" data-reason=\"grid items re-rendered by filter script\">\n        <article class=\"solids-product\" data-kid=\"3-5-1\" data-name=\"product card\">\n            <a aria-label=\"View Soft Rib Co-ord\" data-kid=\"3-5-1-1\" data-name=\"product image link\" href=\"#soft-rib-co-ord\">\n                <div class=\"solids-photo\" data-kid=\"3-5-1-1-1\" data-name=\"product image container\">\n                    <img alt=\"Soft Rib Co-ord\" data-kid=\"3-5-1-1-1-1\" data-name=\"product photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=720&q=82\"/>\n                    <span class=\"solids-tag\" data-kid=\"3-5-1-1-1-2\" data-name=\"product tag\">\n                        New\n                    </span>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-1-2\" data-name=\"product info container\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-1-2-1\" data-name=\"product text info\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-1-2-1-1\" data-name=\"product name\">\n                        Soft Rib Co-ord\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-1-2-1-2\" data-name=\"product category\">\n                        Co-ord Sets\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-1-2-2\" data-name=\"product price\">\n                    Rs. 12,800\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-1-3\" data-name=\"product view link\" href=\"#soft-rib-co-ord\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-1-3-1\" data-name=\"arrow icon\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-2\">\n            <a aria-label=\"View Sculpt Knit Co-ord\" data-kid=\"3-5-2-1\" href=\"#sculpt-knit-co-ord\">\n                <div class=\"solids-photo\" data-kid=\"3-5-2-1-1\">\n                    <img alt=\"Sculpt Knit Co-ord\" data-kid=\"3-5-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=720&q=82\"/>\n                    <span class=\"solids-tag\" data-kid=\"3-5-2-1-1-2\">\n                        New\n                    </span>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-2-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-2-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-2-2-1-1\">\n                        Sculpt Knit Co-ord\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-2-2-1-2\">\n                        Co-ord Sets\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-2-2-2\">\n                    Rs. 14,800\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-2-3\" href=\"#sculpt-knit-co-ord\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-2-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-3\">\n            <a aria-label=\"View Linen Lounge Set\" data-kid=\"3-5-3-1\" href=\"#linen-lounge-set\">\n                <div class=\"solids-photo\" data-kid=\"3-5-3-1-1\">\n                    <img alt=\"Linen Lounge Set\" data-kid=\"3-5-3-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=720&q=82\"/>\n                    <span class=\"solids-tag\" data-kid=\"3-5-3-1-1-2\">\n                        Bestseller\n                    </span>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-3-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-3-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-3-2-1-1\">\n                        Linen Lounge Set\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-3-2-1-2\">\n                        Co-ord Sets\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-3-2-2\">\n                    Rs. 13,900\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-3-3\" href=\"#linen-lounge-set\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-3-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-4\">\n            <a aria-label=\"View Sunday Cotton Set\" data-kid=\"3-5-4-1\" href=\"#sunday-cotton-set\">\n                <div class=\"solids-photo\" data-kid=\"3-5-4-1-1\">\n                    <img alt=\"Sunday Cotton Set\" data-kid=\"3-5-4-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1485968579580-b6d095142e6e?auto=format&fit=crop&w=720&q=82\"/>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-4-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-4-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-4-2-1-1\">\n                        Sunday Cotton Set\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-4-2-1-2\">\n                        Co-ord Sets\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-4-2-2\">\n                    Rs. 11,900\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-4-3\" href=\"#sunday-cotton-set\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-4-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-5\">\n            <a aria-label=\"View Contour Slip Dress\" data-kid=\"3-5-5-1\" href=\"#contour-slip-dress\">\n                <div class=\"solids-photo\" data-kid=\"3-5-5-1-1\">\n                    <img alt=\"Contour Slip Dress\" data-kid=\"3-5-5-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=720&q=82\"/>\n                    <span class=\"solids-tag\" data-kid=\"3-5-5-1-1-2\">\n                        New\n                    </span>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-5-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-5-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-5-2-1-1\">\n                        Contour Slip Dress\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-5-2-1-2\">\n                        Dresses\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-5-2-2\">\n                    Rs. 9,500\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-5-3\" href=\"#contour-slip-dress\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-5-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-6\">\n            <a aria-label=\"View Oatmeal Column Dress\" data-kid=\"3-5-6-1\" href=\"#oatmeal-column-dress\">\n                <div class=\"solids-photo\" data-kid=\"3-5-6-1-1\">\n                    <img alt=\"Oatmeal Column Dress\" data-kid=\"3-5-6-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1539008835657-9e8e9680c956?auto=format&fit=crop&w=720&q=82\"/>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-6-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-6-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-6-2-1-1\">\n                        Oatmeal Column Dress\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-6-2-1-2\">\n                        Dresses\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-6-2-2\">\n                    Rs. 11,500\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-6-3\" href=\"#oatmeal-column-dress\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-6-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-7\">\n            <a aria-label=\"View Quiet Wrap Dress\" data-kid=\"3-5-7-1\" href=\"#quiet-wrap-dress\">\n                <div class=\"solids-photo\" data-kid=\"3-5-7-1-1\">\n                    <img alt=\"Quiet Wrap Dress\" data-kid=\"3-5-7-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=720&q=82\"/>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-7-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-7-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-7-2-1-1\">\n                        Quiet Wrap Dress\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-7-2-1-2\">\n                        Dresses\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-7-2-2\">\n                    Rs. 10,800\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-7-3\" href=\"#quiet-wrap-dress\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-7-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-8\">\n            <a aria-label=\"View Relaxed Poplin Shirt\" data-kid=\"3-5-8-1\" href=\"#relaxed-poplin-shirt\">\n                <div class=\"solids-photo\" data-kid=\"3-5-8-1-1\">\n                    <img alt=\"Relaxed Poplin Shirt\" data-kid=\"3-5-8-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1605763240000-7e93b172d754?auto=format&fit=crop&w=720&q=82\"/>\n                    <span class=\"solids-tag\" data-kid=\"3-5-8-1-1-2\">\n                        Bestseller\n                    </span>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-8-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-8-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-8-2-1-1\">\n                        Relaxed Poplin Shirt\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-8-2-1-2\">\n                        Tops\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-8-2-2\">\n                    Rs. 6,800\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-8-3\" href=\"#relaxed-poplin-shirt\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-8-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-9\">\n            <a aria-label=\"View The Essential Tee\" data-kid=\"3-5-9-1\" href=\"#the-essential-tee\">\n                <div class=\"solids-photo\" data-kid=\"3-5-9-1-1\">\n                    <img alt=\"The Essential Tee\" data-kid=\"3-5-9-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?auto=format&fit=crop&w=720&q=82\"/>\n                    <span class=\"solids-tag\" data-kid=\"3-5-9-1-1-2\">\n                        Core\n                    </span>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-9-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-9-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-9-2-1-1\">\n                        The Essential Tee\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-9-2-1-2\">\n                        Tops\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-9-2-2\">\n                    Rs. 3,900\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-9-3\" href=\"#the-essential-tee\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-9-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-10\">\n            <a aria-label=\"View Fine Rib Tank\" data-kid=\"3-5-10-1\" href=\"#fine-rib-tank\">\n                <div class=\"solids-photo\" data-kid=\"3-5-10-1-1\">\n                    <img alt=\"Fine Rib Tank\" data-kid=\"3-5-10-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=720&q=82\"/>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-10-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-10-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-10-2-1-1\">\n                        Fine Rib Tank\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-10-2-1-2\">\n                        Tops\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-10-2-2\">\n                    Rs. 4,200\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-10-3\" href=\"#fine-rib-tank\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-10-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-11\">\n            <a aria-label=\"View Daily Wide Leg\" data-kid=\"3-5-11-1\" href=\"#daily-wide-leg\">\n                <div class=\"solids-photo\" data-kid=\"3-5-11-1-1\">\n                    <img alt=\"Daily Wide Leg\" data-kid=\"3-5-11-1-1-1\" data-name=\"product photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1541099649105-f69ad21f3246?auto=format&fit=crop&w=720&q=82\"/>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-11-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-11-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-11-2-1-1\">\n                        Daily Wide Leg\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-11-2-1-2\">\n                        Bottoms\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-11-2-2\">\n                    Rs. 8,200\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-11-3\" href=\"#daily-wide-leg\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-11-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-12\">\n            <a aria-label=\"View Studio Pleat Trouser\" data-kid=\"3-5-12-1\" href=\"#studio-pleat-trouser\">\n                <div class=\"solids-photo\" data-kid=\"3-5-12-1-1\">\n                    <img alt=\"Studio Pleat Trouser\" data-kid=\"3-5-12-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=720&q=82\"/>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-12-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-12-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-12-2-1-1\">\n                        Studio Pleat Trouser\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-12-2-1-2\">\n                        Bottoms\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-12-2-2\">\n                    Rs. 8,900\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-12-3\" href=\"#studio-pleat-trouser\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-12-3-1\">\n                </i>\n            </a>\n        </article>\n        <article class=\"solids-product\" data-kid=\"3-5-13\">\n            <a aria-label=\"View Everyday Linen Co-ord\" data-kid=\"3-5-13-1\" href=\"#everyday-linen-co-ord\">\n                <div class=\"solids-photo\" data-kid=\"3-5-13-1-1\">\n                    <img alt=\"Everyday Linen Co-ord\" data-kid=\"3-5-13-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=720&q=82\"/>\n                    <span class=\"solids-tag\" data-kid=\"3-5-13-1-1-2\">\n                        New\n                    </span>\n                </div>\n            </a>\n            <div class=\"solids-product-info\" data-kid=\"3-5-13-2\">\n                <div class=\"solids-product-copy\" data-kid=\"3-5-13-2-1\">\n                    <h2 class=\"solids-product-name\" data-kid=\"3-5-13-2-1-1\">\n                        Everyday Linen Co-ord\n                    </h2>\n                    <p class=\"solids-product-category\" data-kid=\"3-5-13-2-1-2\">\n                        Co-ord Sets\n                    </p>\n                </div>\n                <span class=\"solids-product-price\" data-kid=\"3-5-13-2-2\">\n                    Rs. 13,200\n                </span>\n            </div>\n            <a class=\"solids-view-link\" data-kid=\"3-5-13-3\" href=\"#everyday-linen-co-ord\">\n                View product\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"3-5-13-3-1\">\n                </i>\n            </a>\n        </article>\n    </section>\n    <div class=\"solids-empty-state\" data-dynamic=\"true\" data-kid=\"3-6\" data-name=\"empty state message\" data-reason=\"visibility toggled by script\">\n        <strong data-kid=\"3-6-1\" data-name=\"empty state title\">\n            No products in this category\n        </strong>\n        <span data-kid=\"3-6-2\" data-name=\"empty state suggestion\">\n            Try another category or view all products.\n        </span>\n    </div>\n</main>\n<footer class=\"solids-footer\" data-kid=\"4\" data-name=\"page footer\" id=\"story\">\n    <a class=\"solids-footer-brand\" data-kid=\"4-1\" data-name=\"footer brand link\" href=\"#home\">\n        SOLIDS\n    </a>\n    <span class=\"solids-footer-note\" data-kid=\"4-2\" data-name=\"footer copyright note\">\n        Everyday, refined. Designed in Lahore, made for everywhere.\n    </span>\n    <nav aria-label=\"Footer navigation\" class=\"solids-footer-links\" data-kid=\"4-3\" data-name=\"footer navigation\">\n        <a data-kid=\"4-3-1\" data-name=\"footer shop link\" href=\"#shop\">\n            Shop all\n        </a>\n        <a data-kid=\"4-3-2\" data-name=\"footer story link\" href=\"#story\">\n            Our story\n        </a>\n        <a data-kid=\"4-3-3\" data-name=\"footer contact email link\" href=\"mailto:solids@studio.pk\">\n            Contact the studio\n        </a>\n    </nav>\n</footer>\n",
