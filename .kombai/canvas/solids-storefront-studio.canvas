      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#f8f7f3] font-['DM_Sans',sans-serif] text-[#292827]\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"bg-[#292827] px-4 py-2.5 text-center text-[11px] font-medium tracking-[0.12em] text-[#f8f5ef]\" data-kid=\"1-1\" data-name=\"announcement banner text\">\n        COMPLIMENTARY DELIVERY ON ORDERS ABOVE RS. 10,000\n        <span class=\"px-2 text-[#b87558]\" data-kid=\"1-1-1\" data-name=\"separator dot\">\n            ·\n        </span>\n        4–7 WORKING DAYS\n    </div>\n    <header class=\"border-b border-[#e3dfd7] bg-[#f8f7f3]\" data-kid=\"1-2\" data-name=\"header container\">\n        <div class=\"mx-auto grid h-[86px] max-w-[1440px] grid-cols-[1fr_auto_1fr] items-center px-5 md:px-10 xl:px-[72px]\" data-kid=\"1-2-1\" data-name=\"header inner layout\">\n            <nav aria-label=\"Main navigation\" class=\"hidden items-center gap-8 text-[13px] md:flex\" data-kid=\"1-2-1-1\" data-name=\"main navigation menu\">\n                <span class=\"border-b border-[#292827] pb-1 font-medium\" data-kid=\"1-2-1-1-1\" data-name=\"shop navigation link\">\n                    Shop\n                </span>\n                <span class=\"text-[#79756f]\" data-kid=\"1-2-1-1-2\" data-name=\"brand story navigation link\">\n                    Brand story\n                </span>\n            </nav>\n            <div class=\"flex items-center md:hidden\" data-kid=\"1-2-1-2\" data-name=\"mobile menu container\">\n                <span class=\"text-[12px] font-medium\" data-kid=\"1-2-1-2-1\" data-name=\"shop mobile link\">\n                    Shop\n                </span>\n            </div>\n            <div class=\"justify-self-center\" data-kid=\"1-2-1-3\" data-name=\"logo container\">\n                <img alt=\"Solids — No prints, just style\" class=\"h-[58px] w-[174px] object-contain\" data-kid=\"1-2-1-3-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n            </div>\n            <div class=\"flex items-center justify-self-end gap-5 text-[13px]\" data-kid=\"1-2-1-4\" data-name=\"header utilities container\">\n                <button aria-label=\"Search products\" class=\"flex min-h-11 items-center gap-2.5 px-1\" data-kid=\"1-2-1-4-1\" data-name=\"search button\">\n                    <i class=\"ti ti-search text-[18px] text-[#292827]\" data-kid=\"1-2-1-4-1-1\" data-name=\"search icon\" style=\"width:18px;height:18px\">\n                    </i>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-2-1-4-1-2\" data-name=\"search text\">\n                        Search\n                    </span>\n                </button>\n                <button aria-label=\"Open bag\" class=\"flex min-h-11 items-center gap-2 border-l border-[#dedbd4] pl-5\" data-kid=\"1-2-1-4-2\" data-name=\"shopping bag button\">\n                    <i class=\"ti ti-shopping-bag text-[18px] text-[#292827]\" data-kid=\"1-2-1-4-2-1\" data-name=\"shopping bag icon\" style=\"width:18px;height:18px\">\n                    </i>\n                    <span data-kid=\"1-2-1-4-2-2\" data-name=\"bag button text\">\n                        Bag\n                    </span>\n                    <span class=\"text-[#b87558]\" data-dynamic=\"true\" data-kid=\"1-2-1-4-2-3\" data-name=\"bag item count\" data-reason=\"count updated by shopping cart script\">\n                        0\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1440px] px-5 pb-24 pt-7 md:px-10 md:pt-9 xl:px-[72px]\" data-kid=\"1-3\" data-name=\"main page content area\">\n        <div class=\"mb-8 flex it