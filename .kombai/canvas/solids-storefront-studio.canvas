class=\"flex justify-between gap-3 py-4\" data-kid=\"1-4-5-2-2-2\" data-name=\"card 2 content\">\n                        <div data-kid=\"1-4-5-2-2-2-1\" data-name=\"card 2 info\">\n                            <h3 class=\"font-[var(--serif)] text-[16px]\" data-kid=\"1-4-5-2-2-2-1-1\" data-name=\"card 2 title\">\n                                Contour Slip Dress\n                            </h3>\n                            <p class=\"mt-1 text-[11px] text-[var(--muted)]\" data-kid=\"1-4-5-2-2-2-1-2\" data-name=\"card 2 meta\">\n                                Dresses / Black\n                            </p>\n                        </div>\n                        <span class=\"text-[12px]\" data-kid=\"1-4-5-2-2-2-2\" data-name=\"card 2 price\">\n                            Rs. 9,500\n                        </span>\n                    </div>\n                </article>\n                <article class=\"recommend-card max-md:hidden\" data-dynamic=\"true\" data-kid=\"1-4-5-2-3\" data-name=\"recommendation card 3\" data-reason=\"autoAlpha/y-offset animated by GSAP on scroll\">\n                    <div class=\"editorial-image relative aspect-[0.8] bg-[var(--cream)]\" data-kid=\"1-4-5-2-3-1\" data-name=\"recommendation image 3 wrap\">\n                        <img alt=\"Minimalist wide-leg trousers — photo by Екатерина Лебедь on Pexels\" class=\"recommend-image\" data-dynamic=\"true\" data-kid=\"1-4-5-2-3-1-1\" data-name=\"recommendation image 3\" data-reason=\"animated y-offset by GSAP scroll trigger\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11055477/pexels-photo-11055477.jpeg?auto=compress&cs=tinysrgb&w=850&q=80\"/>\n                        <span class=\"absolute left-4 top-4 bg-[var(--paper)] px-3 py-2 text-[9px] tracking-[0.12em]\" data-kid=\"1-4-5-2-3-1-2\" data-name=\"recommendation tag 3\">\n                            CORE\n                        </span>\n                    </div>\n                    <div class=\"flex justify-between gap-3 py-4\" data-kid=\"1-4-5-2-3-2\" data-name=\"card 3 content\">\n                        <div data-kid=\"1-4-5-2-3-2-1\" data-name=\"card 3 info\">\n                            <h3 class=\"font-[var(--serif)] text-[16px]\" data-kid=\"1-4-5-2-3-2-1-1\" data-name=\"card 3 title\">\n                                Daily Wide Leg\n                            </h3>\n                            <p class=\"mt-1 text-[11px] text-[var(--muted)]\" data-kid=\"1-4-5-2-3-2-1-2\" data-name=\"card 3 meta\">\n                                Bottoms / Olive\n                            </p>\n                        </div>\n                        <span class=\"text-[12px]\" data-kid=\"1-4-5-2-3-2-2\" data-name=\"card 3 price\">\n                            Rs. 8,200\n                        </span>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-[#d7d2c8] px-6 py-24 text-center max-sm:py-16\" data-kid=\"1-4-6\" data-name=\"final call to action section\">\n            <p class=\"mb-5 text-[10px] tracking-[0.2em] text-[var(--muted)]\" data-kid=\"1-4-6-1\" data-name=\"final overline\">\n                LESS, BUT BETTER\n            </p>\n            <h2 class=\"font-[var(--serif)] text-[clamp(32px,5vw,64px)] leading-[1.2] tracking-[-0.045em]\" data-kid=\"1-4-6-2\" data-name=\"final headline\">\n                Make room for\n                <span class=\"italic\" data-kid=\"1-4-6-2-1\" data-name=\"final italic accent\">\n                    the everyday.\n                </span>\n            </h2>\n            <a class=\"mt-8 inline-flex items-center gap-8 bg-[var(--dark)] px-6 py-4 text-[11px] font-semibold uppercase tracking-[0.1em] text-white\" data-kid=\"1-4-6-3\" data-name=\"return to top button\" href=\"#product\">\n                Return to the piece\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"1-4-6-3-1\" data-name=\"arrow icon\">\n                </i>\n            </a>\n        </section>\n    </main>\n    <footer class=\"bg-[var(--ink)] px-[6vw] pb-7 pt-14 text-[#f7f3ec]\" data-kid=\"1-5\" data-name=\"footer\">\n        <div class=\"flex items-start justify-between gap-10 max-md:flex-col\" data-kid=\"1-5-1\" data-name=\"footer main grid\">\n            <div data-kid=\"1-5-1-1\" data-name=\"footer branding\">\n                <img alt=\"Solids — No prints, just style\" class=\"h-[58px] w-[180px] object-contain brightness-0 invert\" data-kid=\"1-5-1-1-1\" data-name=\"footer logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n                <p class=\"mt-4 text-[11px] text-[#aaa39a]\" data-kid=\"1-5-1-1-2\" data-name=\"footer tagline\">\n                    Everyday, refined.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-3 gap-14 text-[11px] max-sm:grid-cols-2 max-sm:gap-8\" data-kid=\"1-5-1-2\" data-name=\"footer links navigation\">\n                <div data-kid=\"1-5-1-2-1\" data-name=\"explore links group\">\n                    <p class=\"mb-4 text-[9px] tracking-[0.17em] text-[#928c84]\" data-kid=\"1-5-1-2-1-1\" data-name=\"explore title\">\n                        EXPLORE\n                    </p>\n                    <a class=\"mb-3 block text-[#dbd5cd]\" data-kid=\"1-5-1-2-1-2\" data-name=\"shop all link\" href=\"#collection\">\n                        Shop all\n                    </a>\n                    <a class=\"block text-[#dbd5cd]\" data-kid=\"1-5-1-2-1-3\" data-name=\"our story link\" href=\"#story\">\n                        Our story\n                    </a>\n                </div>\n                <div data-kid=\"1-5-1-2-2\" data-name=\"help links group\">\n                    <p class=\"mb-4 text-[9px] tracking-[0.17em] text-[#928c84]\" data-kid=\"1-5-1-2-2-1\" data-name=\"help title\">\n                        HELP\n                    </p>\n                    <a class=\"mb-3 block text-[#dbd5cd]\" data-kid=\"1-5-1-2-2-2\" data-name=\"shipping link\" href=\"#product\">\n                        Shipping & returns\n                    </a>\n                    <a class=\"block text-[#dbd5cd]\" data-kid=\"1-5-1-2-2-3\" data-name=\"contact link\" href=\"#product\">\n                        Contact the studio\n                    </a>\n                </div>\n                <div class=\"max-sm:col-span-2\" data-kid=\"1-5-1-2-3\" data-name=\"mailing list group\">\n                    <p class=\"mb-4 text-[9px] tracking-[0.17em] text-[#928c84]\" data-kid=\"1-5-1-2-3-1\" data-name=\"mailing list title\">\n                        THE MAILING LIST\n                    </p>\n                    <p class=\"mb-4 max-w-[240px] leading-[1.7] text-[#aaa39a]\" data-kid=\"1-5-1-2-3-2\" data-name=\"mailing list description\">\n                        First look at new drops and quiet notes from the studio.\n                    </p>\n                    <div class=\"flex border-b border-[#746e67] pb-2\" data-kid=\"1-5-1-2-3-3\" data-name=\"mailing list input field\">\n                        <span class=\"text-[#aaa39a]\" data-kid=\"1-5-1-2-3-3-1\" data-name=\"input label\">\n                            Your email address\n                        </span>\n                        <span class=\"ml-auto\" data-kid=\"1-5-1-2-3-3-2\" data-name=\"arrow icon\">\n                            ↗\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-12 flex justify-between border-t border-[#4a4742] pt-5 text-[9px] text-[#817b74] max-sm:flex-col max-sm:gap-2\" data-kid=\"1-5-2\" data-name=\"footer bottom section\">\n            <span data-kid=\"1-5-2-1\" data-name=\"copyright notice\">\n                © 2026 Solids Official\n            </span>\n            <span data-kid=\"1-5-2-2\" data-name=\"region selector\">\n                Pakistan / PKR\n            </span>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n  gsap.to('.reading-progress', {\n    scaleX: 1,\n    ease: 'none',\n    scrollTrigger: { trigger: document.documentElement, start: 'top top', end: 'max', scrub: true }\n  });\n  gsap.to('.product-hero-image', {\n    yPercent: 7,\n    scale: 1.04,\n    ease: 'none',\n    scrollTrigger: { trigger: '#product', start: 'top top', end: 'bottom top', scrub: 0.8 }\n  });\n  gsap.utils.toArray('.story-step').forEach((step, index) => {\n    gsap.fromTo(step, { autoAlpha: 0.68, y: 14 }, {\n      autoAlpha: 1,\n      y: 0,\n      ease: 'none',\n      scrollTrigger: { trigger: step, start: 'top 72%', end: 'top 38%', scrub: 0.6 }\n    });\n    ScrollTrigger.create({\n      trigger: step,\n      start: 'top center',\n      end: 'bottom center',\n      onEnter: () => setStorySlide(index),\n      onEnterBack: () => setStorySlide(index)\n    });\n  });\n  function setStorySlide(index) {\n    const slides = gsap.utils.toArray('.story-slide');\n    slides.forEach((slide, slideIndex) => gsap.to(slide, { autoAlpha: slideIndex === index ? 1 : 0, scale: slideIndex === index ? 1 : 1.035, duration: 0.55, ease: 'power2.out', overwrite: true }));\n    const chapter = document.querySelector('.story-caption');\n    const activeStep = document.querySelectorAll('.story-step')[index];\n    if (chapter && activeStep) chapter.textContent = activeStep.dataset.chapter;\n  }\n  gsap.utils.toArray('.detail-image, .recommend-image').forEach((image) => {\n    gsap.fromTo(image, { yPercent: -5 }, {\n      yPercent: 5,\n      ease: 'none',\n      scrollTrigger: { trigger: image.closest('section'), start: 'top bottom', end: 'bottom top', scrub: 0.8 }\n    });\n  });\n  gsap.utils.toArray('.recommend-card').forEach((card, index) => {\n    gsap.fromTo(card, { autoAlpha: 0, y: 34 }, {\n      autoAlpha: 1,\n      y: 0,\n      duration: 0.7,\n      delay: index * 0.08,\n      ease: 'power2.out',\n      scrollTrigger: { trigger: card, start: 'top 86%', toggleActions: 'play none none reverse' }\n    });\n  });\n  window.addEventListener('load', () => ScrollTrigger.refresh());\n</script>\n",
      "comments": [],
      "created": "2026-09-30T21:36:54.056741+00:00",
      "modified": "2026-09-30T21:46:06.208086+00:00",
      "id": "var_db6faa94147c"
    },
    "var_27579b2e35b2": {
      "type": "variant",
      "label": "01 · Editorial · Studio",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.studio-shell{min-height:100vh;background:#f5f3ee;color:#292827;font-family:'DM Sans',sans-serif;font-size:14px;line-height:1.45;display:flex}\n.studio-sidebar{width:248px;flex:0 0 248px;background:#292827;color:#f8f7f3;padding:27px 22px 22px;display:flex;flex-direction:column;min-height:100vh}\n.studio-logo{display:flex;align-items:center;width:188px;height:63px;margin:0 10px 54px}\n.studio-logo img{display:block;width:100%;height:100%;object-fit:contain;filter:brightness(0) invert(1)}\n.studio-nav-label{margin:0 12px 14px;color:#a6a098;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase}\n.studio-nav{display:grid;gap:5px}\n.studio-nav a,.storefront-link{display:flex;align-items:center;gap:13px;min-height:45px;padding:0 13px;color:#d0ccc4;text-decoration:none;font-size:14px;border-radius:3px}\n.studio-nav a .ti,.storefront-link .ti{font-size:17px;width:20px;height:20px;color:#b8b1a7;display:inline-flex;align-items:center;justify-content:center}\n.studio-nav a.active{background:#3b3935;color:#fff;box-shadow:inset 2px 0 #b87558}\n.studio-nav a.active .ti{color:#d39a7d}\n.studio-nav a:not(.active):hover,.storefront-link:hover{background:#34322e;color:#fff}\n.studio-sidebar-bottom{margin-top:auto;padding-top:20px;border-top:1px solid #4b4842}\n.storefront-link{padding-inline:13px}\n.studio-main{min-width:0;flex:1;padding:0 54px 60px}\n.studio-topbar{height:89px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #dfdbd3}\n.studio-breadcrumb{display:flex;align-items:center;gap:9px;color:#77736c;font-size:12px}\n.studio-breadcrumb .ti{font-size:14px;color:#a6a098}\n.studio-top-link{display:inline-flex;align-items:center;gap:9px;color:#4b4842;text-decoration:none;font-size:13px;padding:10px 0;border-bottom:1px solid transparent}\n.studio-top-link:hover{border-color:#b87558;color:#8d513a}\n.studio-title-row{padding:36px 0 27px;display:flex;justify-content:space-between;align-items:end;gap:24px}\n.studio-title-row h1{font:400 36px/1.15 'Libre Baskerville',serif;letter-spacing:-.045em;margin:0;color:#292827}\n.studio-title-row p{color:#716d65;margin:10px 0 0;font-size:14px;max-width:510px}\n.attention-count{display:flex;align-items:center;gap:10px;color:#6c4a39;font-size:13px;white-space:nowrap;padding-bottom:5px}\n.attention-count .dot{width:8px;height:8px;background:#b87558;border-radius:50%}\n.priority-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(370px,.88fr);gap:20px;align-items:start}\n.priority-section{background:#fbfaf7;border:1px solid #e2ded6;min-width:0;padding:23px 25px 20px}\n.section-heading{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:17px}\n.section-heading h2{margin:0;font:400 21px/1.28 'Libre Baskerville',serif;letter-spacing:-.035em;color:#292827}\n.section-heading span{font-size:12px;color:#77736c;white-space:nowrap}\n.order-review{border-top:1px solid #e4e0d8;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:17px 0 0}\n.order-review-main{min-width:0}\n.record-topline{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:7px}\n.order-id{font-size:13px;font-weight:600;letter-spacing:.015em;color:#292827}\n.status-text{display:inline-flex;align-items:center;gap:7px;color:#825034;font-size:12px;font-weight:600}\n.status-text .status-dot{width:7px;height:7px;border-radius:50%;background:#b87558}\n.order-customer{margin:0;color:#35332f;font-size:15px;font-weight:500}\n.order-detail{margin:5px 0 0;color:#767169;font-size:13px}\n.order-total{font:400 17px 'Libre Baskerville',serif;white-space:nowrap;text-align:right;color:#292827}\n.record-action{grid-column:1/-1;border-top:1px solid #e6e2db;margin-top:15px;padding-top:13px;display:flex;justify-content:space-between;align-items:center;color:#6d675e;font-size:12px}\n.record-action a{display:inline-flex;gap:8px;align-items:center;color:#8d513a;text-decoration:none;font-weight:600;font-size:13px}\n.record-action a:hover{color:#573525}\n.low-stock-list{border-top:1px solid #e4e0d8}\n.stock-record{display:grid;grid-template-columns:46px minmax(0,1fr) auto;gap:13px;align-items:center;padding:11px 0;border-bottom:1px solid #e6e2db}\n.stock-record:last-child{border-bottom:0}\n.stock-record img{width:46px;height:57px;object-fit:cover;background:#e9e6df}\n.stock-product-name{display:block;color:#35332f;text-decoration:none;font-size:13px;font-weight:500;line-height:1.35}\n.stock-product-category{display:block;color:#7c776e;font-size:12px;margin-top:4px}\n.stock-qty{text-align:right;white-space:nowrap;color:#87543b;font-size:13px;font-weight:600}\n.stock-qty small{display:block;color:#77736c;font-size:11px;font-weight:400;margin-top:2px}\n.stock-footer{padding-top:13px;border-top:1px solid #e6e2db;margin-top:1px;text-align:right}\n.stock-footer a,.section-link{color:#8d513a;text-decoration:none;font-size:13px;font-weight:600;display:inline-flex;align-items:center;gap:8px}\n.stock-footer a:hover,.section-link:hover{color:#573525}\n.recent-section{margin-top:24px;background:#fbfaf7;border:1px solid #e2ded6;padding:22px 25px 11px}\n.recent-section .section-heading{margin-bottom:8px}\n.recent-list{border-top:1px solid #e4e0d8}\n.recent-row{display:grid;grid-template-columns:minmax(160px,.9fr) minmax(170px,1.1fr) minmax(110px,.55fr) auto;gap:18px;align-items:center;padding:15px 0;border-bottom:1px solid #e6e2db}\n.recent-row:last-child{border-bottom:0}\n.recent-id{font-size:13px;font-weight:600;color:#292827}\n.recent-customer{color:#555149;font-size:13px}\n.recent-total{font:400 15px 'Libre Baskerville',serif;text-align:right;white-space:nowrap}\n.paid-state{display:inline-flex;align-items:center;gap:7px;justify-self:end;color:#5d6d59;font-size:12px;font-weight:600}\n.paid-state .status-dot{width:7px;height:7px;border-radius:50%;background:#71816c}\n.recent-bottom{display:flex;justify-content:flex-end;padding:7px 0 12px}\n.admin-footer-note{margin:23px 0 0;color:#827d73;font-size:12px}\n.ti{line-height:1;vertical-align:middle}\n@media(max-width:1100px){.studio-main{padding-inline:32px}.studio-sidebar{width:222px;flex-basis:222px;padding-inline:18px}.priority-grid{grid-template-columns:minmax(0,1fr) minmax(320px,.9fr);gap:14px}.priority-section,.recent-section{padding-inline:19px}.recent-row{grid-template-columns:minmax(140px,.8fr) minmax(150px,1fr) minmax(105px,.6fr) auto;gap:12px}}\n@media(max-width:800px){.studio-shell{display:block}.studio-sidebar{width:auto;min-height:0;padding:14px 18px 13px}.studio-sidebar-top{display:flex;align-items:center;justify-content:space-between;gap:16px}.studio-logo{width:145px;height:48px;margin:0}.studio-nav-label{display:none}.studio-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;margin-top:12px}.studio-nav a{min-height:42px;padding:6px 9px;gap:8px;font-size:12px;line-height:1.2}.studio-nav a .ti{font-size:16px;width:17px;height:17px;flex:0 0 17px}.studio-sidebar-bottom{margin:0;padding:0;border:0}.storefront-link{min-height:40px;padding:4px 0;font-size:12px}.storefront-link .ti{font-size:16px}.studio-main{padding:0 24px 38px}.studio-topbar{height:64px}.studio-title-row{padding:26px 0 20px}.studio-title-row h1{font-size:32px}.priority-grid{grid-template-columns:1fr}.priority-section{padding:20px 21px}.recent-section{margin-top:16px;padding:20px 21px 10px}}\n@media(max-width:540px){.studio-sidebar{padding:11px 14px}.studio-sidebar-top{align-items:center}.studio-logo{width:120px;height:43px}.storefront-link{gap:6px;font-size:11px}.storefront-link .ti{display:none}.studio-nav{grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;margin-top:8px}.studio-nav a{min-height:40px;font-size:12px}.studio-main{padding-inline:16px}.studio-topbar{height:57px}.studio-title-row{display:block;padding:23px 0 18px}.studio-title-row h1{font-size:30px}.studio-title-row p{font-size:13px;line-height:1.5;margin-top:7px}.attention-count{padding:13px 0 0;font-size:12px}.priority-section,.recent-section{padding:18px 16px}.section-heading{align-items:flex-start;margin-bottom:14px}.section-heading h2{font-size:19px}.section-heading span{font-size:11px}.order-review{grid-template-columns:minmax(0,1fr) auto;gap:8px}.order-customer{font-size:14px}.order-detail{font-size:12px;line-height:1.45}.order-total{font-size:15px}.record-action{align-items:flex-start;gap:8px;line-height:1.45}.stock-record{grid-template-columns:42px minmax(0,1fr) auto;gap:10px}.stock-record img{width:42px;height:53px}.stock-product-name{font-size:12px}.stock-product-category{font-size:11px}.stock-qty{font-size:12px}.stock-qty small{font-size:10px}.recent-row{grid-template-columns:minmax(0,1fr) auto;gap:5px 12px;padding:13px 0}.recent-id{font-size:12px}.recent-customer{grid-column:1;grid-row:2;font-size:12px}.recent-total{grid-column:2;grid-row:1;font-size:14px}.paid-state{grid-column:2;grid-row:2;font-size:11px}.admin-footer-note{font-size:11px}}\n</style>\n<div class=\"studio-shell\" data-kid=\"1\" data-name=\"studio admin dashboard layout\">\n    <aside class=\"studio-sidebar\" data-kid=\"1-1\" data-name=\"sidebar container\">\n        <div class=\"studio-sidebar-top\" data-kid=\"1-1-1\" data-name=\"sidebar top section\">\n            <a aria-label=\"Solids Studio home\" class=\"studio-logo\" data-kid=\"1-1-1-1\" data-name=\"home page link with logo\" href=\"admin.html\">\n                <img alt=\"Solids — No prints, just style\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/solids-logo-transparent.png\"/>\n            </a>\n            <div class=\"studio-sidebar-bottom\" data-kid=\"1-1-1-2\" data-name=\"sidebar bottom storefront link container\">\n                <a class=\"storefront-link\" data-kid=\"1-1-1-2-1\" data-name=\"storefront link\" href=\"index.html\">\n                    <i class=\"ti ti-external-link\" data-kid=\"1-1-1-2-1-1\" data-name=\"external link icon\" style=\"color:#b8b1a7;width:20px;height:20px;font-size:17px\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"storefront link text\">\n                        View storefront\n                    </span>\n                </a>\n            </div>\n        </div>\n        <p class=\"studio-nav-label\" data-kid=\"1-1-2\" data-name=\"sidebar studio nav label\">\n            Studio\n        </p>\n        <nav aria-label=\"Studio navigation\" class=\"studio-nav\" data-kid=\"1-1-3\" data-name=\"sidebar main navigation menu\">\n            <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-3-1\" data-name=\"overview nav link\" href=\"admin.html\">\n                <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-3-1-1\" data-name=\"overview icon\" style=\"color:#d39a7d;width:20px;height:20px;font-size:17px\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"overview text\">\n                    Overview\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-2\" data-name=\"products nav link\" href=\"products.html\">\n                <i class=\"ti ti-hanger-2\" data-kid=\"1-1-3-2-1\" data-name=\"products icon\" style=\"color:#b8b1a7;width:20px;height:20px;font-size:17px\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"products text\">\n                    Products & inventory\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-3\" data-name=\"orders nav link\" href=\"orders.html\">\n                <i class=\"ti ti-receipt\" data-kid=\"1-1-3-3-1\" data-name=\"orders icon\" style=\"color:#b8b1a7;width:20px;height:20px;font-size:17px\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"orders text\">\n                    Orders\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-4\" data-name=\"categories nav link\" href=\"categories.html\">\n                <i class=\"ti ti-category\" data-kid=\"1-1-3-4-1\" data-name=\"categories icon\" style=\"color:#b8b1a7;width:20px;height:20px;font-size:17px\">\n                </i>\n                <span data-kid=\"1-1-3-4-2\" data-name=\"categories text\">\n                    Categories & banners\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-5\" data-name=\"customers nav link\" href=\"customers.html\">\n                <i class=\"ti ti-users\" data-kid=\"1-1-3-5-1\" data-name=\"customers icon\" style=\"color:#b8b1a7;width:20px;height:20px;font-size:17px\">\n                </i>\n                <span data-kid=\"1-1-3-5-2\" data-name=\"customers text\">\n                    Customers\n                </span>\n            </a>\n        </nav>\n    </aside>\n    <main class=\"studio-main\" data-kid=\"1-2\" data-name=\"main content area\">\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n        </script>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n        </script>\n        <script>\n            document.addEventListener('DOMContentLoaded', () => {\n            gsap.registerPlugin(ScrollTrigger);\n            gsap.utils.toArray('main h1, main h2').forEach((heading) => {\n              const label = heading.textContent.trim().replace(/\\\\s+/g, ' ');\n              heading.setAttribute('aria-label', label);\n              heading.textContent = '';\n              const words = label.split(' ').map((word) => {\n                const mask = document.createElement('span');\n                const revealWord = document.createElement('span');\n                mask.style.display = 'inline-block';\n                mask.style.overflow = 'hidden';\n                mask.style.verticalAlign = 'bottom';\n                mask.style.paddingBottom = '.12em';\n                mask.style.marginBottom = '-.12em';\n                revealWord.style.display = 'inline-block';\n                revealWord.textContent = word;\n                mask.appendChild(revealWord);\n                heading.appendChild(mask);\n                heading.appendChild(document.createTextNode(' '));\n                return revealWord;\n              });\n              gsap.fromTo(words, { yPercent: 112, autoAlpha: 0 }, {\n                yPercent: 0,\n                autoAlpha: 1,\n                duration: 0.58,\n                stagger: 0.075,\n                ease: 'power3.out',\n                scrollTrigger: { trigger: heading, start: 'top 91%', toggleActions: 'play none none reverse' }\n              });\n            });\n            const descriptions = gsap.utils.toArray('main p').filter((copy) => (copy.dataset.name || '').toLowerCase().includes('description'));\n            descriptions.forEach((copy) => {\n              gsap.fromTo(copy, { autoAlpha: 0, y: 15 }, {\n                autoAlpha: 1,\n                y: 0,\n                duration: 0.62,\n                ease: 'power2.out',\n                scrollTrigger: { trigger: copy, start: 'top 92%', toggleActions: 'play none none reverse' }\n              });\n            });\n            const cards = gsap.utils.toArray('.order-review, .stock-record, .recent-row');\n            gsap.set(cards, { autoAlpha: 0, y: 18 });\n            ScrollTrigger.batch(cards, {\n              start: 'top 90%',\n              interval: 0.08,\n              batchMax: 4,\n              onEnter: (items) => gsap.to(items, { autoAlpha: 1, y: 0, duration: 0.58, stagger: 0.075, ease: 'power2.out', overwrite: true }),\n              onEnterBack: (items) => gsap.to(items, { autoAlpha: 1, y: 0, duration: 0.48, stagger: 0.06, ease: 'power2.out', overwrite: true }),\n              onLeaveBack: (items) => gsap.set(items, { autoAlpha: 0, y: 18, overwrite: true })\n            });\n            window.addEventListener('load', () => ScrollTrigger.refresh());\n          });\n        </script>\n        <div class=\"studio-topbar\" data-kid=\"1-2-1\" data-name=\"top navigation bar\">\n            <div class=\"studio-breadcrumb\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation container\">\n                <i class=\"ti ti-layout-dashboard\" data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb home icon\" style=\"color:#a6a098;width:16px;height:16px;font-size:14px\">\n                </i>\n                <span data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb home label\">\n                    Studio\n                </span>\n                <i class=\"ti ti-chevron-right\" data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb separator icon\" style=\"color:#a6a098;width:14px;height:14px;font-size:13px\">\n                </i>\n                <span data-kid=\"1-2-1-1-4\" data-name=\"breadcrumb current page label\">\n                    Overview\n                </span>\n            </div>\n            <a class=\"studio-top-link\" data-kid=\"1-2-1-2\" data-name=\"top storefront link\" href=\"index.html\">\n                View storefront\n                <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-1-2-1\" data-name=\"external link arrow icon\" style=\"color:inherit;width:16px;height:16px;font-size:15px\">\n                </i>\n            </a>\n        </div>\n        <header class=\"studio-title-row\" data-kid=\"1-2-2\" data-name=\"header title section\">\n            <div data-kid=\"1-2-2-1\" data-name=\"page title container\">\n                <h1 data-dynamic=\"true\" data-kid=\"1-2-2-1-1\" data-name=\"page heading text\" data-reason=\"text content masked and animated by GSAP script\">\n                    Overview\n                </h1>\n                <p data-dynamic=\"true\" data-kid=\"1-2-2-1-2\" data-name=\"page description text\" data-reason=\"text content animated by GSAP script\">\n                    One order needs a review. Three products have six units in stock.\n                </p>\n            </div>\n            <div class=\"attention-count\" data-kid=\"1-2-2-2\" data-name=\"attention indicator container\">\n                <span class=\"dot\" data-kid=\"1-2-2-2-1\" data-name=\"attention dot indicator\">\n                </span>\n                <span data-kid=\"1-2-2-2-2\" data-name=\"attention count label\">\n                    4 items to review\n                </span>\n            </div>\n        </header>\n        <div class=\"priority-grid\" data-kid=\"1-2-3\" data-name=\"priority section grid\">\n            <section aria-labelledby=\"orders-review-title\" class=\"priority-section\" data-kid=\"1-2-3-1\" data-name=\"orders to review section\">\n                <div class=\"section-heading\" data-kid=\"1-2-3-1-1\" data-name=\"orders section heading container\">\n                    <h2 data-dynamic=\"true\" data-kid=\"1-2-3-1-1-1\" data-name=\"orders section title\" data-reason=\"text content masked and animated by GSAP script\" id=\"orders-review-title\">\n                        Orders to review\n                    </h2>\n                    <span data-kid=\"1-2-3-1-1-2\" data-name=\"pending orders count label\">\n                        1 pending\n                    </span>\n                </div>\n                <article class=\"order-review\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2\" data-name=\"pending order item\" data-reason=\"visibility controlled by GSAP ScrollTrigger\">\n                    <div class=\"order-review-main\" data-kid=\"1-2-3-1-2-1\" data-name=\"pending order main details\">\n                        <div class=\"record-topline\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"order meta container\">\n                            <span class=\"order-id\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"order ID text\">\n                                #SOL-1046\n                            </span>\n                            <span class=\"status-text\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"order status label\">\n                                <span class=\"status-dot\" data-kid=\"1-2-3-1-2-1-1-2-1\" data-name=\"order status dot\">\n                                </span>\n                                Pending\n                            </span>\n                        </div>\n                        <p class=\"order-customer\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"order customer name\">\n                            Hina Ahmed\n                        </p>\n                        <p class=\"order-detail\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"order description text\">\n                            Sculpt Knit Co-ord × 1 · Yesterday, 4:28 PM\n                        </p>\n                    </div>\n                    <strong class=\"order-total\" data-kid=\"1-2-3-1-2-2\" data-name=\"order total amount\">\n                        Rs. 22,100\n                    </strong>\n                    <div class=\"record-action\" data-kid=\"1-2-3-1-2-3\" data-name=\"order action container\">\n                        <span data-kid=\"1-2-3-1-2-3-1\" data-name=\"order payment method text\">\n                            Payment: Cash on delivery\n                        </span>\n                        <a data-kid=\"1-2-3-1-2-3-2\" data-name=\"review order link\" href=\"orders.html\">\n                            Review order\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"arrow icon\" style=\"color:inherit;width:16px;height:16px;font-size:15px\">\n                            </i>\n                        </a>\n                    </div>\n                </article>\n            </section>\n            <section aria-labelledby=\"stock-review-title\" class=\"priority-section\" data-kid=\"1-2-3-2\" data-name=\"low stock section\">\n                <div class=\"section-heading\" data-kid=\"1-2-3-2-1\" data-name=\"stock section heading container\">\n                    <h2 data-dynamic=\"true\" data-kid=\"1-2-3-2-1-1\" data-name=\"stock section title\" data-reason=\"text content masked and animated by GSAP script\" id=\"stock-review-title\">\n                        Low stock\n                    </h2>\n                    <span data-kid=\"1-2-3-2-1-2\" data-name=\"stock status summary text\">\n                        3 products · 6 units each\n                    </span>\n                </div>\n                <div class=\"low-stock-list\" data-kid=\"1-2-3-2-2\" data-name=\"low stock list\">\n                    <div class=\"stock-record\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-1\" data-name=\"stock product record\" data-reason=\"visibility controlled by GSAP ScrollTrigger\">\n                        <img alt=\"Sculpt Knit Co-ord product image\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"product thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&w=120&q=80&fit=crop\"/>\n                        <div data-kid=\"1-2-3-2-2-1-2\" data-name=\"product info container\">\n                            <a class=\"stock-product-name\" data-kid=\"1-2-3-2-2-1-2-1\" data-name=\"product name link\" href=\"products.html\">\n                                Sculpt Knit Co-ord\n                            </a>\n                            <span class=\"stock-product-category\" data-kid=\"1-2-3-2-2-1-2-2\" data-name=\"product category label\">\n                                Co-ord Sets\n                            </span>\n                        </div>\n                        <div class=\"stock-qty\" data-kid=\"1-2-3-2-2-1-3\" data-name=\"product quantity info\">\n                            6 units\n                            <small data-kid=\"1-2-3-2-2-1-3-1\" data-name=\"stock level warning text\">\n                                Low stock\n                            </small>\n                        </div>\n                    </div>\n                    <div class=\"stock-record\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-2\" data-name=\"stock product record\" data-reason=\"visibility controlled by GSAP ScrollTrigger\">\n                        <img alt=\"Oatmeal Column Dress product image\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"product thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1539008835657-9e8e9680c956?auto=format&w=120&q=80&fit=crop\"/>\n                        <div data-kid=\"1-2-3-2-2-2-2\" data-name=\"product info container\">\n                            <a class=\"stock-product-name\" data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"product name link\" href=\"products.html\">\n                                Oatmeal Column Dress\n                            </a>\n                            <span class=\"stock-product-category\" data-kid=\"1-2-3-2-2-2-2-2\" data-name=\"product category label\">\n                                Dresses\n                            </span>\n                        </div>\n                        <div class=\"stock-qty\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"product quantity info\">\n                            6 units\n                            <small data-kid=\"1-2-3-2-2-2-3-1\" data-name=\"stock level warning text\">\n                                Low stock\n                            </small>\n                        </div>\n                    </div>\n                    <div class=\"stock-record\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-3\" data-name=\"stock product record\" data-reason=\"visibility controlled by GSAP ScrollTrigger\">\n                        <img alt=\"Fine Rib Tank product image\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"product thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&w=120&q=80&fit=crop\"/>\n                        <div data-kid=\"1-2-3-2-2-3-2\" data-name=\"product info container\">\n                            <a class=\"stock-product-name\" data-kid=\"1-2-3-2-2-3-2-1\" data-name=\"product name link\" href=\"products.html\">\n                                Fine Rib Tank\n                            </a>\n                            <span class=\"stock-product-category\" data-kid=\"1-2-3-2-2-3-2-2\" data-name=\"product category label\">\n                                Tops\n                            </span>\n                        </div>\n                        <div class=\"stock-qty\" data-kid=\"1-2-3-2-2-3-3\" data-name=\"product quantity info\">\n                            6 units\n                            <small data-kid=\"1-2-3-2-2-3-3-1\" data-name=\"stock level warning text\">\n                                Low stock\n                            </small>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"stock-footer\" data-kid=\"1-2-3-2-3\" data-name=\"stock footer container\">\n                    <a data-kid=\"1-2-3-2-3-1\" data-name=\"review stock link\" href=\"products.html\">\n                        Review product stock\n                        <i class=\"ti ti-arrow-right\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"arrow icon\" style=\"color:inherit;width:16px;height:16px;font-size:15px\">\n                        </i>\n                    </a>\n                </div>\n            </section>\n        </div>\n        <section aria-labelledby=\"recent-orders-title\" class=\"recent-section\" data-kid=\"1-2-4\" data-name=\"recent orders section\">\n            <div class=\"section-heading\" data-kid=\"1-2-4-1\" data-name=\"recent orders heading container\">\n                <h2 data-dynamic=\"true\" data-kid=\"1-2-4-1-1\" data-name=\"recent orders section title\" data-reason=\"text content masked and animated by GSAP script\" id=\"recent-orders-title\">\n                    Recent orders\n                </h2>\n                <a class=\"section-link\" data-kid=\"1-2-4-1-2\" data-name=\"view all orders link\" href=\"orders.html\">\n                    View all orders\n                    <i class=\"ti ti-arrow-right\" data-kid=\"1-2-4-1-2-1\" data-name=\"arrow icon\" style=\"color:inherit;width:16px;height:16px;font-size:15px\">\n                    </i>\n                </a>\n            </div>\n            <div class=\"recent-list\" data-kid=\"1-2-4-2\" data-name=\"recent orders list\">\n                <div class=\"recent-row\" data-dynamic=\"true\" data-kid=\"1-2-4-2-1\" data-name=\"recent order row\" data-reason=\"visibility controlled by GSAP ScrollTrigger\">\n                    <span class=\"recent-id\" data-kid=\"1-2-4-2-1-1\" data-name=\"recent order ID\">\n                        #SOL-1048\n                    </span>\n                    <span class=\"recent-customer\" data-kid=\"1-2-4-2-1-2\" data-name=\"recent order customer name\">\n                        Noor Rehman\n                    </span>\n                    <span class=\"recent-total\" data-kid=\"1-2-4-2-1-3\" data-name=\"recent order total\">\n                        Rs. 18,400\n                    </span>\n                    <span class=\"paid-state\" data-kid=\"1-2-4-2-1-4\" data-name=\"order payment status\">\n                        <span class=\"status-dot\" data-kid=\"1-2-4-2-1-4-1\" data-name=\"status dot\">\n                        </span>\n                        Paid\n                    </span>\n                </div>\n                <div class=\"recent-row\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2\" data-name=\"recent order row\" data-reason=\"visibility controlled by GSAP ScrollTrigger\">\n                    <span class=\"recent-id\" data-kid=\"1-2-4-2-2-1\" data-name=\"recent order ID\">\n                        #SOL-1047\n                    </span>\n                    <span class=\"recent-customer\" data-kid=\"1-2-4-2-2-2\" data-name=\"recent order customer name\">\n                        Areeba Malik\n                    </span>\n                    <span class=\"recent-total\" data-kid=\"1-2-4-2-2-3\" data-name=\"recent order total\">\n                        Rs. 9,800\n                    </span>\n                    <span class=\"paid-state\" data-kid=\"1-2-4-2-2-4\" data-name=\"order payment status\">\n                        <span class=\"status-dot\" data-kid=\"1-2-4-2-2-4-1\" data-name=\"status dot\">\n                        </span>\n                        Paid\n                    </span>\n                </div>\n                <div class=\"recent-row\" data-dynamic=\"true\" data-kid=\"1-2-4-2-3\" data-name=\"recent order row\" data-reason=\"visibility controlled by GSAP ScrollTrigger\">\n                    <span class=\"recent-id\" data-kid=\"1-2-4-2-3-1\" data-name=\"recent order ID\">\n                        #SOL-1045\n                    </span>\n                    <span class=\"recent-customer\" data-kid=\"1-2-4-2-3-2\" data-name=\"recent order customer name\">\n                        Fatima Khan\n                    </span>\n                    <span class=\"recent-total\" data-kid=\"1-2-4-2-3-3\" data-name=\"recent order total\">\n                        Rs. 14,500\n                    </span>\n                    <span class=\"paid-state\" data-kid=\"1-2-4-2-3-4\" data-name=\"order payment status\">\n                        <span class=\"status-dot\" data-kid=\"1-2-4-2-3-4-1\" data-name=\"status dot\">\n                        </span>\n                        Paid\n                    </span>\n                </div>\n            </div>\n            <div class=\"recent-bottom\" data-kid=\"1-2-4-3\" data-name=\"recent orders section footer\">\n                <a class=\"section-link\" data-kid=\"1-2-4-3-1\" data-name=\"open orders link\" href=\"orders.html\">\n                    Open orders\n                    <i class=\"ti ti-arrow-right\" data-kid=\"1-2-4-3-1-1\" data-name=\"arrow icon\" style=\"color:inherit;width:16px;height:16px;font-size:15px\">\n                    </i>\n                </a>\n            </div>\n        </section>\n        <p class=\"admin-footer-note\" data-kid=\"1-2-5\" data-name=\"admin footer information note\">\n            Stock counts shown are product-level quantities. Review product details for available variants.\n        </p>\n    </main>\n</div>\n",
