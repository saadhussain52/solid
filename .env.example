# Solids storefront — server settings.
#
# Copy this file to ".env" and fill in the values. Real environment variables
# always win over anything set here.
#
# Without a Resend API key the site still works and orders are saved,
# but automatic email delivery is disabled.

# Port the server listens on.
PORT=5173

# Resend API key. Store the production key in Railway Variables.
RESEND_API_KEY=
# Set this to a verified sender domain when one is configured. The default
# Resend testing sender can only deliver to an authorized recipient.
RESEND_FROM=SOLID Store <onboarding@resend.dev>

# Official reply-to/customer contact.
OFFICIAL_EMAIL=solids.pk.official@gmail.com
OFFICIAL_PHONE=+92 341 2782443

MAIL_REPLY_TO=solids.pk.official@gmail.com

# Optional customer WhatsApp notifications. Configure an approved Meta
# template with body parameters: Order ID, Tracking ID, customer, status,
# then item summary. Missing credentials are logged and do not block email.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=solids_order_tracking
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Directory for orders.json and products.json. On Railway, attach a persistent
# volume at /data and set DATA_DIR=/data. Without a mounted volume, data can be
# lost when Railway replaces the service instance.
DATA_DIR=

# The public address of the site, used to build the tracking link that goes in
# the email. Leave this BLANK unless you have a custom domain — the server then
# uses the address the order actually arrived on, which is always correct.
# Only set it to override that, e.g. SITE_URL=https://shop.yourdomain.com
SITE_URL=

# Shared secret required to initialize/edit products and change order status.
# Set a long, random value in Railway Variables; enter the same key in the
# admin page when prompted. Leave blank to refuse all product writes.
ADMIN_KEY=

# Admin panel login. These are the ONLY place the admin username and password
# live; nothing is hardcoded and they are never sent to the browser. Set BOTH
# or the /api/admin/login route replies 503 and the admin panel stays locked.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cloudinary signed image-upload settings. The API secret stays on the server;
# the admin page receives a short-lived signature for each image upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
